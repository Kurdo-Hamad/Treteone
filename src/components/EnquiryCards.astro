---
import Icon from '~/components/Icon.astro';
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import { company } from '~/data/company';
import { standIn } from '~/data/standIns';
import type { TextKey } from '~/data/heroSlides';
import { aboutHref, productsHref, quoteHref, sourcingHref } from '~/data/navigation';
import { getLangFromUrl, languages, localisePath, useTranslations } from '~/i18n/ui';

/**
 * Image cards — the mockup's .cards block: photograph slot, heading, three
 * lines, "read more". The whole card is the link.
 *
 * Two homepage sections share this one card language (§13 — one product):
 *   set="enquiries"  §7.4 "Three ways an enquiry arrives", three columns on
 *                    white. Illustrative only — the line saying so stays, and
 *                    no client is named (§13).
 *   set="work"       §7.9 "About our work", two columns on the pale band.
 *
 * The three enquiry cards start below the fold, so they reveal (.rv); the two
 * work cards sit at the foot of the page and do not, as in the mockup.
 *
 * "Who you are dealing with" has no photograph until Treteone supplies one of
 * its own office (a stock photo there would fail the "are these people
 * real?" check, §1). Until then its frame shows the registered company
 * record — name and address in both scripts — instead of an empty
 * "IMAGE" placeholder.
 */

interface Props {
  set: 'enquiries' | 'work';
}

interface Card {
  readonly href: string;
  readonly subject: TextKey;
  readonly heading: TextKey;
  readonly body: TextKey;
  readonly more: TextKey;
  /** Show the registered company record when there is no photograph. */
  readonly record?: boolean;
}

const { set } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sets: Record<Props['set'], { heading: TextKey; note?: TextKey; cards: readonly Card[] }> = {
  enquiries: {
    heading: 'home.enquiries.heading',
    note: 'home.enquiries.note',
    cards: [
      {
        href: sourcingHref,
        subject: 'home.enquiries.module.subject',
        heading: 'home.enquiries.module.heading',
        body: 'home.enquiries.module.body',
        more: 'home.enquiries.module.more',
      },
      {
        href: productsHref,
        subject: 'home.enquiries.pump.subject',
        heading: 'home.enquiries.pump.heading',
        body: 'home.enquiries.pump.body',
        more: 'home.enquiries.pump.more',
      },
      {
        href: quoteHref,
        subject: 'home.enquiries.boq.subject',
        heading: 'home.enquiries.boq.heading',
        body: 'home.enquiries.boq.body',
        more: 'home.enquiries.boq.more',
      },
    ],
  },
  work: {
    heading: 'home.work.heading',
    cards: [
      {
        href: sourcingHref,
        subject: 'home.work.quote.subject',
        heading: 'home.work.quote.heading',
        body: 'home.work.quote.body',
        more: 'home.work.more',
      },
      {
        href: aboutHref,
        subject: 'home.work.who.subject',
        heading: 'home.work.who.heading',
        body: 'home.work.who.body',
        more: 'home.work.more',
        record: true,
      },
    ],
  },
};

const { heading, note, cards } = sets[set];
const reveal = set === 'enquiries';
const titleId = `${set}-title`;
// Text in the other script gets its own lang, so it is read and shaped right.
const latinLang = lang === 'en' ? undefined : 'en';
const hanziLang = lang === 'zh' ? undefined : languages.zh.htmlLang;
---

<section class:list={[{ pale: set === 'work' }]} aria-labelledby={titleId}>
  <div class="wrap sec">
    <h2 id={titleId}>{t(heading)}</h2>
    {note && <p class="small cards__note">{t(note)}</p>}
    <div class:list={['cards', { 'cards--two': set === 'work' }]}>
      {
        cards.map((card) => (
          <a class:list={['card', { rv: reveal }]} href={localisePath(card.href, lang)}>
            {card.record && !standIn(card.subject) ? (
              <span class="card__record">
                <span class="card__record-name" lang={latinLang}>{company.registeredName}</span>
                <span class="card__record-line" lang={latinLang}>{company.address.latin}</span>
                <span class="card__record-line" lang={hanziLang}>{company.address.hanzi}</span>
              </span>
            ) : (
              <ImagePlaceholder subject={t(card.subject)} variant="wide" image={standIn(card.subject)} />
            )}
            <h3>{t(card.heading)}</h3>
            <p>{t(card.body)}</p>
            <span class="rm">
              {t(card.more)} <Icon name="arrow-right" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards__note {
    margin-top: 10px;
    max-width: 62ch;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2.6vw, 30px);
    margin-top: 28px;
  }
  .cards--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 26px;
  }

  .card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .card h3 {
    margin-top: 20px;
    transition: color .2s;
  }
  .card:is(:hover, :focus-visible) h3 {
    color: var(--fg-link);
  }
  .card p {
    margin-top: 10px;
    max-width: 52ch;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--fg-body);
  }
  .card .rm {
    margin-top: 14px;
  }
  .card:is(:hover, :focus-visible) .rm {
    color: var(--color-navy);
    text-decoration-color: currentColor;
  }
  .card:is(:hover, :focus-visible) .rm :global(.ico) {
    transform: translateX(3px);
  }

  /* The company record, in the photograph's frame: a navy panel set like a
     document — registered name, then the address in both scripts. */
  .card__record {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    aspect-ratio: 16 / 10;
    padding: clamp(22px, 3vw, 36px);
    background: var(--color-navy);
    color: var(--on-dark-2);
    font-size: var(--fs-small);
    line-height: 1.55;
    transition:
      transform .5s var(--ease-out-expo),
      box-shadow .5s var(--ease-out-expo);
  }
  .card__record-name {
    margin-bottom: 6px;
    font-family: var(--font-stack-display);
    font-weight: var(--weight-heading);
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: var(--tracking-head);
    color: var(--text-inverse);
  }
  .card:is(:hover, :focus-visible) .card__record {
    transform: translateY(-6px);
    box-shadow: var(--shadow-floating);
  }

  @media (max-width: 60rem) {
    .cards,
    .cards--two {
      grid-template-columns: 1fr;
    }
  }
</style>
