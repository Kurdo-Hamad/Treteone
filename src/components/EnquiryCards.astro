---
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import { standIn } from '~/data/standIns';
import type { TextKey } from '~/data/heroSlides';
import { aboutHref, productsHref, quoteHref, sourcingHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * Image cards — the mockup's .cards block: photograph slot, heading, three
 * lines, "read more". The whole card is the link.
 *
 * Two homepage sections share this one card language (§13 — one product):
 *   set="enquiries"  §7.4 "Three ways an enquiry arrives", three columns on
 *                    white. Illustrative only — the line saying so stays, and
 *                    no client is named (§13).
 *   set="work"       §7.9 "About our work", two columns on the pale band.
 *
 * The three enquiry cards start below the fold, so they reveal (.rv); the two
 * work cards sit at the foot of the page and do not, as in the mockup.
 */

interface Props {
  set: 'enquiries' | 'work';
}

interface Card {
  readonly href: string;
  readonly subject: TextKey;
  readonly heading: TextKey;
  readonly body: TextKey;
  readonly more: TextKey;
}

const { set } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sets: Record<Props['set'], { heading: TextKey; note?: TextKey; cards: readonly Card[] }> = {
  enquiries: {
    heading: 'home.enquiries.heading',
    note: 'home.enquiries.note',
    cards: [
      {
        href: sourcingHref,
        subject: 'home.enquiries.module.subject',
        heading: 'home.enquiries.module.heading',
        body: 'home.enquiries.module.body',
        more: 'home.enquiries.module.more',
      },
      {
        href: productsHref,
        subject: 'home.enquiries.pump.subject',
        heading: 'home.enquiries.pump.heading',
        body: 'home.enquiries.pump.body',
        more: 'home.enquiries.pump.more',
      },
      {
        href: quoteHref,
        subject: 'home.enquiries.boq.subject',
        heading: 'home.enquiries.boq.heading',
        body: 'home.enquiries.boq.body',
        more: 'home.enquiries.boq.more',
      },
    ],
  },
  work: {
    heading: 'home.work.heading',
    cards: [
      {
        href: sourcingHref,
        subject: 'home.work.quote.subject',
        heading: 'home.work.quote.heading',
        body: 'home.work.quote.body',
        more: 'home.work.more',
      },
      {
        href: aboutHref,
        subject: 'home.work.who.subject',
        heading: 'home.work.who.heading',
        body: 'home.work.who.body',
        more: 'home.work.more',
      },
    ],
  },
};

const { heading, note, cards } = sets[set];
const reveal = set === 'enquiries';
const titleId = `${set}-title`;
---

<section class:list={[{ pale: set === 'work' }]} aria-labelledby={titleId}>
  <div class="wrap sec">
    <h2 id={titleId}>{t(heading)}</h2>
    {note && <p class="small cards__note">{t(note)}</p>}
    <div class:list={['cards', { 'cards--two': set === 'work' }]}>
      {
        cards.map((card) => (
          <a class:list={['card', { rv: reveal }]} href={localisePath(card.href, lang)}>
            <ImagePlaceholder subject={t(card.subject)} variant="wide" image={standIn(card.subject)} />
            <h3>{t(card.heading)}</h3>
            <p>{t(card.body)}</p>
            <span class="rm">
              {t(card.more)} <span class="card__arrow" aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards__note {
    margin-top: 10px;
    max-width: 62ch;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2.6vw, 30px);
    margin-top: 28px;
  }
  .cards--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 26px;
  }

  .card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .card h3 {
    margin-top: 16px;
  }
  .card p {
    margin-top: 8px;
    font-size: .875rem;
    line-height: 1.6;
    color: var(--fg-body);
  }
  .card .rm {
    margin-top: 12px;
    transition: transform var(--dur-fast) var(--ease), color var(--dur-fast);
  }
  .card:hover .rm {
    transform: translateX(4px);
  }

  /* Staggered reveal, as the mockup's 70ms per child. */
  .card.rv:nth-child(2) { transition-delay: 70ms; }
  .card.rv:nth-child(3) { transition-delay: 140ms; }

  @media (max-width: 960px) {
    .cards,
    .cards--two {
      grid-template-columns: 1fr;
    }
  }
</style>
