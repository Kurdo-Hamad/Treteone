---
import { Picture } from 'astro:assets';
import { industries } from '~/data/industries';
import { quoteHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, pick, useTranslations } from '~/i18n/ui';

/**
 * /industries — all 9 industries in full (§3).
 *
 * Replaces the homepage industry picker. A tablist shows one panel and hides
 * eight; on the page whose job is to show every industry, nothing is hidden,
 * and nothing depends on hover (§13). No script.
 *
 * Composition: ruled editorial rows — number, name and what we typically
 * source on the left, a wide photograph on the right — unlike the two-column
 * grid on /products, so the two index pages do not read as one template.
 *
 * Each row's id is its slug, so the homepage cards link straight to it.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pad = (n: number): string => String(n).padStart(2, '0');
const total = industries.length;
const quote = localisePath(quoteHref, lang);
---

<section class="ind-index" aria-labelledby="ind-index-title">
  <div class="wrap">
    <h2 class="sr-only" id="ind-index-title">{t('industries.listLabel')}</h2>

    <ol class="ind-index__list">
      {
        industries.map((industry, i) => (
          <li class="ind-row" id={industry.slug}>
            <div class="ind-row__body">
              <p class="mono ind-row__no" aria-hidden="true">{pad(i + 1)} / {pad(total)}</p>
              <h3 class="ind-row__name">{pick(industry.name, lang)}</h3>
              <p class="mono ind-row__tags">{pick(industry.blurb, lang)}</p>
              <a
                class="link-arrow"
                href={quote}
                aria-label={t('industries.cardLabel')(pick(industry.name, lang))}
              >
                {t('industries.enquire')}
                <svg class="link-arrow__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M1 7.25h11.19L7.47 2.53l1.06-1.06L15.06 8l-6.53 6.53-1.06-1.06 4.72-4.72H1z" fill="currentColor" />
                </svg>
              </a>
            </div>
            <div class="ind-row__frame">
              <Picture
                src={industry.image}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[400, 720, 1080]}
                sizes="(min-width: 1280px) 700px, (min-width: 1040px) 55vw, 100vw"
                alt=""
                class="ind-row__img"
                loading="lazy"
                decoding="async"
              />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ind-index {
    padding-block: var(--section-y);
  }

  .ind-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule-light);
  }

  .ind-row {
    display: grid;
    gap: 24px;
    padding-block: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--rule-light);
  }

  .ind-row__body {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .ind-row__no {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .ind-row__name {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: var(--leading-h23);
  }
  .ind-row__tags {
    max-width: 40ch;
    font-size: var(--fs-small);
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  :global(html[lang^='zh']) .ind-row__tags {
    text-transform: none;
  }
  .ind-row__body .link-arrow {
    justify-self: start;
    margin-top: 8px;
  }

  .ind-row__frame {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-card-tinted);
  }
  .ind-row__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1040px) {
    .ind-row {
      grid-template-columns: 5fr 7fr;
      gap: clamp(40px, 5vw, 80px);
      align-items: start;
    }
    .ind-row__frame {
      aspect-ratio: 16 / 8;
    }
  }
</style>
