---
import { brandTiles } from '~/data/brand-logos';
import { quoteHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * /brands — every brand as a static tile (§9). Nothing moves on this page: it
 * is where a buyer comes to check whether a manufacturer is on the list, so
 * the list is a real, visible <ul> in reading order.
 *
 * A tile with a logo uses the brand name as alt text; a tile without one shows
 * the name in a dashed placeholder. Logos render greyscale, full colour on hover.
 *
 * ⚠ §13 — "Brands we source", and the trademark disclaimer stays.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="brand-grid" aria-labelledby="brand-grid-title">
  <div class="wrap">
    <h2 class="sr-only" id="brand-grid-title">{t('brands.listLabel')}</h2>

    <ul class="brand-grid__list">
      {
        brandTiles.map((tile) => (
          <li class:list={['brand-tile', { 'brand-tile--has-image': tile.logo !== null }]}>
            {tile.logo ? (
              <img class="brand-tile__img" src={tile.logo} alt={tile.name} loading="lazy" decoding="async" />
            ) : (
              <span class="brand-tile__name">{tile.name}</span>
            )}
          </li>
        ))
      }
    </ul>

    <div class="brand-grid__foot">
      <p class="brand-grid__disclaimer">{t('brands.disclaimer')}</p>
      <a class="link-arrow" href={localisePath(quoteHref, lang)}>
        {t('brands.ask')}
        <svg class="link-arrow__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M1 7.25h11.19L7.47 2.53l1.06-1.06L15.06 8l-6.53 6.53-1.06-1.06 4.72-4.72H1z" fill="currentColor" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .brand-grid {
    padding-block: var(--section-y);
  }

  .brand-grid__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-light);
    border-left: 1px solid var(--rule-light);
  }

  .brand-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 112px;
    padding: 16px;
    border-right: 1px solid var(--rule-light);
    border-bottom: 1px solid var(--rule-light);
    background: var(--surface-page);
  }

  .brand-tile__img {
    max-width: 100%;
    max-height: 56px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: .75;
    transition: filter var(--dur-fast), opacity var(--dur-fast);
  }
  .brand-tile--has-image:hover .brand-tile__img {
    filter: none;
    opacity: 1;
  }

  .brand-tile__name {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 72px;
    padding: 8px;
    border: 1px dashed var(--color-muted-blue);
    font-family: var(--font-stack-display);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    color: var(--text-primary);
  }

  .brand-grid__foot {
    display: grid;
    gap: 20px;
    margin-top: 32px;
  }
  .brand-grid__disclaimer {
    max-width: 80ch;
    font-size: var(--fs-small);
    color: var(--text-secondary);
  }

  @media (min-width: 720px) {
    .brand-grid__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 1040px) {
    .brand-grid__list {
      grid-template-columns: repeat(6, 1fr);
    }
    .brand-grid__foot {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
  }
</style>
