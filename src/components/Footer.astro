---
import Icon from '~/components/Icon.astro';
import { company, mailHref, telHref } from '~/data/company';
import { homeHref, quoteHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * Navy footer. No navigation row — the masthead carries the site navigation;
 * the footer carries who we are and how to reach us (client request, Nov 2026).
 *
 *   wordmark, registered name, tagline                 |  kicker + quote pill
 *   ---------------------------------------------------------------------------
 *   EMAIL            PHONE · WHATSAPP            OFFICE (both scripts)
 *   ---------------------------------------------------------------------------
 *   © year, registered name                                       Back to top ↑
 *
 * This block is half of how the site survives the "are these people real?"
 * check (§1), so nothing in it may be invented. The business licence number
 * is deliberately not shown until it is supplied (§12) — no placeholder.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const buildYear = new Date().getFullYear();
// The quote page is the form itself: no "Request a quote" button under it.
const onQuotePage = /\/quote\/?$/.test(Astro.url.pathname);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="ftop">
      <div class="fbrand">
        <a class="mark" href={localisePath(homeHref, lang)} aria-label={t('nav.home')}>
          <span aria-hidden="true">{company.tradingName}<i>.</i></span>
        </a>
        <p class="fco">{company.registeredName}</p>
        <p class="ftag">{t('footer.tagline')}</p>
      </div>

      {
        !onQuotePage && (
          <div class="fcta">
            <p class="fcta__k">{t('footer.ctaKicker')}</p>
            <a class="btn" href={localisePath(quoteHref, lang)}>
              {t('cta.quote')} <Icon name="arrow-right" />
            </a>
          </div>
        )
      }
    </div>

    <dl class="fdetails">
      <div class="fd">
        <dt class="label">{t('footer.email')}</dt>
        <dd><a class="fd__big" href={mailHref}>{company.email}</a></dd>
      </div>
      <div class="fd">
        <dt class="label">{t('footer.phone')}</dt>
        <dd>
          <a class="fd__big" href={telHref}>{company.phoneDisplay}</a>
          <a class="fd__wa" href={company.whatsappUrl} rel="noopener noreferrer" target="_blank">
            {t('cta.whatsapp')} <Icon name="arrow-right" />
          </a>
        </dd>
      </div>
      <div class="fd fd--office">
        <dt class="label">{t('footer.office')}</dt>
        <dd>
          <address>
            {company.address.latin}<br />
            <span lang="zh-CN">{company.address.hanzi}</span>
          </address>
        </dd>
      </div>
    </dl>

    <div class="legal">
      <p data-year={buildYear}>{t('footer.rights')(buildYear, company.registeredName)}</p>
      {/* "#top" with no element of that id scrolls to the top of the document (HTML spec), so no anchor element is needed. */}
      <a class="totop" href="#top">
        {t('footer.top')} <Icon name="arrow-up" />
      </a>
    </div>
  </div>
</footer>

<script>
  import '~/scripts/footer';
</script>

<style>
  /* Navy ground: set the roles here so the focus ring is cyan-light and the
     global .btn takes its navy-ground (cyan) form. */
  .site-footer {
    --focus: var(--focus-dark);
    --fg-link: var(--text-link-dark);
    --fg-label: var(--color-cyan-light);

    position: relative;
    background: var(--color-navy-deep);
    color: var(--on-dark-3);
    padding-block: clamp(48px, 6vw, 80px) 24px;
    font-size: var(--fs-small);
  }
  .site-footer .btn {
    background: var(--color-cyan);
    color: var(--color-navy);
  }
  .site-footer .btn:hover {
    background: var(--text-inverse);
  }

  /* -- top: brand and call to action ---------------------------------------- */
  .ftop {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px 48px;
    padding-bottom: clamp(32px, 4vw, 48px);
    border-bottom: 1px solid var(--rule-dark);
  }

  .mark {
    display: inline-block;
    font-family: var(--font-stack-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    letter-spacing: .1em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--text-inverse);
  }
  .mark i {
    font-style: normal;
    color: var(--color-cyan);
  }

  .fco {
    margin-top: 18px;
    color: var(--text-inverse);
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: var(--fs-body);
    letter-spacing: -.01em;
  }
  .ftag {
    margin-top: 6px;
    max-width: 46ch;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--on-dark-3);
  }

  .fcta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .fcta__k {
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: var(--fs-lead);
    color: var(--text-inverse);
  }

  /* -- contact details ------------------------------------------------------ */
  .fdetails {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 28px 40px;
    margin: 0;
    padding-block: clamp(28px, 3.6vw, 44px);
  }
  .fd dt {
    margin-bottom: 10px;
  }
  .fd dd {
    margin: 0;
  }
  .fd__big {
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: var(--fs-lead);
    color: var(--text-inverse);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: transparent;
    transition: text-decoration-color .2s, color .16s;
  }
  .fd__big:hover {
    color: var(--color-cyan-light);
    text-decoration-color: currentColor;
  }
  .fd__wa {
    display: inline-flex;
    align-items: center;
    gap: .4em;
    margin-left: 14px;
    font-family: var(--font-stack-display);
    font-weight: 600;
    font-size: var(--fs-small);
    color: var(--color-cyan-light);
    text-decoration: none;
  }
  .fd__wa:hover {
    color: var(--text-inverse);
  }
  .fd address {
    font-style: normal;
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--on-dark-2);
  }

  /* -- legal row ------------------------------------------------------------ */
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 30px;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid var(--rule-dark);
    font-size: var(--fs-caption);
    /* §11 floor: .50 white on the footer ground is ~5:1. */
    color: var(--on-dark-4);
  }
  .totop {
    display: inline-flex;
    align-items: center;
    gap: .5em;
    min-height: 44px;
    color: var(--on-dark-2);
    text-decoration: none;
    font-family: var(--font-stack-display);
    font-weight: 500;
    transition: color .16s;
  }
  .totop:hover {
    color: var(--text-inverse);
  }

  @media (max-width: 60rem) {
    .fdetails {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .fd--office {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 35rem) {
    .ftop {
      align-items: flex-start;
    }
    .fdetails {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
