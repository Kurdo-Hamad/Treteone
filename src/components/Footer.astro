---
import { company, mailHref, telHref } from '~/data/company';
import { homeHref, quoteHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * Navy footer. No navigation row — the masthead carries the site navigation;
 * the footer carries who we are and how to reach us (client request, Nov 2026).
 *
 *   wordmark, registered name, tagline                 |  kicker + quote pill
 *   ---------------------------------------------------------------------------
 *   EMAIL            PHONE · WHATSAPP            OFFICE (both scripts)
 *   ---------------------------------------------------------------------------
 *   © year, registered name                                       Back to top ↑
 *
 * This block is half of how the site survives the "are these people real?"
 * check (§1), so nothing in it may be invented. The business licence number
 * is deliberately not shown until it is supplied (§12) — no placeholder.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const buildYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="ftop">
      <div class="fbrand">
        <a class="mark" href={localisePath(homeHref, lang)} aria-label={t('nav.home')}>
          <span aria-hidden="true">{company.tradingName}<i>.</i></span>
        </a>
        <p class="fco">{company.registeredName}</p>
        <p class="ftag">{t('footer.tagline')}</p>
      </div>

      <div class="fcta">
        <p class="fcta__k">{t('footer.ctaKicker')}</p>
        <a class="btn" href={localisePath(quoteHref, lang)}>
          {t('cta.quote')} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <dl class="fdetails">
      <div class="fd">
        <dt>{t('footer.email')}</dt>
        <dd><a class="fd__big" href={mailHref}>{company.email}</a></dd>
      </div>
      <div class="fd">
        <dt>{t('footer.phone')}</dt>
        <dd><a class="fd__big" href={telHref}>{company.phoneDisplay}</a></dd>
      </div>
      <div class="fd fd--office">
        <dt>{t('footer.office')}</dt>
        <dd>
          <address>
            {company.address.latin}<br />
            <span lang="zh-CN">{company.address.hanzi}</span>
          </address>
        </dd>
      </div>
    </dl>

    <div class="legal">
      <p data-year={buildYear}>{t('footer.rights')(buildYear, company.registeredName)}</p>
      {/* "#top" with no element of that id scrolls to the top of the document (HTML spec), so no anchor element is needed. */}
      <a class="totop" href="#top">
        {t('footer.top')} <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<script>
  import '~/scripts/footer';
</script>

<style>
  /* Navy ground: set the roles here so the focus ring is cyan-light and the
     global .btn takes its navy-ground (cyan) form. */
  .site-footer {
    --focus: var(--focus-dark);
    --fg-link: var(--text-link-dark);

    position: relative;
    background: var(--color-navy-deep);
    color: rgba(255, 255, 255, .62);
    padding-block: clamp(48px, 6vw, 80px) 24px;
    font-size: .875rem;
  }
  /* A short cyan rule on the top edge, aligned to the page gutter — the one
     accent on the footer. */
  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: max(var(--wrap-pad), calc((100% - var(--wrap-max)) / 2 + var(--wrap-pad)));
    width: 72px;
    height: 3px;
    background: var(--color-cyan);
  }
  .site-footer .btn {
    background: var(--color-cyan);
    color: var(--color-navy);
  }
  .site-footer .btn:hover {
    background: var(--text-inverse);
  }

  /* -- top: brand and call to action ---------------------------------------- */
  .ftop {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px 48px;
    padding-bottom: clamp(32px, 4vw, 48px);
    border-bottom: 1px solid rgba(255, 255, 255, .12);
  }

  .mark {
    display: inline-block;
    font-family: var(--font-stack-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    letter-spacing: .1em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--text-inverse);
  }
  .mark i {
    font-style: normal;
    color: var(--color-cyan);
  }

  .fco {
    margin-top: 18px;
    color: var(--text-inverse);
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -.01em;
  }
  .ftag {
    margin-top: 6px;
    max-width: 46ch;
    font-size: .9375rem;
    line-height: 1.6;
    /* §11 floor: .62 white on the footer ground is ~7:1. */
    color: rgba(255, 255, 255, .62);
  }

  .fcta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .fcta__k {
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: 1.0625rem;
    color: var(--text-inverse);
  }

  /* -- contact details ------------------------------------------------------ */
  .fdetails {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 28px 40px;
    margin: 0;
    padding-block: clamp(28px, 3.6vw, 44px);
  }
  .fd dt {
    margin-bottom: 10px;
    font-family: var(--font-stack-display);
    font-size: var(--fs-kicker);
    font-weight: 600;
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--color-cyan-light);
  }
  html[lang^='zh'] .fd dt {
    letter-spacing: .06em;
  }
  .fd dd {
    margin: 0;
  }
  .fd__big {
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: clamp(1rem, .95rem + .3vw, 1.125rem);
    color: var(--text-inverse);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: transparent;
    transition: text-decoration-color .2s, color .16s;
  }
  .fd__big:hover {
    color: var(--color-cyan-light);
    text-decoration-color: currentColor;
  }
  .fd address {
    font-style: normal;
    font-size: .875rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, .7);
  }

  /* -- legal row ------------------------------------------------------------ */
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 30px;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, .12);
    font-size: .8rem;
    /* The mockup has .46 here; raised to .54 to clear the §11 floor (~6:1). */
    color: rgba(255, 255, 255, .54);
  }
  .totop {
    display: inline-flex;
    align-items: center;
    gap: .5em;
    min-height: 44px;
    color: rgba(255, 255, 255, .74);
    text-decoration: none;
    font-family: var(--font-stack-display);
    font-weight: 500;
    transition: color .16s;
  }
  .totop:hover {
    color: var(--text-inverse);
  }

  @media (max-width: 960px) {
    .fdetails {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .fd--office {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .ftop {
      align-items: flex-start;
    }
    .fdetails {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
