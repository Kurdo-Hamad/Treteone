---
import { company, mailHref, telHref } from '~/data/company';
import { footerNav, homeHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * Compact navy footer, from the approved mockup.
 *
 *   wordmark · registered name · address in both scripts   |   one row of links
 *   ----------------------------------------------------------------------------
 *   email · phone                                          |   © year, registered name
 *
 * This block is half of how the site survives the "are these people real?"
 * check (§1), so nothing in it may be invented. The business licence number
 * is deliberately not shown until it is supplied (§12) — no placeholder.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const buildYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="fgrid">
      <div class="fbrand">
        <a class="mark" href={localisePath(homeHref, lang)} aria-label={t('nav.home')}>
          <span aria-hidden="true">{company.tradingName}<i>.</i></span>
        </a>
        <p class="fco">{company.registeredName}</p>
        <address class="faddr">
          {company.address.latin}<br />
          <span lang="zh-CN">{company.address.hanzi}</span>
        </address>
      </div>

      <nav class="flinks" aria-label={t('footer.label')}>
        {footerNav.map((item) => <a href={localisePath(item.href, lang)}>{t(item.key)}</a>)}
      </nav>
    </div>

    <div class="legal">
      <p class="fcontact">
        <a href={mailHref}>{company.email}</a>
        <a href={telHref}>{company.phoneDisplay}</a>
      </p>
      <p data-year={buildYear}>{t('footer.rights')(buildYear, company.registeredName)}</p>
    </div>
  </div>
</footer>

<script>
  import '~/scripts/footer';
</script>

<style>
  /* Navy ground: set the roles here so the focus ring is cyan-light. */
  .site-footer {
    --focus: var(--focus-dark);

    background: var(--color-navy-deep);
    color: rgba(255, 255, 255, .62);
    padding-block: clamp(38px, 4.4vw, 54px) 20px;
    font-size: .875rem;
  }

  .fgrid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) auto;
    gap: 26px 48px;
    align-items: start;
  }

  .mark {
    display: inline-block;
    font-family: var(--font-stack-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--text-inverse);
  }
  .mark i {
    font-style: normal;
    color: var(--color-cyan);
  }

  .fco {
    margin-top: 15px;
    color: var(--text-inverse);
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: .9375rem;
    letter-spacing: -.01em;
  }

  /* §11 floor: nothing on navy below .50 white. .54 measures ~6:1 on the
     footer ground. */
  .faddr {
    margin-top: 7px;
    max-width: 44ch;
    font-style: normal;
    font-size: .8125rem;
    line-height: 1.62;
    color: rgba(255, 255, 255, .54);
  }
  .faddr span {
    color: rgba(255, 255, 255, .54);
  }

  .flinks {
    display: flex;
    flex-wrap: wrap;
    gap: 11px 28px;
    justify-content: flex-end;
    align-content: flex-start;
  }
  .flinks a {
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    color: rgba(255, 255, 255, .84);
    text-decoration: none;
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: .9375rem;
    transition: color .16s, border-color .16s;
  }
  .flinks a:hover {
    color: var(--text-inverse);
    border-bottom-color: var(--color-cyan);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 30px;
    justify-content: space-between;
    align-items: baseline;
    margin-top: clamp(28px, 3.4vw, 42px);
    padding-top: 17px;
    border-top: 1px solid rgba(255, 255, 255, .13);
    font-size: .78rem;
    /* The mockup has .46 here; raised to .54 to clear the §11 floor. */
    color: rgba(255, 255, 255, .54);
  }
  .fcontact {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 24px;
    font-family: var(--font-stack-mono);
    letter-spacing: .02em;
    font-size: .8rem;
  }
  .fcontact a {
    color: rgba(255, 255, 255, .74);
    text-decoration: none;
  }
  .fcontact a:hover {
    color: var(--text-inverse);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 960px) {
    .fgrid {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .flinks {
      justify-content: flex-start;
      gap: 11px 24px;
    }
  }
</style>
