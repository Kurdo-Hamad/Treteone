---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

/**
 * The opening of every detail route: h1 and lead. One component so the pages
 * read as one product. No label above the heading — the heading carries its
 * own weight (eyebrow labels removed in the Nov 2026 refinement).
 *
 *   band (default)  a full-bleed navy band flush under the masthead, with an
 *                   optional photograph on the right behind a navy scrim.
 *                   Whatever the page puts in the default slot (index rows,
 *                   definitions, the brand directory) follows in its own
 *                   .wrap.sec, on white.
 *   plain           just the three lines, no band and no wrapper — for /quote,
 *                   whose form component already sits on navy and places
 *                   this in its own `head` slot.
 *
 * All strings are already localised by the page. `image` is a preview
 * stand-in from src/data/standIns.ts; it is decorative (alt="") because it
 * does not show Treteone. Without it the band is plain navy.
 */

interface Props {
  title: string;
  lead?: string;
  image?: ImageMetadata | undefined;
  plain?: boolean;
}

const { title, lead, image, plain = false } = Astro.props;
const hasBody = Astro.slots.has('default');
---

{
  plain ? (
    <header class="page-head settle-in">
      <h1>{title}</h1>
      {lead && <p class="lead page-head__lead">{lead}</p>}
    </header>
  ) : (
    <>
      <header class:list={['phead', { 'phead--media': image }]}>
        {image && (
          <div class="phead__media" aria-hidden="true">
            <Picture
              src={image}
              alt=""
              formats={['avif', 'webp']}
              widths={[480, 800, 1200, 1600].filter((w) => w <= image.width)}
              sizes="(max-width: 960px) 100vw, 50vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="phead__img"
            />
          </div>
        )}
        <div class="wrap phead__in settle-in">
          <h1>{title}</h1>
          {lead && <p class="lead phead__lead">{lead}</p>}
        </div>
      </header>
      {hasBody && (
        <div class="wrap sec phead__body">
          <slot />
        </div>
      )}
    </>
  )
}

<style>
  /* -- plain ---------------------------------------------------------------- */
  .page-head__lead {
    margin-top: 16px;
  }

  /* -- band ----------------------------------------------------------------- */
  /* A navy ground sets its own roles, so focus, links and headings follow. */
  .phead {
    --focus: var(--focus-dark);
    --fg-heading: var(--text-inverse);
    --fg-label: var(--color-cyan-light);
    --fg-body: var(--on-dark-2);

    position: relative;
    isolation: isolate;
    /* clip, not hidden: hidden makes the band a scroll container, and the
       photograph's scroll-driven drift would then track the band (which
       never scrolls) instead of the page. */
    overflow: clip;
    background: var(--color-navy);
    color: var(--text-inverse);
  }

  .phead__in {
    position: relative;
    z-index: 2;
    padding-block: clamp(56px, 7.5vw, 104px) clamp(48px, 6.5vw, 88px);
  }
  /* The copy stays in the left half; the photograph starts at the centre
     line. They never overlap on desktop, so the photograph can stay clear. */
  .phead--media .phead__in > * {
    max-width: min(600px, calc(50% - 48px));
  }

  .phead h1 {
    font-size: var(--fs-page-h1);
  }
  :global(html[lang^='zh']) .phead h1 {
    letter-spacing: 0;
    line-height: 1.25;
  }
  .phead__lead {
    margin-top: 22px;
    max-width: 56ch;
  }

  /* The photograph fills the right of the band, edge to edge. A navy scrim
     runs from the copy side so the join is soft and the text never sits on
     detail (§6 rule, applied here too). */
  .phead__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 50%;
    z-index: 0;
    /* The drift enlarges the photograph slightly; clip it to its box so no
       edge ever shows outside the shading. clip, not hidden, so the
       scroll-driven drift still follows the page. */
    overflow: clip;
  }
  .phead__media :global(picture) {
    display: block;
    height: 100%;
  }
  .phead__media :global(.phead__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The photograph settles as the page opens. Image only — the copy is
       readable from the first frame (§7). */
    animation: phead-settle 1.8s var(--ease-out-expo) both;
  }
  @keyframes phead-settle {
    from { transform: scale(1.1); opacity: .7; }
    to { transform: none; opacity: 1; }
  }

  /* As the band scrolls away the photograph drifts a little slower than the
     page. Scroll-driven, no script; browsers without support get a still
     image. The wrapper is scaled so the drift never shows an edge. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .phead__media :global(picture) {
        animation: phead-drift linear both;
      }
      /* Timeline in its own, more specific rule: the minifier otherwise
         folds it into the animation shorthand, which browsers reject. */
      .phead .phead__media :global(picture) {
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      @keyframes phead-drift {
        from { transform: translateY(0) scale(1.08); }
        to { transform: translateY(6%) scale(1.08); }
      }
    }
  }
  .phead__media::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Light shading: a soft navy join at the left edge only, then the
       photograph shows clearly (client request, Nov 2026). */
    background: linear-gradient(
      to right,
      var(--color-navy) 0%,
      rgb(var(--scrim-rgb) / .35) 14%,
      rgb(var(--scrim-rgb) / .08) 36%,
      rgb(var(--scrim-rgb) / 0) 60%
    );
  }

  /* A short cyan rule on the band's lower edge, on the gutter line — the same
     accent the footer uses. */
  .phead::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: max(var(--wrap-pad), calc((100% - var(--wrap-max)) / 2 + var(--wrap-pad)));
    z-index: 3;
    width: 72px;
    height: 3px;
    background: var(--color-cyan);
    transform-origin: left;
    animation: phead-rule .9s var(--ease-out-expo) .35s both;
  }
  @keyframes phead-rule {
    from { transform: scaleX(0); }
    to { transform: none; }
  }

  /* The body follows the band directly: a tighter top than a full section,
     and its first block brings no margin of its own. */
  .phead__body {
    padding-top: var(--section-y-tight);
  }
  .phead__body > :global(:first-child) {
    margin-top: 0;
  }

  /* Phones and tablets: the photograph gets its own strip above the copy,
     so it shows clearly and the text sits on plain navy. A short fade at
     the bottom of the strip joins it to the band. */
  @media (max-width: 60rem) {
    .phead--media .phead__in > * {
      max-width: none;
    }
    .phead__media {
      position: relative;
      left: auto;
      height: clamp(190px, 46vw, 340px);
    }
    .phead__media::after {
      background: linear-gradient(
        to bottom,
        rgb(var(--scrim-rgb) / 0) 55%,
        var(--color-navy) 100%
      );
    }
    .phead--media .phead__in {
      padding-top: clamp(20px, 4vw, 32px);
    }
  }
</style>
