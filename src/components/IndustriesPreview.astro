---
import { Picture } from 'astro:assets';
import { industries } from '~/data/industries';
import { industriesHref, industryHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, pick, useTranslations } from '~/i18n/ui';

/**
 * §7.4 — image-led industry cards, entry to /industries.
 *
 * Composition: an asymmetric mosaic — one tall photograph, two stacked beside
 * it — then the remaining industries as a single ruled line of names. Three
 * images, not nine: the homepage previews, /industries carries the detail.
 *
 * Each card is one link to that industry's entry on /industries. The name is
 * text over a navy scrim at the foot of the photograph only.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featured = industries.slice(0, 3);
const rest = industries.slice(3);
---

<section class="ind-preview" aria-labelledby="ind-preview-title">
  <div class="wrap">
    <div class="ind-preview__head rv">
      <div>
        <p class="eyebrow">{t('home.industries.eyebrow')}</p>
        <h2 class="ind-preview__title" id="ind-preview-title">{t('industries.heading')}</h2>
      </div>
      <a class="link-arrow" href={localisePath(industriesHref, lang)}>
        {t('home.industries.all')(industries.length)}
        <svg class="link-arrow__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M1 7.25h11.19L7.47 2.53l1.06-1.06L15.06 8l-6.53 6.53-1.06-1.06 4.72-4.72H1z" fill="currentColor" />
        </svg>
      </a>
    </div>

    <ul class="ind-preview__mosaic">
      {
        featured.map((industry, i) => (
          <li class:list={['ind-card', { 'ind-card--lead': i === 0 }]}>
            <a class="ind-card__link" href={localisePath(industryHref(industry.slug), lang)}>
              <Picture
                src={industry.image}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={i === 0 ? [480, 840, 1200] : [480, 720, 960]}
                sizes={i === 0 ? '(min-width: 1040px) 56vw, 100vw' : '(min-width: 1040px) 40vw, 100vw'}
                alt=""
                class="ind-card__img"
                loading="lazy"
                decoding="async"
              />
              <span class="ind-card__copy">
                <span class="ind-card__name">{pick(industry.name, lang)}</span>
                <span class="ind-card__blurb">{pick(industry.blurb, lang)}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ind-preview__rest">
      <p class="eyebrow ind-preview__also">{t('home.industries.also')}</p>
      <ul class="ind-preview__names">
        {
          rest.map((industry) => (
            <li>
              <a class="ind-preview__name" href={localisePath(industryHref(industry.slug), lang)}>
                {pick(industry.name, lang)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .ind-preview {
    padding-block: var(--section-y);
    background: var(--surface-page);
  }

  .ind-preview__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .ind-preview__title {
    margin-top: 12px;
    max-width: 16ch;
  }

  /* -- mosaic ------------------------------------------------------------ */
  .ind-preview__mosaic {
    display: grid;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ind-card__link {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-navy);
    color: var(--text-inverse);
    text-decoration: none;
  }
  .ind-card__link:focus-visible {
    outline-offset: 3px;
  }
  .ind-card__link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }
  .ind-card__link:hover :global(img) {
    transform: scale(1.04);
  }

  /* Legibility scrim, foot of the photograph only. */
  .ind-card__link::after {
    content: '';
    position: absolute;
    inset: 40% 0 0 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-navy) 92%, transparent),
      transparent
    );
  }

  .ind-card__copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: grid;
    gap: 6px;
    padding: 20px;
  }
  .ind-card__name {
    font-family: var(--font-stack-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--dur-fast);
  }
  .ind-card__link:hover .ind-card__name,
  .ind-card__link:focus-visible .ind-card__name {
    text-decoration-color: currentColor;
  }
  .ind-card__blurb {
    font-size: var(--fs-small);
    color: var(--on-dark-2);
  }

  /* -- the rest, as a ruled line of names -------------------------------- */
  .ind-preview__rest {
    display: grid;
    gap: 12px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--rule-light);
  }
  .ind-preview__names {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ind-preview__name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-stack-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--rule-control);
    text-underline-offset: 5px;
  }
  .ind-preview__name:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }

  @media (min-width: 720px) {
    .ind-preview__mosaic {
      grid-template-columns: 1fr 1fr;
    }
    .ind-card--lead {
      grid-column: 1 / -1;
    }
    .ind-card--lead .ind-card__link {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 1040px) {
    .ind-preview__mosaic {
      grid-template-columns: 7fr 5fr;
      grid-template-rows: auto auto;
      gap: 20px;
    }
    .ind-card--lead {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .ind-card--lead .ind-card__link {
      aspect-ratio: auto;
      height: 100%;
      min-height: 560px;
    }
    .ind-card--lead .ind-card__name {
      font-size: var(--fs-h2);
      font-weight: 600;
    }
    .ind-card__copy {
      padding: 28px;
    }
    .ind-preview__rest {
      grid-template-columns: 3fr 9fr;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ind-card__link:hover :global(img) {
      transform: none;
    }
  }
</style>
