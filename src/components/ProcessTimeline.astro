---
import { processSteps } from '~/data/process';
import { getLangFromUrl, pick, useTranslations } from '~/i18n/ui';

/**
 * CLAUDE.md §6.10 — 5 steps, amber line fills on scroll.
 *
 * The steps are an ordered list, because they are one: this is what happens to
 * an enquiry, first to last. A screen reader gets "list, 5 items" and the order
 * for free, which is the whole content of the section.
 *
 * §9 — under reduced motion the line is simply drawn full and every step is
 * marked reached. Nothing grows. The CSS does that on its own; the script
 * checks the same query and declines to run.
 *
 * The line is also full when the script has not run at all, so a failed bundle
 * leaves a finished-looking timeline rather than a permanently empty one.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const total = processSteps.length;
---

<section class="process" id="process" data-process>
  <div class="wrap">
    <div class="process__head rv">
      <h2>{t('process.heading')}</h2>
    </div>

    <div class="process__track">
      <div class="process__line" aria-hidden="true">
        <div class="process__fill" data-process-fill></div>
      </div>

      <ol class="process__steps">
        {
          processSteps.map((step, i) => (
            <li class="pstep is-on" data-process-step data-index={i}>
              <span class="pstep__knot" aria-hidden="true">
                {i + 1}
              </span>
              <span class="sr-only">{t('process.stepCount')(i + 1, total)}</span>
              <b class="pstep__name">{pick(step.name, lang)}</b>
              <small class="pstep__body">{pick(step.description, lang)}</small>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import '~/scripts/process-timeline';
</script>

<style>
  .process {
    padding-block: var(--section-y);
  }

  .process__head {
    margin-bottom: 44px;
  }

  .process__track {
    position: relative;
    margin-top: 44px;
  }

  /* The connecting line only makes sense when the steps sit in a row, so it is
     drawn from the desktop breakpoint up. */
  .process__line {
    display: none;
  }

  .process__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    position: relative;
  }

  .pstep {
    display: block;
  }

  .pstep__knot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid var(--rule);
    background: var(--paper);
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-stack-mono);
    font-size: .62rem;
    color: var(--steel);
    transition:
      border-color var(--dur),
      background var(--dur),
      color var(--dur);
  }
  .pstep.is-on .pstep__knot {
    border-color: var(--signal);
    background: var(--signal);
    color: var(--ink);
  }

  .pstep__name {
    display: block;
    font-family: var(--font-stack-display);
    font-size: 1.15rem;
    font-weight: 500;
    margin: 18px 0 6px;
  }
  .pstep__body {
    display: block;
    color: var(--steel);
    font-size: .88rem;
    line-height: 1.5;
    max-width: 26ch;
  }

  /* Once the script is running it owns the state: it takes the line back to
     zero and re-marks each step as it is reached. Before that — and if the
     bundle never arrives — everything above leaves the timeline complete. */
  .process.is-live .process__fill {
    width: 0;
  }
  .process.is-live .pstep:not(.is-on) .pstep__knot {
    border-color: var(--rule);
    background: var(--paper);
    color: var(--steel);
  }

  @media (prefers-reduced-motion: reduce) {
    .pstep__knot {
      transition: none;
    }
    .process__fill {
      transition: none;
    }
  }

  @media (min-width: 720px) {
    .process__steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .process__line {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 11px;
      height: 2px;
      background: var(--rule);
    }
    .process__fill {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: 100%;
      background: var(--signal);
      transition: width .9s var(--ease);
    }
    .process__steps {
      grid-template-columns: repeat(5, 1fr);
      gap: 24px;
    }
  }
</style>
