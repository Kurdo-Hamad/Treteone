---
import { processSteps } from '~/data/process';
import { getLangFromUrl, pick, useTranslations } from '~/i18n/ui';

/**
 * /sourcing — 5 steps; the connecting line fills as the steps come into view.
 *
 * The steps are an ordered list, because they are one: what happens to an
 * enquiry, first to last. A screen reader gets "list, 5 items" and the order.
 *
 * §11 — under reduced motion the line is simply drawn full and every step is
 * marked reached. The line is also full when the script has not run, so a
 * failed bundle leaves a finished timeline rather than an empty one.
 *
 * A reached step is marked by fill AND by the navy knot changing from outline
 * to solid, so the state is never colour alone.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const total = processSteps.length;
---

<section class="process" id="process" aria-labelledby="process-title" data-process>
  <div class="wrap">
    <div class="process__head rv">
      <h2 id="process-title">{t('process.heading')}</h2>
      <p class="process__lede">{t('process.lede')}</p>
    </div>

    <div class="process__track">
      <div class="process__line" aria-hidden="true">
        <div class="process__fill" data-process-fill></div>
      </div>

      <ol class="process__steps">
        {
          processSteps.map((step, i) => (
            <li class="pstep is-on" data-process-step data-index={i}>
              <span class="pstep__knot" aria-hidden="true">
                {i + 1}
              </span>
              <span class="sr-only">{t('process.stepCount')(i + 1, total)}</span>
              <h3 class="pstep__name">{pick(step.name, lang)}</h3>
              <p class="pstep__body">{pick(step.description, lang)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import '~/scripts/process-timeline';
</script>

<style>
  .process {
    padding-block: var(--section-y);
    background: var(--surface-card);
    border-top: 1px solid var(--rule-light);
  }

  .process__lede {
    margin-top: 16px;
    color: var(--text-body);
  }

  .process__track {
    position: relative;
    margin-top: clamp(40px, 5vw, 64px);
  }

  /* The connecting line only makes sense when the steps sit in a row. */
  .process__line {
    display: none;
  }

  .process__steps {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pstep__knot {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 2px solid var(--color-navy);
    border-radius: 50%;
    background: var(--surface-card);
    font-family: var(--font-stack-mono);
    font-size: .8125rem;
    color: var(--color-navy);
    transition:
      background var(--dur),
      color var(--dur);
  }
  .pstep.is-on .pstep__knot {
    background: var(--color-navy);
    color: var(--text-inverse);
  }

  .pstep__name {
    margin: 20px 0 8px;
    font-size: 1.375rem;
  }
  .pstep__body {
    max-width: 30ch;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-body);
  }

  /* Once the script runs it owns the state: line back to zero, each step
     re-marked as it is reached. */
  .process.is-live .process__fill {
    width: 0;
  }
  .process.is-live .pstep:not(.is-on) .pstep__knot {
    background: var(--surface-card);
    color: var(--color-navy);
  }

  @media (prefers-reduced-motion: reduce) {
    .pstep__knot,
    .process__fill {
      transition: none;
    }
  }

  @media (min-width: 720px) {
    .process__steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .process__line {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 15px;
      height: 2px;
      background: var(--rule-light);
    }
    .process__fill {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background: var(--color-navy);
      transition: width .9s var(--ease);
    }
    .process__steps {
      grid-template-columns: repeat(5, 1fr);
      gap: 24px;
    }
  }
</style>
