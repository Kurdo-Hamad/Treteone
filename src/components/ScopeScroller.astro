---
import { Picture } from 'astro:assets';
import { scopeStages } from '~/data/scope';
import { getLangFromUrl, pick, useTranslations } from '~/i18n/ui';

/**
 * /about — the component-to-system scope ladder. Sticky image left, five
 * stages scrolling right, image and corner tag swap per stage. Stacks on mobile.
 *
 * Every stage's tag is rendered here at build time and the script only toggles
 * which one is visible, so no translation reaches the browser and the first
 * stage is in the HTML for a crawler — the same pattern as the hero captions.
 *
 * The media column is `aria-hidden`: the corner tag repeats the stage heading
 * sitting beside it, and the photographs are decorative. What a screen reader
 * gets is five headings and five paragraphs in order, which is the argument the
 * section is actually making.
 *
 * ⚠ §12 — the five photographs are stand-ins.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const total = scopeStages.length;
const pad = (n: number): string => String(n).padStart(2, '0');
---

<section class="scope dark-surface" id="scope" aria-labelledby="scope-title" data-scope>
  <div class="scope__grid">
    <div class="scope__media" aria-hidden="true">
      {
        scopeStages.map((stage, i) => (
          <figure class:list={['scope__figure', { 'is-on': i === 0 }]} data-scope-figure>
            <Picture
              src={stage.image}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[600, 900, 1400]}
              sizes="(min-width: 1040px) 50vw, 100vw"
              alt=""
              class="scope__img"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }

      <span class="scope__frame"></span>

      {
        scopeStages.map((stage, i) => (
          <span class:list={['mono', 'scope__tag', { 'is-on': i === 0 }]} data-scope-tag>
            {pick(stage.name, lang)}
          </span>
        ))
      }
    </div>

    <div class="scope__steps">
      <div class="scope__intro">
        <h2 id="scope-title">{t('scope.heading')}</h2>
        <p class="lede scope__lede">{t('scope.lede')}</p>
      </div>

      {
        scopeStages.map((stage, i) => (
          <div
            class:list={['scope__step', { 'is-on': i === 0 }]}
            data-scope-step
            data-index={i}
          >
            <p class="mono scope__step-no">
              <span aria-hidden="true">
                {pad(i + 1)} / {pad(total)}
              </span>
              <span class="sr-only">{t('scope.stepCount')(i + 1, total)}</span>
            </p>
            <h3 class="scope__step-title">{pick(stage.name, lang)}</h3>
            <p class="scope__step-body">{pick(stage.description, lang)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '~/scripts/scope-scroller';
</script>

<style>
  .scope {
    padding: 0;
  }

  .scope__grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  /* -- sticky media ------------------------------------------------------ */

  .scope__media {
    position: sticky;
    /* clears the sticky header */
    top: var(--header-h);
    height: 56svh;
    overflow: hidden;
    background: var(--surface-primary);
  }

  .scope__figure {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity .8s var(--ease);
  }
  .scope__figure.is-on {
    opacity: 1;
  }
  /* No script, no swapping — so the first frame stays put rather than leaving
     an empty column. */
  .scope:not(.is-live) .scope__figure:first-of-type {
    opacity: 1;
  }

  .scope__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scope__frame {
    position: absolute;
    inset: 28px;
    border: 1px solid var(--rule-dark);
    pointer-events: none;
    z-index: 2;
  }

  .scope__tag {
    position: absolute;
    left: 28px;
    bottom: 28px;
    z-index: 3;
    padding: 6px 10px;
    background: var(--color-navy);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-cyan-light);
    opacity: 0;
    transition: opacity .4s var(--ease);
  }
  .scope__tag.is-on {
    opacity: 1;
  }
  .scope:not(.is-live) .scope__tag:first-of-type {
    opacity: 1;
  }
  /* §5 — no letter-spacing on Chinese headings, and uppercasing does nothing
     to Hanzi but would still stretch any Latin mixed into it. */
  :global(html[lang^='zh']) .scope__tag {
    letter-spacing: 0;
    text-transform: none;
  }

  /* -- steps ------------------------------------------------------------- */

  .scope__steps {
    padding-inline: var(--wrap-pad-sm);
  }

  .scope__intro {
    padding-block: 56px;
  }
  .scope__lede {
    margin-top: 16px;
    color: var(--on-dark-3);
  }

  .scope__step {
    border-top: 1px solid var(--rule-dark);
    padding-block: 38px;
  }

  .scope__step-no {
    letter-spacing: .1em;
    color: var(--on-dark-4);
    margin-bottom: 14px;
    transition: color var(--dur);
  }
  .scope__step.is-on .scope__step-no {
    color: var(--color-cyan-light);
  }

  .scope__step-title {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    letter-spacing: var(--tracking-h23);
    /* The prototype dims inactive headings to 42% opacity. §11 puts the floor on
       a dark ground at .50 — 5.05:1 — so the emphasis is carried by a token
       rather than by fading text below the contrast floor. */
    color: var(--on-dark-4);
    transition: color var(--dur);
  }
  .scope__step.is-on .scope__step-title {
    color: var(--text-inverse);
  }

  .scope__step-body {
    color: var(--on-dark-3);
    margin-top: 12px;
    font-size: .98rem;
    max-width: 36ch;
  }

  /* §11 — nothing fades. Which stage is current is information, so it still
     tracks the scroll; it just changes instantly instead of crossfading. */
  @media (prefers-reduced-motion: reduce) {
    .scope__figure,
    .scope__tag,
    .scope__step-no,
    .scope__step-title {
      transition: none;
    }
  }

  @media (min-width: 1040px) {
    .scope__grid {
      grid-template-columns: 1fr 1fr;
    }

    .scope__media {
      top: 0;
      height: 100svh;
    }
    .scope__frame,
    .scope__tag {
      inset: unset;
    }
    .scope__frame {
      inset: 28px;
    }
    .scope__tag {
      left: 48px;
      bottom: 48px;
    }

    .scope__steps {
      padding-inline: clamp(28px, 5vw, 72px);
    }
    .scope__intro {
      min-height: 60svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: 80px;
    }
    .scope__step {
      min-height: 82svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: 60px;
    }
  }
</style>
