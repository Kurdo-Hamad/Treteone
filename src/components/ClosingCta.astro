---
import { company, mailHref } from '~/data/company';
import { quoteHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * §7.7 — the large navy closing statement. Also closes every detail route
 * except /quote itself, so whichever page a buyer finishes on, the form is one
 * step away (§1, job one).
 *
 * Composition: one statement at display size, then a ruled row of actions.
 * Deliberately unlike the hard-to-find block, which is a two-column argument.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="closing dark-surface" aria-labelledby="closing-title">
  <div class="wrap">
    <p class="eyebrow closing__eyebrow">{t('closing.eyebrow')}</p>
    <h2 class="closing__title rv" id="closing-title">{t('closing.heading')}</h2>

    <div class="closing__row rv">
      <p class="closing__lede">{t('closing.lede')}</p>

      <div class="closing__actions">
        <a class="btn" href={localisePath(quoteHref, lang)}>{t('cta.quote')}</a>
        <p class="closing__direct">
          <span class="closing__direct-label">{t('closing.direct')}</span>
          <a class="closing__link" href={mailHref}>{company.email}</a>
          <a
            class="closing__link"
            href={company.whatsappUrl}
            rel="noopener noreferrer"
            target="_blank">{t('cta.whatsapp')} {company.phoneDisplay}</a
          >
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .closing {
    padding-block: clamp(80px, 11vw, 160px) clamp(64px, 8vw, 112px);
    background: var(--surface-anchor);
  }

  .closing__eyebrow {
    color: var(--color-cyan-light);
  }

  .closing__title {
    margin-top: 20px;
    max-width: 14ch;
    /* §5 has no display size, only display tracking and leading. The statement
       takes the largest locked size and the display rhythm. */
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--text-inverse);
    text-wrap: balance;
  }
  :global(html[lang^='zh']) .closing__title {
    line-height: 1.2;
  }

  .closing__row {
    display: grid;
    gap: 32px;
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: 32px;
    border-top: 1px solid var(--rule-dark);
  }

  .closing__lede {
    max-width: 44ch;
    font-size: var(--fs-hero-lead);
    line-height: 1.55;
    color: var(--on-dark-2);
  }

  .closing__actions {
    display: grid;
    gap: 20px;
    align-content: start;
    justify-items: start;
  }

  .closing__direct {
    display: grid;
    gap: 2px;
    font-size: 1rem;
  }
  .closing__direct-label {
    color: var(--on-dark-3);
    font-size: var(--fs-small);
  }
  .closing__link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    width: fit-content;
    color: var(--text-link-dark);
    text-underline-offset: 4px;
  }
  .closing__link:hover {
    text-decoration-thickness: 2px;
  }

  @media (min-width: 1040px) {
    .closing__row {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
  }
</style>
