---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';

/**
 * Every photography slot on the site renders this component until the real
 * photograph is supplied (CLAUDE.md §12). Swapping in photography later is a
 * change to this one component, not to every page.
 *
 *   subject  what the photograph will show, already localised by the caller
 *            ("Process pump and motor on a baseplate"). Shown as the caption
 *            and read out to assistive tech, so it must be a real subject,
 *            never "image" or "photo".
 *   variant  'wide'  — a card or split image. 16/10 unless the parent sets
 *                      an aspect-ratio or height on it through `class`.
 *            'small' — a capability-grid thumbnail, 4/3, label only.
 *            'hero'  — fills its positioned parent; navy ground, caption
 *                      top-right so the overlay copy has the lower left.
 *   class    passed through, so a parent can size the frame.
 *   image    optional photograph. When given, it fills the frame instead of
 *            the placeholder label (object-fit: cover). Today these are the
 *            Unsplash stand-ins from src/data/standIns.ts, preview only.
 *   priority the one image that should load first (the first hero slide).
 *
 * Mockup source: .ph, .ph-sm and .slide .ph in reference/mockup.html.
 */

interface Props {
  subject: string;
  variant?: 'wide' | 'small' | 'hero';
  class?: string;
  image?: ImageMetadata | undefined;
  priority?: boolean;
}

const { subject, variant = 'wide', class: className, image, priority = false } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));

// Rendered widths per variant, so a phone never downloads a desktop file.
// `sizes` matches the real rendered width (the page gutter is 20px a side,
// the content column caps at 1140px), so a phone at 412px x 1.75 asks for
// ~650px and gets the 720 file, not the 960 one (Lighthouse, Nov 2026).
const sizing = {
  hero: { widths: [640, 960, 1280, 1920], sizes: '100vw' },
  wide: {
    widths: [480, 640, 720, 960, 1200],
    sizes: '(max-width: 960px) calc(100vw - 40px), (max-width: 1180px) 48vw, 560px',
  },
  small: {
    widths: [320, 480, 640],
    sizes: '(max-width: 560px) calc(100vw - 40px), (max-width: 960px) calc(50vw - 30px), 270px',
  },
}[variant];
---

{
  image ? (
    <span class:list={['ph', `ph--${variant}`, 'ph--photo', className]}>
      {/* Stand-in photographs do not show what `subject` describes, so they
          are decorative (alt=""); the text around them carries the meaning. */}
      <Picture
        src={image}
        alt=""
        formats={['avif', 'webp']}
        widths={sizing.widths.filter((w) => w <= image.width)}
        sizes={sizing.sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        class="ph__img"
      />
    </span>
  ) : (

<span
  class:list={['ph', `ph--${variant}`, className]}
  role="img"
  aria-label={t('placeholder.label')(subject)}
>
  <span class="ph__t" aria-hidden="true">
    <svg viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" focusable="false">
      <path d="M3 5h18v14H3z"></path>
      <path d="M3 16.5l5-5 4 4 3-3 6 6"></path>
      <circle cx="8.5" cy="9" r="1.4"></circle>
    </svg>
    {t('placeholder.image')}
    <em>{subject}</em>
  </span>
</span>
  )
}

<style>
  .ph {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--surface-pale);
  }
  .ph::after {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1px dashed var(--placeholder-dash);
    pointer-events: none;
    transition: border-color var(--dur-fast);
  }

  .ph__t {
    position: relative;
    z-index: 2;
    padding: 18px;
    text-align: center;
    font-family: var(--font-stack-display);
    font-weight: 600;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .ph__t svg {
    display: block;
    width: 26px;
    height: 26px;
    margin: 0 auto 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }
  .ph__t em {
    display: block;
    max-width: 30ch;
    margin-top: 7px;
    font-style: normal;
    font-family: var(--font-stack-body);
    font-weight: 400;
    font-size: var(--fs-caption);
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.5;
    color: var(--text-quiet);
  }

  /* -- wide ----------------------------------------------------------------- */
  .ph--wide {
    aspect-ratio: 16 / 10;
  }

  /* -- small ---------------------------------------------------------------- */
  .ph--small {
    aspect-ratio: 4 / 3;
  }
  .ph--small::after {
    inset: 8px;
  }
  .ph--small .ph__t {
    padding: 10px;
  }
  .ph--small .ph__t svg {
    width: 20px;
    height: 20px;
    margin-bottom: 6px;
  }
  .ph--small .ph__t em {
    display: none;
  }

  /* -- hero ----------------------------------------------------------------- */
  .ph--hero {
    position: absolute;
    inset: 0;
    background: var(--color-navy-2);
  }
  .ph--hero::after {
    display: none;
  }
  .ph--hero .ph__t {
    position: absolute;
    top: 26px;
    right: clamp(20px, 3vw, 40px);
    padding: 0;
    text-align: right;
    color: var(--on-dark-4);
  }
  .ph--hero .ph__t svg {
    width: 18px;
    height: 18px;
    margin: 0 0 7px auto;
  }
  .ph--hero .ph__t em {
    margin-left: auto;
    text-align: right;
    color: var(--on-dark-4);
  }

  /* -- with a photograph ---------------------------------------------------- */
  .ph--photo::after {
    display: none;
  }
  .ph--photo :global(picture) {
    position: absolute;
    inset: 0;
  }
  .ph--photo :global(.ph__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .9s var(--ease-out-expo);
  }

  /* -- photo cards: hover and keyboard focus ---------------------------------
     Any card link that wraps a placeholder (.card, .cap__link): the frame
     lifts on a soft navy shadow, the photograph zooms in, and a cyan bar
     draws along its foot. Focus gets the same, so a keyboard user sees what
     a mouse user sees (§11). The hero is excluded — it is not a card. */
  .ph:not(.ph--hero) {
    transition:
      transform .5s var(--ease-out-expo),
      box-shadow .5s var(--ease-out-expo);
  }
  .ph:not(.ph--hero)::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    height: 3px;
    background: var(--color-cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .55s var(--ease-out-expo);
  }
  :global(:is(.card, .cap__link):is(:hover, :focus-visible)) .ph:not(.ph--hero) {
    transform: translateY(-6px);
    box-shadow: var(--shadow-floating);
  }
  :global(:is(.card, .cap__link):is(:hover, :focus-visible)) .ph:not(.ph--hero)::before {
    transform: none;
  }
  :global(:is(.card, .cap__link):is(:hover, :focus-visible)) .ph--photo :global(.ph__img) {
    transform: scale(1.1);
  }

  /* On a pale band the placeholder takes the white ground, or it would vanish
     into the band and leave a floating dashed frame. */
  :global(.pale) .ph:not(.ph--photo):not(.ph--hero) {
    background: var(--surface-page);
  }

  /* A card that wraps a placeholder (no photograph yet) highlights its
     dashed frame on hover. */
  :global(a:hover) > .ph::after,
  :global(:is(.card, .cap__link):hover) .ph::after {
    border-color: var(--color-cyan);
  }

  @media (max-width: 35rem) {
    .ph--hero .ph__t {
      top: 20px;
      right: 20px;
    }
    .ph--hero .ph__t em {
      display: none;
    }
  }
</style>
