---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';

/**
 * Every photography slot on the site renders this component until the real
 * photograph is supplied (CLAUDE.md §12). Swapping in photography later is a
 * change to this one component, not to every page.
 *
 *   subject  what the photograph will show, already localised by the caller
 *            ("Process pump and motor on a baseplate"). Shown as the caption
 *            and read out to assistive tech, so it must be a real subject,
 *            never "image" or "photo".
 *   variant  'wide'  — a card or split image. 16/10 unless the parent sets
 *                      an aspect-ratio or height on it through `class`.
 *            'small' — a capability-grid thumbnail, 4/3, label only.
 *            'hero'  — fills its positioned parent; navy ground, caption
 *                      top-right so the overlay copy has the lower left.
 *   class    passed through, so a parent can size the frame.
 *   image    optional photograph. When given, it fills the frame instead of
 *            the placeholder label (object-fit: cover). Today these are the
 *            Unsplash stand-ins from src/data/standIns.ts, preview only.
 *   priority the one image that should load first (the first hero slide).
 *
 * Mockup source: .ph, .ph-sm and .slide .ph in reference/mockup.html.
 */

interface Props {
  subject: string;
  variant?: 'wide' | 'small' | 'hero';
  class?: string;
  image?: ImageMetadata | undefined;
  priority?: boolean;
}

const { subject, variant = 'wide', class: className, image, priority = false } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));

// Rendered widths per variant, so a phone never downloads a desktop file.
const sizing = {
  hero: { widths: [640, 960, 1280, 1920], sizes: '100vw' },
  wide: { widths: [480, 720, 960, 1200], sizes: '(max-width: 960px) 100vw, 40vw' },
  small: { widths: [320, 480, 640], sizes: '(max-width: 560px) 100vw, (max-width: 960px) 50vw, 25vw' },
}[variant];
---

{
  image ? (
    <span class:list={['ph', `ph--${variant}`, 'ph--photo', className]}>
      {/* Stand-in photographs do not show what `subject` describes, so they
          are decorative (alt=""); the text around them carries the meaning. */}
      <Picture
        src={image}
        alt=""
        formats={['avif', 'webp']}
        widths={sizing.widths.filter((w) => w <= image.width)}
        sizes={sizing.sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        class="ph__img"
      />
    </span>
  ) : (

<span
  class:list={['ph', `ph--${variant}`, className]}
  role="img"
  aria-label={t('placeholder.label')(subject)}
>
  <span class="ph__t" aria-hidden="true">
    <svg viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" focusable="false">
      <path d="M3 5h18v14H3z"></path>
      <path d="M3 16.5l5-5 4 4 3-3 6 6"></path>
      <circle cx="8.5" cy="9" r="1.4"></circle>
    </svg>
    {t('placeholder.image')}
    <em>{subject}</em>
  </span>
</span>
  )
}

<style>
  .ph {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--surface-pale);
  }
  .ph::after {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1px dashed var(--placeholder-dash);
    pointer-events: none;
    transition: border-color var(--dur-fast);
  }

  .ph__t {
    position: relative;
    z-index: 2;
    padding: 18px;
    text-align: center;
    font-family: var(--font-stack-mono);
    font-size: .6rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .ph__t svg {
    display: block;
    width: 26px;
    height: 26px;
    margin: 0 auto 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }
  .ph__t em {
    display: block;
    max-width: 30ch;
    margin-top: 7px;
    font-style: normal;
    font-size: .72rem;
    letter-spacing: .02em;
    text-transform: none;
    line-height: 1.5;
    color: var(--text-quiet);
  }

  /* -- wide ----------------------------------------------------------------- */
  .ph--wide {
    aspect-ratio: 16 / 10;
  }

  /* -- small ---------------------------------------------------------------- */
  .ph--small {
    aspect-ratio: 4 / 3;
  }
  .ph--small::after {
    inset: 8px;
  }
  .ph--small .ph__t {
    padding: 10px;
    font-size: .55rem;
    letter-spacing: .12em;
  }
  .ph--small .ph__t svg {
    width: 20px;
    height: 20px;
    margin-bottom: 6px;
  }
  .ph--small .ph__t em {
    display: none;
  }

  /* -- hero ----------------------------------------------------------------- */
  .ph--hero {
    position: absolute;
    inset: 0;
    background: var(--color-navy-2);
  }
  .ph--hero::after {
    display: none;
  }
  .ph--hero .ph__t {
    position: absolute;
    top: 26px;
    right: clamp(20px, 3vw, 40px);
    padding: 0;
    text-align: right;
    font-size: .58rem;
    color: rgba(255, 255, 255, .5);
  }
  .ph--hero .ph__t svg {
    width: 18px;
    height: 18px;
    margin: 0 0 7px auto;
  }
  .ph--hero .ph__t em {
    margin-left: auto;
    text-align: right;
    color: rgba(255, 255, 255, .5);
  }

  /* -- with a photograph ---------------------------------------------------- */
  .ph--photo::after {
    display: none;
  }
  .ph--photo :global(picture) {
    position: absolute;
    inset: 0;
  }
  .ph--photo :global(.ph__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .6s var(--ease);
  }
  :global(.card:hover) .ph--photo :global(.ph__img) {
    transform: scale(1.03);
  }

  /* A card that wraps a placeholder highlights its frame on hover. */
  :global(a:hover) > .ph::after,
  :global(.card:hover) .ph::after {
    border-color: var(--color-cyan);
  }

  @media (max-width: 560px) {
    .ph--hero .ph__t {
      top: 20px;
      right: 20px;
    }
    .ph--hero .ph__t em {
      display: none;
    }
  }
</style>
