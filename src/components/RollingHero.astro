---
import Icon from '~/components/Icon.astro';
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import { quoteHref } from '~/data/navigation';
import { standIn } from '~/data/standIns';
import { heroSlides } from '~/data/heroSlides';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * Homepage rolling hero — CLAUDE.md §6, approved mockup (#v-home .hero-media).
 *
 * Full-bleed, flush under the masthead: no .wrap on the section itself, only
 * on the overlay and the bar, so the media runs edge to edge while the copy
 * lines up with the page gutter.
 *
 * Four tab panels. Each panel holds its own photograph slot AND its own
 * title, line and actions, so every panel is complete in the HTML —
 * nothing is written in by script, and with JS off the first panel simply
 * stays up. The script (src/scripts/rolling-hero.ts) only moves the
 * selection.
 *
 * Bar below the image: pause/play plus a real tablist (role="tab",
 * aria-selected, roving tabindex, arrow keys). Below 700px the four segments
 * share the width with their labels visually hidden, so a phone visitor can
 * see there are four slides and tap any of them.
 *
 * The panels share one grid cell, so the stage grows with its copy: at a
 * large browser text size nothing is clipped (WCAG 1.4.4).
 *
 * Under prefers-reduced-motion it rests on panel one with the play icon
 * showing; nothing moves until the visitor presses play.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero dark-surface" data-hero>
  <div class="hero__stage">
    {
      heroSlides.map((slide, i) => (
        <div
          class:list={['hero__panel', { 'is-on': i === 0 }]}
          id={`hero-panel-${slide.id}`}
          role="tabpanel"
          aria-labelledby={`hero-tab-${slide.id}`}
          data-hero-panel
        >
          <ImagePlaceholder
            subject={t(slide.subject)}
            variant="hero"
            image={standIn(slide.subject)}
            priority={i === 0}
          />
          <div class="hero__overlay">
            <div class="wrap">
              <p class="hero__title">{t(slide.title)}</p>
              <p class="hero__line">{t(slide.line)}</p>
              <p class="hero__actions">
                <a class="btn" href={localisePath(quoteHref, lang)}>
                  {t('home.intro.ctaQuote')} <Icon name="arrow-right" />
                </a>
                <a class="hero__more" href={localisePath(slide.href, lang)}>
                  {t(slide.link)} <Icon name="arrow-right" />
                </a>
              </p>
            </div>
          </div>
        </div>
      ))
    }
    <span class="hero__scrim" aria-hidden="true"></span>
  </div>

  <div class="wrap hero__bar">
    <button
      class="hero__pp"
      type="button"
      aria-label={t('home.hero.pause')}
      data-hero-pp
      data-label-pause={t('home.hero.pause')}
      data-label-play={t('home.hero.play')}
    >
      <svg class="hero__icon hero__icon--pause" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
        <path d="M2.5 1.5h2.5v9H2.5zM7 1.5h2.5v9H7z" fill="currentColor"></path>
      </svg>
      <svg class="hero__icon hero__icon--play" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
        <path d="M3 1.25v9.5L10.5 6z" fill="currentColor"></path>
      </svg>
    </button>

    <div class="hero__tabs" role="tablist" aria-label={t('home.hero.tablist')}>
      {
        heroSlides.map((slide, i) => (
          <button
            class="hero__tab"
            type="button"
            role="tab"
            id={`hero-tab-${slide.id}`}
            aria-controls={`hero-panel-${slide.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-hero-tab
          >
            <i class="hero__seg" aria-hidden="true"></i>
            <span class="hero__label">{t(slide.title)}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '~/scripts/rolling-hero';
</script>

<style>
  /* The hero is a navy ground (.dark-surface sets the roles, so focus rings
     are cyan-light and .btn takes its cyan form). The dwell time lives here
     once; the progress segment animates on it and the script reads it. */
  .hero {
    --hero-dwell: 5s;

    position: relative;
    overflow: clip;
    background: var(--color-navy);
    color: var(--text-inverse);
  }

  /* -- stage ---------------------------------------------------------------- */
  /* All four panels sit in one grid cell, so the stage is as tall as the
     tallest panel's copy — or the minimum below, whichever is more. */
  .hero__stage {
    position: relative;
    isolation: isolate;
    display: grid;
    /* minmax(0, 1fr): a long word in a large title must wrap, never widen
       the stage past the screen. */
    grid-template-columns: minmax(0, 1fr);
    min-height: clamp(480px, 66vh, 700px);
  }

  /* Panels never create a stacking context of their own (no opacity, no
     z-index on .hero__panel), so the one scrim can sit above every photograph
     and below every overlay. The photograph and the copy fade separately:
     the image crossfades slowly, the copy steps out and back in quickly, so
     two lines of text are never legible on top of each other. */
  .hero__panel {
    grid-area: 1 / 1;
    min-width: 0;
    position: relative;
    display: grid;
    align-content: end;
    visibility: hidden;
    /* An outgoing panel stays visible while its image fades, but never
       catches a click meant for the panel coming in. */
    pointer-events: none;
    transition: visibility 0s linear .8s;
  }
  .hero__panel.is-on {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .hero__panel :global(.ph) {
    z-index: 0;
    opacity: 0;
    transition: opacity .8s var(--ease);
  }
  .hero__panel.is-on :global(.ph) {
    opacity: 1;
  }

  /* Navy scrim (§6). A soft left-to-right shade over the photograph, plus a
     deeper pool in the lower left where the copy sits, so the copy keeps its
     contrast on any photograph while the rest of the image stays clear. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(110% 95% at 0% 100%, rgb(var(--scrim-rgb) / .88) 0%, rgb(var(--scrim-rgb) / .66) 40%, rgb(var(--scrim-rgb) / 0) 74%),
      linear-gradient(80deg, rgb(var(--scrim-rgb) / .55) 0%, rgb(var(--scrim-rgb) / .3) 40%, rgb(var(--scrim-rgb) / .06) 75%, rgb(var(--scrim-rgb) / 0) 100%);
  }

  .hero__overlay {
    position: relative;
    z-index: 2;
    padding-block: clamp(96px, 14vh, 160px) clamp(28px, 4vw, 52px);
    color: var(--text-inverse);
    opacity: 0;
    transition: opacity .25s var(--ease);
  }
  .hero__panel.is-on .hero__overlay {
    opacity: 1;
    transition: opacity .35s var(--ease) .3s;
  }

  /* Slow zoom on the photograph of the active slide: it starts a touch
     close and settles over the slide's dwell, so the image is always
     moving while it is on screen. Image only — never the copy (§7). */
  .hero__panel.is-on :global(.ph__img) {
    animation: hero-zoom calc(var(--hero-dwell) + 1.5s) var(--ease-out-expo) both;
  }
  @keyframes hero-zoom {
    from { transform: scale(1.09); }
    to { transform: scale(1); }
  }

  /* When the slide changes (rolling-hero.ts adds .is-enter), the copy
     arrives line by line. The first slide never gets .is-enter. */
  .hero__panel.is-enter :is(.hero__title, .hero__line, .hero__actions) {
    animation: hero-copy-in .8s var(--ease-out-expo) backwards;
  }
  /* First paint: the first slide's copy settles in (never from invisible —
     see .settle-in in global.css). Later slides use .is-enter instead. */
  .hero__panel.is-on:not(.is-enter) :is(.hero__title, .hero__line, .hero__actions) {
    animation: settle-in 1s var(--ease-out-expo) backwards;
  }
  .hero__panel.is-on:not(.is-enter) .hero__line { animation-delay: 80ms; }
  .hero__panel.is-on:not(.is-enter) .hero__actions { animation-delay: 160ms; }

  .hero__panel.is-enter .hero__title { animation-delay: .25s; }
  .hero__panel.is-enter .hero__line { animation-delay: .35s; }
  .hero__panel.is-enter .hero__actions { animation-delay: .45s; }
  @keyframes hero-copy-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }

  .hero__title,
  .hero__line {
    max-width: min(680px, 78%);
  }
  .hero__title {
    font-family: var(--font-stack-display);
    font-weight: var(--weight-heading);
    font-size: var(--fs-hero-title);
    line-height: .98;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  :global(html[lang^='zh']) .hero__title {
    letter-spacing: 0;
    line-height: 1.2;
  }
  .hero__line {
    margin-top: 18px;
    font-size: var(--fs-lead);
    line-height: 1.55;
    /* Full white, not the .80 body tier: over a photograph the line must
       hold 4.5:1 against the brightest part of the image behind it. */
    color: var(--on-dark-1);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
    margin-top: 28px;
  }
  .hero__more {
    display: inline-flex;
    align-items: center;
    gap: .5em;
    min-height: 44px;
    font-family: var(--font-stack-display);
    font-weight: 600;
    font-size: var(--fs-small);
    color: var(--text-inverse);
    text-decoration: underline;
    text-decoration-color: var(--on-dark-line);
    text-underline-offset: .35em;
    transition: text-decoration-color var(--dur-fast), color var(--dur-fast);
  }
  .hero__more :global(.ico) {
    transition: transform .25s var(--ease-out-expo);
  }
  .hero__more:hover {
    color: var(--color-cyan-light);
    text-decoration-color: currentColor;
  }
  .hero__more:hover :global(.ico) {
    transform: translateX(3px);
  }

  /* -- bar: pause/play + tablist ------------------------------------------- */
  .hero__bar {
    display: flex;
    align-items: flex-end;
    gap: clamp(14px, 2vw, 26px);
    padding-top: clamp(16px, 2vw, 22px);
    padding-bottom: clamp(18px, 2.2vw, 26px);
  }

  .hero__pp {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--on-dark-line);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--text-inverse);
    cursor: pointer;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .hero__pp:hover {
    background: var(--text-inverse);
    border-color: var(--text-inverse);
    color: var(--color-navy);
  }
  .hero__icon {
    width: 10px;
    height: 10px;
  }
  .hero__icon--play,
  .hero.is-paused .hero__icon--pause {
    display: none;
  }
  .hero.is-paused .hero__icon--play {
    display: block;
  }

  .hero__tabs {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(10px, 1.6vw, 22px);
  }
  .hero__tab {
    position: relative;
    /* Shrink to the label, so the progress line above it is exactly as long
       as the phrase (client request, Nov 2026). */
    justify-self: start;
    max-width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: var(--fs-caption);
    line-height: 1.3;
    color: var(--on-dark-3);
    transition: color var(--dur-fast);
  }
  .hero__tab:hover,
  .hero__tab[aria-selected='true'] {
    color: var(--text-inverse);
  }

  /* The progress segment: as long as its label, 3px heavy. The fill runs
     only once the script is live (.is-run), so with JS off nothing pretends
     to advance. */
  .hero__seg {
    position: relative;
    display: block;
    width: 100%;
    height: 3px;
    margin-bottom: 12px;
    overflow: hidden;
    background: var(--rule-dark);
  }
  .hero__tab[aria-selected='true'] .hero__seg {
    background: var(--on-dark-line);
  }
  .hero__seg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-cyan);
    transform: scaleX(0);
    transform-origin: left;
  }
  .hero__seg.is-run::after {
    animation: hero-fill var(--hero-dwell) linear forwards;
  }
  .hero.is-halted .hero__seg.is-run::after {
    animation-play-state: paused;
  }
  /* Resting state (reduced motion, or paused before it ever ran): the
     selected segment is marked full rather than left empty. */
  .hero.is-paused .hero__tab[aria-selected='true'] .hero__seg:not(.is-run)::after {
    transform: none;
  }
  @keyframes hero-fill {
    to { transform: scaleX(1); }
  }

  /* -- breakpoints ---------------------------------------------------------- */
  @media (max-width: 60rem) {
    .hero__stage {
      min-height: clamp(440px, 64vh, 620px);
    }
    .hero__title,
    .hero__line {
      max-width: none;
    }
    .hero__tabs {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px 18px;
    }
  }

  /* Phone: four short segments side by side, labels hidden, compact bar. */
  @media (max-width: 43.75rem) {
    .hero__scrim {
      background: linear-gradient(
        to top,
        rgb(var(--scrim-rgb) / .86) 0%,
        rgb(var(--scrim-rgb) / .6) 45%,
        rgb(var(--scrim-rgb) / .12) 100%
      );
    }
    .hero__overlay {
      padding-block: 120px 26px;
    }
    .hero__line {
      font-size: var(--fs-body);
    }
    .hero__bar {
      align-items: center;
      gap: 14px;
      padding-top: 14px;
    }
    .hero__pp {
      width: 44px;
      height: 44px;
    }
    .hero__tabs {
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }
    .hero__tab {
      justify-self: stretch;
      display: grid;
      align-items: center;
      /* 44px tall target around a 3px line (§13). */
      min-height: 44px;
    }
    .hero__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .hero__seg {
      margin-bottom: 0;
    }
  }

  @media (max-width: 35rem) {
    .hero__stage {
      min-height: max(480px, 125vw);
    }
  }
</style>
