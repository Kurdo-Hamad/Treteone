---
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import { heroSlides } from '~/data/heroSlides';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * Homepage rolling hero — CLAUDE.md §6, approved mockup (#v-home .hero-media).
 *
 * Full-bleed, flush under the masthead: no .wrap on the section itself, only
 * on the overlay and the bar, so the media runs edge to edge while the copy
 * lines up with the page gutter.
 *
 * Four tab panels. Each panel holds its own photograph slot AND its own
 * eyebrow, title, line and link, so every panel is complete in the HTML —
 * nothing is written in by script, and with JS off the first panel simply
 * stays up. The script (src/scripts/rolling-hero.ts) only moves the
 * selection.
 *
 * Bar below the image: pause/play plus a real tablist (role="tab",
 * aria-selected, roving tabindex, arrow keys). Below 700px only the selected
 * tab shows, as one full-width segment with its label visually hidden.
 *
 * Under prefers-reduced-motion it rests on panel one with the play icon
 * showing; nothing moves until the visitor presses play.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero" data-hero>
  <div class="hero__stage">
    {
      heroSlides.map((slide, i) => (
        <div
          class:list={['hero__panel', { 'is-on': i === 0 }]}
          id={`hero-panel-${slide.id}`}
          role="tabpanel"
          aria-labelledby={`hero-tab-${slide.id}`}
          data-hero-panel
        >
          <ImagePlaceholder subject={t(slide.subject)} variant="hero" />
          <div class="hero__overlay">
            <div class="wrap">
              <p class="kicker hero__eyebrow">{t('home.hero.eyebrow')}</p>
              <p class="hero__title">{t(slide.title)}</p>
              <p class="hero__line">{t(slide.line)}</p>
              <a class="hero__more" href={localisePath(slide.href, lang)}>
                {t(slide.link)} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      ))
    }
    <span class="hero__scrim" aria-hidden="true"></span>
  </div>

  <div class="wrap hero__bar">
    <button
      class="hero__pp"
      type="button"
      aria-label={t('home.hero.pause')}
      data-hero-pp
      data-label-pause={t('home.hero.pause')}
      data-label-play={t('home.hero.play')}
    >
      <svg class="hero__icon hero__icon--pause" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
        <path d="M2.5 1.5h2.5v9H2.5zM7 1.5h2.5v9H7z" fill="currentColor"></path>
      </svg>
      <svg class="hero__icon hero__icon--play" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
        <path d="M3 1.25v9.5L10.5 6z" fill="currentColor"></path>
      </svg>
    </button>

    <div class="hero__tabs" role="tablist" aria-label={t('home.hero.tablist')}>
      {
        heroSlides.map((slide, i) => (
          <button
            class="hero__tab"
            type="button"
            role="tab"
            id={`hero-tab-${slide.id}`}
            aria-controls={`hero-panel-${slide.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-hero-tab
          >
            <i class="hero__seg" aria-hidden="true"></i>
            <span class="hero__label">{t(slide.title)}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '~/scripts/rolling-hero';
</script>

<style>
  /* The hero is a navy ground: it sets its own roles, so focus rings inside
     it are cyan-light (§4, §11). The dwell time lives here once; the progress
     segment animates on it and the script reads it, so they cannot drift. */
  .hero {
    --focus: var(--focus-dark);
    --fg-kicker: var(--color-cyan-light);
    --hero-dwell: 7s;

    position: relative;
    overflow: hidden;
    background: var(--color-navy);
    color: var(--text-inverse);
  }

  /* -- stage ---------------------------------------------------------------- */
  .hero__stage {
    position: relative;
    isolation: isolate;
    height: clamp(400px, 52vh, 540px);
  }

  /* Panels never create a stacking context of their own (no opacity, no
     z-index on .hero__panel), so the one scrim can sit above every photograph
     and below every overlay. The photograph and the copy fade separately:
     the image crossfades slowly, the copy steps out and back in quickly, so
     two lines of text are never legible on top of each other. */
  .hero__panel {
    position: absolute;
    inset: 0;
    visibility: hidden;
    /* An outgoing panel stays visible while its image fades, but never
       catches a click meant for the panel coming in. */
    pointer-events: none;
    transition: visibility 0s linear .8s;
  }
  .hero__panel.is-on {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .hero__panel :global(.ph) {
    z-index: 0;
    opacity: 0;
    transition: opacity .8s var(--ease);
  }
  .hero__panel.is-on :global(.ph) {
    opacity: 1;
  }

  /* Left-to-right navy scrim (§6). It shades the copy side, not the whole
     photograph. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        80deg,
        rgb(var(--scrim-rgb) / .94) 0%,
        rgb(var(--scrim-rgb) / .78) 38%,
        rgb(var(--scrim-rgb) / .26) 72%,
        rgb(var(--scrim-rgb) / .1) 100%
      ),
      linear-gradient(to top, rgb(var(--scrim-rgb) / .7) 0%, rgb(var(--scrim-rgb) / 0) 48%);
  }

  .hero__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding-block: clamp(26px, 3.6vw, 46px);
    color: var(--text-inverse);
    opacity: 0;
    transition: opacity .25s var(--ease);
  }
  .hero__panel.is-on .hero__overlay {
    opacity: 1;
    transition: opacity .35s var(--ease) .3s;
  }

  .hero__eyebrow,
  .hero__title,
  .hero__line {
    max-width: min(640px, 76%);
  }
  .hero__eyebrow {
    margin-bottom: 0;
  }
  .hero__title {
    margin-top: 16px;
    font-family: var(--font-stack-display);
    font-weight: var(--weight-heading);
    font-size: var(--fs-hero-title);
    line-height: 1.04;
    letter-spacing: -.03em;
    text-wrap: balance;
  }
  :global(html[lang^='zh']) .hero__title {
    letter-spacing: 0;
    line-height: 1.2;
  }
  .hero__line {
    margin-top: 16px;
    font-size: clamp(1rem, .95rem + .25vw, 1.125rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, .84);
  }
  .hero__more {
    display: inline-flex;
    align-items: center;
    gap: .5em;
    margin-top: 20px;
    padding-bottom: 3px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-cyan-light) 45%, transparent);
    font-family: var(--font-stack-display);
    font-weight: 600;
    font-size: .9375rem;
    color: var(--color-cyan-light);
    text-decoration: none;
    transition: gap .18s var(--ease), border-color var(--dur-fast);
  }
  .hero__more:hover {
    gap: .9em;
    border-bottom-color: var(--color-cyan-light);
  }

  /* -- bar: pause/play + tablist ------------------------------------------- */
  .hero__bar {
    display: flex;
    align-items: flex-end;
    gap: clamp(14px, 2vw, 26px);
    padding-top: clamp(16px, 2vw, 22px);
    padding-bottom: clamp(18px, 2.2vw, 26px);
  }

  .hero__pp {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, .34);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--text-inverse);
    cursor: pointer;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .hero__pp:hover {
    background: var(--text-inverse);
    border-color: var(--text-inverse);
    color: var(--color-navy);
  }
  .hero__icon {
    width: 10px;
    height: 10px;
  }
  .hero__icon--play,
  .hero.is-paused .hero__icon--pause {
    display: none;
  }
  .hero.is-paused .hero__icon--play {
    display: block;
  }

  .hero__tabs {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(10px, 1.6vw, 22px);
  }
  .hero__tab {
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: .8125rem;
    line-height: 1.3;
    color: rgba(255, 255, 255, .6);
    transition: color var(--dur-fast);
  }
  .hero__tab:hover,
  .hero__tab[aria-selected='true'] {
    color: var(--text-inverse);
  }

  /* The 40px progress segment. The fill runs only once the script is live
     (.is-run), so with JS off nothing pretends to advance. */
  .hero__seg {
    position: relative;
    display: block;
    width: 40px;
    height: 2px;
    margin-bottom: 11px;
    overflow: hidden;
    background: rgba(255, 255, 255, .22);
  }
  .hero__tab[aria-selected='true'] .hero__seg {
    background: rgba(255, 255, 255, .3);
  }
  .hero__seg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-cyan);
    transform: scaleX(0);
    transform-origin: left;
  }
  .hero__seg.is-run::after {
    animation: hero-fill var(--hero-dwell) linear forwards;
  }
  .hero.is-halted .hero__seg.is-run::after {
    animation-play-state: paused;
  }
  /* Resting state (reduced motion, or paused before it ever ran): the
     selected segment is marked full rather than left empty. */
  .hero.is-paused .hero__tab[aria-selected='true'] .hero__seg:not(.is-run)::after {
    transform: none;
  }
  @keyframes hero-fill {
    to { transform: scaleX(1); }
  }

  /* -- breakpoints (mockup: 960 / 700 / 560) -------------------------------- */
  @media (max-width: 960px) {
    .hero__stage {
      height: clamp(400px, 58vh, 520px);
    }
    .hero__eyebrow,
    .hero__title,
    .hero__line {
      max-width: none;
    }
    .hero__tabs {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px 18px;
    }
  }

  /* Phone: one progress line at a time, compact bar. */
  @media (max-width: 700px) {
    .hero__scrim {
      background: linear-gradient(
        to top,
        rgb(var(--scrim-rgb) / .94) 0%,
        rgb(var(--scrim-rgb) / .72) 42%,
        rgb(var(--scrim-rgb) / .18) 100%
      );
    }
    .hero__overlay {
      padding-block: 24px;
    }
    .hero__line {
      font-size: .9375rem;
    }
    .hero__bar {
      align-items: center;
      gap: 14px;
      padding-top: 16px;
    }
    .hero__pp {
      width: 44px;
      height: 44px;
    }
    .hero__tabs {
      display: block;
    }
    .hero__tab {
      display: none;
      width: 100%;
      /* 44px tall target around a 2px line (§13). */
      min-height: 44px;
    }
    .hero__tab[aria-selected='true'] {
      display: block;
    }
    .hero__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .hero__seg {
      width: 100%;
      margin-bottom: 0;
      background: rgba(255, 255, 255, .26);
    }
  }

  @media (max-width: 560px) {
    .hero__stage {
      height: auto;
      aspect-ratio: 3 / 4;
      min-height: 430px;
    }
  }
</style>
