---
import { Picture } from 'astro:assets';
import { heroSlides } from '~/data/hero';
import { productsHref, quoteHref, sourcingHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, pick, useTranslations } from '~/i18n/ui';

/**
 * CLAUDE.md §6 — full-bleed rolling photography, five frames crossfading with
 * a slow zoom, restyled into the navy system. Frame counter, localised
 * caption, progress bars, scroll cue. Frozen under prefers-reduced-motion.
 *
 * Composition: copy holds the left ~45%; the photograph carries the right.
 * The navy scrim sits only behind the copy and the foot bar — the right of the
 * frame is left untinted so the industrial detail stays visible. The scrim is
 * a legibility device, not decoration.
 *
 * The counter and caption for every frame are rendered at build time; the
 * script only toggles which one is visible.
 *
 * On priority: loading="lazy" does NOT defer frames 2-5. Every figure sits at
 * inset:0, so the browser counts all five as in the viewport and fetches them
 * whatever their opacity. fetchpriority is the lever that works.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const total = heroSlides.length;
const pad = (n: number): string => String(n).padStart(2, '0');
---

<section class="hero dark-surface" id="top" data-hero data-header-dark-zone aria-labelledby="hero-title">
  <div class="hero__roll" aria-hidden="true">
    {
      heroSlides.map((slide, i) => (
        <figure class:list={['hero__slide', { 'is-on': i === 0 }]} data-hero-slide>
          <Picture
            src={slide.image}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[640, 1080, 1600, 2400]}
            sizes="100vw"
            alt=""
            class="hero__img"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding={i === 0 ? 'sync' : 'async'}
            fetchpriority={i === 0 ? 'high' : 'low'}
          />
        </figure>
      ))
    }
  </div>

  <div class="wrap hero__body">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">{t('hero.eyebrow')}</p>
      <h1 class="hero__title" id="hero-title">{t('hero.h1')}</h1>
      <p class="hero__lede">{t('hero.lede')}</p>
      <div class="hero__cta">
        <a class="btn" href={localisePath(productsHref, lang)}>{t('hero.ctaProducts')}</a>
        <a class="btn btn-ghost" href={localisePath(quoteHref, lang)}>{t('hero.ctaQuote')}</a>
      </div>
      <a class="link-arrow hero__tertiary" href={localisePath(sourcingHref, lang)}>
        {t('hero.ctaSourcing')}
        <svg class="link-arrow__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M1 7.25h11.19L7.47 2.53l1.06-1.06L15.06 8l-6.53 6.53-1.06-1.06 4.72-4.72H1z" fill="currentColor" />
        </svg>
      </a>
    </div>
  </div>

  <div class="hero__foot">
    <div class="wrap hero__foot-inner">
      <p class="hero__metas">
        {
          heroSlides.map((slide, i) => (
            <span
              class:list={['hero__meta', { 'is-on': i === 0 }]}
              data-hero-meta
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              <span class="mono hero__no">{pad(i + 1)} / {pad(total)}</span>
              <span class="mono hero__cap">{pick(slide.caption, lang)}</span>
            </span>
          ))
        }
      </p>

      <a class="hero__cue" href="#after-hero">
        <span class="hero__cue-label">{t('hero.scrollCue')}</span>
        <svg class="hero__cue-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M7.25 1v11.19L2.53 7.47 1.47 8.53 8 15.06l6.53-6.53-1.06-1.06-4.72 4.72V1z" fill="currentColor" />
        </svg>
      </a>

      <div class="hero__dots" role="group" aria-label={t('hero.region')}>
        {
          heroSlides.map((_slide, i) => (
            <button
              class="hero__dot"
              type="button"
              data-hero-dot
              aria-current={i === 0 ? 'true' : 'false'}
              aria-label={t('hero.slideLabel')(i + 1, total)}
            >
              <span class="hero__dot-fill" data-hero-fill />
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>
<span class="hero-end" id="after-hero"></span>

<script>
  import '~/scripts/rolling-hero';
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--surface-primary);
    color: var(--on-dark-2);
    overflow: hidden;
    /* slide up under the transparent sticky header */
    margin-top: calc(-1 * var(--header-h));
  }

  /* -- the roll ---------------------------------------------------------- */
  .hero__roll {
    position: absolute;
    inset: 0;
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity var(--dur-cross) var(--ease);
  }
  .hero__slide.is-on {
    opacity: 1;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Right-weighted crop: the visual interest belongs centre-right. */
    object-position: 70% 50%;
    transform: scale(1);
    transition: transform var(--hero-zoom-dur) linear;
  }
  .hero__slide.is-on .hero__img {
    transform: scale(1.06);
  }

  /* With JS off no crossfade runs, so show the first frame outright. */
  .hero:not(.is-live) .hero__slide:first-child {
    opacity: 1;
  }

  /* Legibility scrim. Phone: the copy spans the full width, so the navy
     covers the lower two-thirds where the copy sits and thins toward the top.
     Desktop: navy behind the left column only, gone by 60%; a low band under
     the foot bar. The top-right of the frame is never tinted. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-navy) 94%, transparent) 0%,
      color-mix(in srgb, var(--color-navy) 78%, transparent) 55%,
      color-mix(in srgb, var(--color-navy) 30%, transparent) 100%
    );
  }
  @media (min-width: 1040px) {
    .hero::after {
      background:
        linear-gradient(
          to top,
          color-mix(in srgb, var(--color-navy) 85%, transparent) 0%,
          transparent 22%
        ),
        linear-gradient(
          90deg,
          color-mix(in srgb, var(--color-navy) 88%, transparent) 0%,
          color-mix(in srgb, var(--color-navy) 70%, transparent) 36%,
          transparent 60%
        );
    }
  }

  /* -- copy -------------------------------------------------------------- */
  .hero__body {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: calc(var(--header-h) + 48px);
  }
  .hero__copy {
    max-width: 36rem;
  }
  .hero__eyebrow {
    color: var(--color-cyan-light);
  }
  .hero__title {
    text-wrap: balance;
    margin-top: 20px;
    color: var(--text-inverse);
  }
  .hero__lede {
    margin-top: 24px;
    font-size: var(--fs-hero-lead);
    line-height: 1.55;
    color: var(--on-dark-2);
    max-width: 44ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .hero__tertiary {
    margin-top: 16px;
  }

  @media (min-width: 1040px) {
    .hero__copy {
      /* ~45% of the composition at the 1280px wrap */
      max-width: min(45%, 38rem);
      min-width: 32rem;
    }
  }

  /* -- counter, caption, cue, progress ------------------------------------ */
  .hero__foot {
    position: relative;
    z-index: 2;
    margin-top: clamp(40px, 8vh, 88px);
    border-top: 1px solid var(--rule-dark);
  }
  .hero__foot-inner {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 12px;
    padding-block: 14px;
  }

  /* All five captions share one cell and crossfade, so the bar never
     changes height as the frames advance. */
  .hero__metas {
    display: grid;
    min-width: 0;
  }
  .hero__meta {
    grid-area: 1 / 1;
    display: flex;
    align-items: baseline;
    gap: 20px;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease);
  }
  .hero__meta.is-on {
    opacity: 1;
  }
  .hero__no {
    color: var(--on-dark-4);
    white-space: nowrap;
  }
  .hero__cap {
    color: var(--on-dark-3);
    max-width: 40ch;
  }

  /* Subtle scroll cue: small label, a 16px arrow, a 3px nudge. */
  .hero__cue {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    justify-self: center;
    font-family: var(--font-stack-display);
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--on-dark-3);
    transition: color var(--dur-fast);
  }
  .hero__cue:hover {
    color: var(--text-inverse);
  }
  .hero__cue:hover .hero__cue-label {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero__cue-icon {
    width: 14px;
    height: 14px;
    animation: hero-cue 2.4s var(--ease) infinite;
  }
  @keyframes hero-cue {
    0%, 100% { transform: translateY(-1px); }
    50% { transform: translateY(2px); }
  }

  .hero__dots {
    display: flex;
    gap: 8px;
  }
  .hero__dot {
    /* The bar is 2px; the target is 44 x 32 (§13). */
    position: relative;
    width: 44px;
    height: 32px;
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
  }
  .hero__dot::before,
  .hero__dot-fill {
    position: absolute;
    top: 50%;
    left: 2px;
    width: 40px;
    height: 2px;
    margin-top: -1px;
  }
  .hero__dot::before {
    content: '';
    background: var(--on-dark-4);
    opacity: .6;
    transition: opacity var(--dur-fast);
  }
  .hero__dot:hover::before {
    opacity: 1;
  }
  .hero__dot-fill {
    display: block;
    background: var(--color-cyan);
    transform: scaleX(0);
    transform-origin: left;
  }
  .hero__dot[aria-current='true'] .hero__dot-fill {
    animation: hero-fill var(--hero-interval) linear forwards;
  }

  @keyframes hero-fill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @media (min-width: 720px) {
    .hero__foot-inner {
      grid-template-columns: 1fr auto 1fr;
      gap: 24px;
    }
    .hero__cue {
      display: inline-flex;
    }
    .hero__dots {
      justify-self: end;
    }
  }

  /* §11 — nothing advances, fills or nudges on its own; the current frame is
     simply marked. The dots still work, so all five stay reachable. */
  @media (prefers-reduced-motion: reduce) {
    .hero__dot[aria-current='true'] .hero__dot-fill {
      animation: none;
      transform: scaleX(1);
    }
    .hero__slide.is-on .hero__img {
      transform: none;
    }
    .hero__cue-icon {
      animation: none;
    }
  }

  .hero-end {
    display: block;
    height: 0;
  }
</style>
