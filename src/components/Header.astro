---
import { company } from '~/data/company';
import { homeHref, primaryNav, quoteHref } from '~/data/navigation';
import {
  alternateLinks,
  getLangFromUrl,
  languages,
  localisePath,
  useTranslations,
} from '~/i18n/ui';

/**
 * Masthead, from the approved mockup (reference/mockup.html).
 *
 * One row, solid navy, sticky:  logo slot · nav (right) · language · quote pill.
 * Below 960px the nav folds into a hamburger and a drawer under the bar.
 * A 2px cyan line along the bottom edge shows scroll progress.
 *
 * The language control is a real link to the real route in the other
 * language (§2), never a button that swaps text in place. The mockup has no
 * language control; it is added here because the site is bilingual.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string): boolean => (href.replace(/\/$/, '') || '/') === current;

// The other language, for the switch.
const other = alternateLinks(Astro.url).find((alternate) => alternate.lang !== lang);
const quote = localisePath(quoteHref, lang);
---

<header class="masthead" data-header>
  <div class="wrap mast-top">
    {/*
      ===== LOGO SLOT =====
      A fixed-height box: 34px tall, 28px on phones. Width is free.
      To use the real logo, replace the <span class="brand-mark"> below with
        <img src="/treteone-logo.svg" alt="" />   or an inline <svg>.
      The img/svg inherits the slot's height (height: 100%, width: auto), so
      the bar does not move. Keep alt="" — the link's aria-label already names
      the company. The SVG must contain real vector paths (CLAUDE.md §10).
    */}
    <a class="brand" href={localisePath(homeHref, lang)} aria-label={t('nav.home')}>
      <span class="brand-mark" aria-hidden="true">{company.tradingName}<i>.</i></span>
    </a>

    <nav class="mast-nav" aria-label={t('nav.label')}>
      {
        primaryNav.map((item) => {
          const href = localisePath(item.href, lang);
          return (
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {t(item.key)}
            </a>
          );
        })
      }
    </nav>

    {
      other && (
        <a
          class="lang"
          href={other.href}
          hreflang={other.hreflang}
          lang={other.hreflang}
          aria-label={t('lang.switchTo')(languages[other.lang].label)}
        >
          {languages[other.lang].short}
        </a>
      )
    }

    <a class="pill" href={quote} aria-current={isCurrent(quote) ? 'page' : undefined}>
      <span class="lg">{t('cta.quote')}</span><span class="sm">{t('cta.quoteShort')}</span>
      <span aria-hidden="true">→</span>
    </a>

    <button
      class="burger"
      type="button"
      aria-controls="site-drawer"
      aria-expanded="false"
      aria-label={t('nav.openMenu')}
      data-header-burger
      data-label-open={t('nav.openMenu')}
      data-label-close={t('nav.closeMenu')}
    >
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>

  <span class="scrollbar" aria-hidden="true" data-header-progress></span>

  <div class="drawer" id="site-drawer" data-header-drawer>
    <nav class="wrap" aria-label={t('nav.label')}>
      {
        primaryNav.map((item) => {
          const href = localisePath(item.href, lang);
          return (
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {t(item.key)}
            </a>
          );
        })
      }
      {
        other && (
          <a href={other.href} hreflang={other.hreflang} lang={other.hreflang}>
            {languages[other.lang].label}
          </a>
        )
      }
      <a class="cta" href={quote}>{t('cta.quote')}</a>
    </nav>
  </div>
</header>

<script>
  import '~/scripts/header';
</script>

<style>
  /* The masthead is a navy ground: it sets its own roles, so the focus ring
     inside it is cyan-light (§4, §11) without any extra class. */
  .masthead {
    --focus: var(--focus-dark);
    --fg-link: var(--text-link-dark);

    position: sticky;
    top: 0;
    z-index: 50;
    /* Notched phones: the navy runs up behind the status bar. */
    padding-top: env(safe-area-inset-top, 0px);
    background: var(--color-navy);
    color: var(--text-inverse);
  }

  .mast-top {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 34px);
    padding-block: 15px;
    transition: padding-block .22s var(--ease);
  }
  .masthead.is-stuck .mast-top {
    padding-block: 9px;
  }

  /* -- logo slot ------------------------------------------------------------ */
  .brand {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    height: var(--logo-h);
    text-decoration: none;
    color: inherit;
  }
  .brand :global(img),
  .brand :global(svg) {
    display: block;
    height: 100%;
    width: auto;
  }
  /* Text wordmark placeholder — remove when the logo artwork arrives. */
  .brand-mark {
    font-family: var(--font-stack-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .brand-mark i {
    font-style: normal;
    color: var(--color-cyan);
  }

  /* -- nav ------------------------------------------------------------------ */
  .mast-nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.9vw, 26px);
    margin-left: auto;
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: .9rem;
  }
  .mast-nav a {
    color: rgba(255, 255, 255, .78);
    text-decoration: none;
    padding-block: 4px;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color .16s;
  }
  .mast-nav a:hover {
    color: var(--text-inverse);
  }
  .mast-nav a[aria-current='page'] {
    color: var(--text-inverse);
    border-bottom-color: var(--color-cyan);
  }

  /* -- language ------------------------------------------------------------- */
  .lang {
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: .875rem;
    color: rgba(255, 255, 255, .78);
    text-decoration: none;
    white-space: nowrap;
    padding: 6px 0 6px clamp(14px, 1.9vw, 26px);
    border-left: 1px solid rgba(255, 255, 255, .2);
    transition: color .16s;
  }
  .lang:hover {
    color: var(--text-inverse);
  }

  /* -- quote pill ----------------------------------------------------------- */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: .6em;
    flex: 0 0 auto;
    min-height: 40px;
    padding: 9px 20px;
    border: 1px solid rgba(255, 255, 255, .4);
    border-radius: var(--radius-pill);
    font-family: var(--font-stack-display);
    font-weight: 600;
    font-size: .875rem;
    color: var(--text-inverse);
    text-decoration: none;
    transition: background .15s, color .15s, border-color .15s;
  }
  .pill:hover,
  .pill[aria-current='page'] {
    background: var(--color-cyan);
    border-color: var(--color-cyan);
    color: var(--color-navy);
  }
  .pill .sm {
    display: none;
  }

  /* -- hamburger ------------------------------------------------------------ */
  .burger {
    display: none;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    /* 44px target — the phone is the primary visitor (§13). */
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 1px solid rgba(255, 255, 255, .32);
    border-radius: var(--radius);
    color: var(--text-inverse);
    cursor: pointer;
    transition: border-color .16s, background .16s;
  }
  .burger:hover {
    border-color: var(--text-inverse);
  }
  .bars {
    position: relative;
    display: block;
    width: 20px;
    height: 14px;
  }
  .bars i {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: currentColor;
    transition: transform .26s ease, opacity .16s ease, top .26s ease;
  }
  .bars i:nth-child(1) { top: 0; }
  .bars i:nth-child(2) { top: 6px; }
  .bars i:nth-child(3) { top: 12px; }
  .burger[aria-expanded='true'] {
    background: rgba(255, 255, 255, .08);
  }
  .burger[aria-expanded='true'] .bars i:nth-child(1) { top: 6px; transform: rotate(45deg); }
  .burger[aria-expanded='true'] .bars i:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] .bars i:nth-child(3) { top: 6px; transform: rotate(-45deg); }

  /* -- scroll progress ------------------------------------------------------ */
  .scrollbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-cyan);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }

  /* -- drawer --------------------------------------------------------------- */
  .drawer {
    display: none;
    background: var(--color-navy-2);
  }
  .drawer.is-open {
    display: block;
    animation: drawer-in .22s ease both;
  }
  @keyframes drawer-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }
  .drawer a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, .13);
    color: var(--text-inverse);
    text-decoration: none;
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: 1.0625rem;
  }
  .drawer a::after {
    content: '→';
    color: var(--color-cyan);
    font-size: .9rem;
  }
  .drawer a[aria-current='page'] {
    color: var(--color-cyan-light);
  }
  .drawer .cta {
    justify-content: center;
    gap: .5em;
    margin: 18px 0 22px;
    padding: 14px;
    border-bottom: 0;
    border-radius: var(--radius-pill);
    background: var(--color-cyan);
    color: var(--color-navy);
    font-weight: 600;
    font-size: 1rem;
  }
  .drawer .cta::after {
    color: var(--color-navy);
  }

  /* -- breakpoints (mockup order: 960, then 700) ---------------------------- */
  @media (max-width: 960px) {
    .mast-top { gap: 12px; }
    .mast-nav { display: none; }
    .lang { margin-left: auto; padding-left: 0; border-left: 0; }
    .pill { padding: 9px 16px; font-size: .84rem; }
    .pill .lg { display: none; }
    .pill .sm { display: inline; }
    .burger { display: inline-flex; }
  }

  @media (max-width: 700px) {
    .brand { height: var(--logo-h-sm); }
    .brand-mark { font-size: 1.15rem; letter-spacing: .08em; }
  }

  /* Phones: the bar holds logo, pill and burger only; the language link
     moves into the drawer, which always carries it. */
  @media (max-width: 560px) {
    .lang { display: none; }
    .pill { margin-left: auto; }
  }

  @media (min-width: 961px) {
    /* The drawer is a mobile affordance. If the window widens while it is
       open, hide it rather than leave it stuck under a full nav. */
    .drawer.is-open { display: none; }
  }
</style>
