---
import { company } from '~/data/company';
import { homeHref, primaryNav, quoteHref } from '~/data/navigation';
import {
  alternateLinks,
  getLangFromUrl,
  languages,
  localisePath,
  useTranslations,
} from '~/i18n/ui';

/**
 * Sticky header. Semi-transparent navy over the hero, solid white after it
 * (locked visual system §17). Mobile drawer below 1040px — five 20px links,
 * the language switch and the CTA do not fit a tablet bar.
 *
 * The language control is two real links to two real routes (§2), not a
 * button that swaps text in place.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternates = alternateLinks(Astro.url);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

// The wordmark is the trading name, uppercased in CSS, with a cyan interpunct.
const [markLead = '', markTail = ''] = company.tradingName.split(' ');
---

<header class="site-header" data-header>
  <div class="wrap site-header__bar">
    <a class="mark" href={localisePath(homeHref, lang)} aria-label={t('nav.home')}>
      <span>{markLead}</span><span class="mark__dot" aria-hidden="true">·</span><span>{markTail}</span>
    </a>

    <nav
      class="site-nav"
      id="site-nav"
      aria-label={t('nav.label')}
      data-header-nav
    >
      <ul class="site-nav__list">
        {
          primaryNav.map((item) => {
            const href = localisePath(item.href, lang);
            return (
              <li>
                <a
                  class="site-nav__link"
                  href={href}
                  aria-current={href.replace(/\/$/, '') === current ? 'page' : undefined}
                >
                  {t(item.key)}
                </a>
              </li>
            );
          })
        }
      </ul>

      <!-- On a phone the toolbar CTA is hidden, so the drawer carries its own.
           The quote form is the only conversion point (§8). -->
      <a class="btn site-header__btn site-nav__cta" href={localisePath(quoteHref, lang)}>
        {t('cta.quote')}
      </a>
    </nav>

    <div class="site-header__tools">
      <div class="lang-switch" role="group" aria-label={t('lang.label')}>
        {
          alternates.map(({ lang: code, hreflang, href }) => (
            <a
              class="lang-switch__option"
              href={href}
              hreflang={hreflang}
              lang={hreflang}
              aria-current={code === lang ? 'true' : undefined}
              aria-label={code === lang ? undefined : t('lang.switchTo')(languages[code].label)}
            >
              {languages[code].short}
            </a>
          ))
        }
      </div>

      <a class="btn site-header__btn site-header__cta" href={localisePath(quoteHref, lang)}>
        {t('cta.quote')}
      </a>

      <button
        class="burger"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label={t('nav.openMenu')}
        data-header-burger
        data-label-open={t('nav.openMenu')}
        data-label-close={t('nav.closeMenu')}
      >
        <svg class="burger__icon" viewBox="0 0 22 16" aria-hidden="true" focusable="false">
          <rect class="burger__bar burger__bar--top" x="0" y="1" width="22" height="2" rx="1" />
          <rect class="burger__bar burger__bar--mid" x="0" y="7" width="22" height="2" rx="1" />
          <rect class="burger__bar burger__bar--bot" x="0" y="13" width="22" height="2" rx="1" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  import '~/scripts/header';
</script>

<style>
  /* -- solid white: the default, and every state after the hero ---------- */
  .site-header {
    --rule-current: var(--rule-light);
    --fg-strong: var(--color-navy);
    --fg-muted: var(--text-body);
    --focus: var(--focus-light);

    position: sticky;
    top: 0;
    z-index: 80;
    background: var(--surface-page);
    border-bottom: 1px solid var(--rule-current);
    color: var(--fg-strong);
    transition:
      background var(--dur),
      border-color var(--dur),
      box-shadow var(--dur),
      color var(--dur);
  }
  .site-header.is-past,
  .site-header:where(:not(:has(~ main [data-header-dark-zone]))) {
    box-shadow: var(--shadow-raised);
  }

  /* -- over the hero: semi-transparent navy, modest blur -----------------
     The :has() arm makes a hero page start dark, before the script runs and
     with JS off, so the bar never flashes white over the photograph. The
     script adds .is-past once the hero has scrolled away. */
  .site-header.is-on-dark,
  .site-header:where(:not(.is-past):has(~ main [data-header-dark-zone])) {
    --rule-current: var(--rule-dark);
    --fg-strong: var(--text-inverse);
    --fg-muted: var(--on-dark-2);
    --focus: var(--focus-dark);

    background: color-mix(in srgb, var(--color-navy) 55%, transparent);
    backdrop-filter: blur(6px);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--header-h);
  }

  /* -- wordmark ---------------------------------------------------------- */
  .mark {
    font-family: var(--font-stack-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: inherit;
    padding-block: 8px;
  }
  .mark__dot {
    color: var(--accent-electric);
  }

  /* -- navigation (§5: General Sans 500, --fs-nav) ----------------------- */
  .site-nav {
    display: none;
    margin-left: auto;
  }
  .site-nav__list {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-stack-display);
    font-size: var(--fs-nav);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    color: var(--fg-muted);
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }
  .site-nav__link:hover,
  .site-nav__link[aria-current='page'] {
    color: var(--fg-strong);
    border-bottom-color: var(--accent-electric);
  }
  .site-nav__cta {
    display: none;
  }

  /* -- tools ------------------------------------------------------------- */
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
  }

  .lang-switch {
    display: flex;
    border: 1px solid var(--rule-current);
    border-radius: var(--radius);
    overflow: hidden;
    font-family: var(--font-stack-display);
    font-size: .875rem;
    font-weight: 500;
  }
  .lang-switch__option {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    white-space: nowrap;
    text-decoration: none;
    color: var(--fg-muted);
    transition: background var(--dur-fast), color var(--dur-fast);
  }
  .lang-switch__option:hover {
    color: var(--fg-strong);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .lang-switch__option[aria-current='true'] {
    background: var(--color-navy);
    color: var(--text-inverse);
  }
  .is-on-dark .lang-switch__option[aria-current='true'],
  .site-header:where(:not(.is-past):has(~ main [data-header-dark-zone])) .lang-switch__option[aria-current='true'] {
    background: var(--text-inverse);
    color: var(--color-navy);
  }

  /* §16 — the header CTA is cyan with navy text in both states. Restrained
     hover: a lighter fill and a navy shadow, no glow. */
  .site-header__btn {
    background: var(--color-cyan);
    border-color: var(--color-cyan);
    color: var(--color-navy);
    min-height: 44px;
    padding: 10px 20px;
    font-size: .9375rem;
    white-space: nowrap;
  }
  .site-header__btn:hover {
    background: var(--color-cyan-light);
    border-color: var(--color-cyan-light);
  }
  .site-header__cta {
    display: none;
  }

  /* -- burger ------------------------------------------------------------ */
  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule-current);
    background: none;
    border-radius: var(--radius);
    /* 44px target — the phone is the primary visitor (§13). */
    width: 44px;
    height: 44px;
    padding: 0;
    cursor: pointer;
    color: inherit;
  }
  .burger__icon {
    width: 22px;
    height: 16px;
    display: block;
  }
  .burger__bar {
    fill: currentColor;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform var(--dur-fast), opacity var(--dur-fast);
  }
  .is-open .burger__bar--top {
    transform: translateY(6px) rotate(45deg);
  }
  .is-open .burger__bar--mid {
    opacity: 0;
  }
  .is-open .burger__bar--bot {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* -- drawer, below desktop --------------------------------------------- */
  @media (max-width: 1039px) {
    /* An open drawer is always solid navy, whatever is behind the bar, so
       the links never sit on a photograph. */
    .site-header.is-open {
      --rule-current: var(--rule-dark);
      --fg-strong: var(--text-inverse);
      --fg-muted: var(--on-dark-2);
      --focus: var(--focus-dark);
      background: var(--surface-primary);
      box-shadow: none;
    }
    .site-header.is-open .lang-switch__option[aria-current='true'] {
      background: var(--text-inverse);
      color: var(--color-navy);
    }

    .site-nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      background: var(--surface-primary);
      border-top: 1px solid var(--rule-dark);
      box-shadow: var(--shadow-modal);
      padding: 8px var(--wrap-pad-sm) 24px;
      margin-left: 0;
    }
    .is-open .site-nav {
      display: block;
    }
    .site-nav__list {
      flex-direction: column;
      gap: 0;
    }
    .site-nav__link {
      display: flex;
      min-height: 56px;
      border-bottom: 1px solid var(--rule-dark);
      color: var(--text-inverse);
    }
    .site-nav__link:hover,
    .site-nav__link[aria-current='page'] {
      border-bottom-color: var(--color-cyan-light);
    }
    .site-nav__cta {
      display: flex;
      width: 100%;
      margin-top: 20px;
    }
  }

  @media (min-width: 720px) and (max-width: 1039px) {
    .site-nav {
      padding-inline: var(--wrap-pad);
    }
  }

  @media (min-width: 1040px) {
    .site-nav {
      display: flex;
      align-items: center;
    }
    /* 1040px leaves ~985px of bar: tighten until the wrap has room. */
    .site-header__bar {
      gap: 24px;
    }
    .site-nav__list {
      gap: 20px;
    }
    .site-header__tools {
      margin-left: 0;
    }
    .site-header__cta {
      display: inline-flex;
    }
    .burger {
      display: none;
    }
  }

  @media (min-width: 1280px) {
    .site-header__bar {
      gap: 32px;
    }
    .site-nav__list {
      gap: 28px;
    }
  }
</style>
