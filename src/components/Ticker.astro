---
import { categories } from '~/data/categories';
import { getLangFromUrl, pick, useTranslations } from '~/i18n/ui';

/**
 * CLAUDE.md §6.3 — amber strip, category names, pauses on hover, `aria-hidden`.
 *
 * No script. Hover-pause and the reduced-motion freeze are both CSS, so this
 * section ships zero bytes of JavaScript.
 *
 * It is `aria-hidden` because it says nothing the page does not already say —
 * the same twelve names are in the rail below and in the footer. A screen
 * reader would just read the list twice, and a marquee is a poor way to hear it.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = [
  ...categories.map((category) => pick(category.name, lang)),
  t('ticker.hardToFind'),
  t('ticker.obsolete'),
  t('ticker.globalSourcing'),
];

// The track holds the list twice. The animation travels exactly one copy's
// width (-50%) and loops, so the seam is never visible.
const track = [...items, ...items];
---

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {track.map((item) => <span class="ticker__item">{item}</span>)}
  </div>
</div>

<style>
  .ticker {
    background: var(--signal);
    color: var(--ink);
    overflow: hidden;
    padding-block: 11px;
    white-space: nowrap;
  }

  .ticker__track {
    display: inline-flex;
    animation: ticker-slide 42s linear infinite;
    will-change: transform;
  }

  /* §6.3 — pausing on hover lets someone actually read a name they caught. */
  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  .ticker__item {
    font-family: var(--font-stack-display);
    font-weight: 600;
    font-size: .95rem;
    letter-spacing: .02em;
    padding-inline: 26px;
    position: relative;
  }

  .ticker__item::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 4px;
    height: 4px;
    background: var(--ink);
    border-radius: 50%;
    transform: translateY(-50%);
  }

  @keyframes ticker-slide {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* §9 — reduced motion freezes the ticker. The global rule collapses the
     animation's duration, which would leave the track parked at -50%; pinning
     it back to the start keeps the first names readable instead. */
  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
      transform: none;
    }
  }
</style>
