---
import { Picture } from 'astro:assets';
import { categories } from '~/data/categories';
import { categoryHref, productsHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, pick, useTranslations } from '~/i18n/ui';

/**
 * §7.3 — the product ecosystem. Entry to /products.
 *
 * Large typography, not SaaS cards:
 *
 *   01
 *   AUTOMATION & CONTROL
 *   PLC · DCS · SCADA · HMI · DRIVES
 *   EXPLORE →
 *
 * Twelve full-width rows, each ONE link to that category's entry on /products.
 * On desktop a sticky equipment photograph beside the list follows whichever
 * row is hovered or focused; that is an enhancement layered on a list that is
 * already complete. On a phone (§13, the primary visitor) each row carries its
 * own small photograph instead, and nothing depends on hover.
 *
 * Images: the desktop panel is display:none below 1040px and every image in it
 * is lazy, so a phone never fetches it. The row thumbnails are display:none
 * from 1040px up, so a desktop never fetches those.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pad = (n: number): string => String(n).padStart(2, '0');
const total = categories.length;
---

<section class="eco" aria-labelledby="eco-title" data-eco>
  <div class="wrap">
    <div class="eco__head rv">
      <div>
        <p class="eyebrow">{t('home.eco.eyebrow')}</p>
        <h2 class="eco__title" id="eco-title">{t('home.eco.heading')}</h2>
      </div>
      <a class="link-arrow eco__all" href={localisePath(productsHref, lang)}>
        {t('home.eco.all')}
        <svg class="link-arrow__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M1 7.25h11.19L7.47 2.53l1.06-1.06L15.06 8l-6.53 6.53-1.06-1.06 4.72-4.72H1z" fill="currentColor" />
        </svg>
      </a>
    </div>

    <div class="eco__grid">
      <div class="eco__media" aria-hidden="true">
        <div class="eco__frame">
          {
            categories.map((category, i) => (
              <figure class:list={['eco__figure', { 'is-on': i === 0 }]} data-eco-figure>
                <Picture
                  src={category.image}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1280px) 480px, 38vw"
                  alt=""
                  class="eco__img"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))
          }
        </div>
        <div class="eco__caption">
          {
            categories.map((category, i) => (
              <p class:list={['mono', 'eco__cap', { 'is-on': i === 0 }]} data-eco-cap>
                {pad(i + 1)} / {pad(total)} — {pick(category.name, lang)}
              </p>
            ))
          }
        </div>
      </div>

      <ol class="eco__list">
        {
          categories.map((category, i) => (
            <li class="eco__row">
              <a
                class:list={['eco__item', { 'is-on': i === 0 }]}
                href={localisePath(categoryHref(category.slug), lang)}
                aria-label={t('home.eco.linkLabel')(pick(category.name, lang))}
                aria-describedby={`eco-tags-${category.slug}`}
                data-eco-item
                data-index={i}
              >
                <span class="mono eco__no" aria-hidden="true">{pad(i + 1)}</span>
                <span class="eco__text">
                  <span class="eco__name">{pick(category.name, lang)}</span>
                  <span class="mono eco__tags" id={`eco-tags-${category.slug}`}>
                    {pick(category.blurb, lang)}
                  </span>
                  <span class="eco__go" aria-hidden="true">
                    {t('home.eco.explore')}
                    <svg class="eco__arrow" viewBox="0 0 16 16" focusable="false">
                      <path d="M1 7.25h11.19L7.47 2.53l1.06-1.06L15.06 8l-6.53 6.53-1.06-1.06 4.72-4.72H1z" fill="currentColor" />
                    </svg>
                  </span>
                </span>
                <span class="eco__thumb" aria-hidden="true">
                  <Picture
                    src={category.image}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpg"
                    widths={[120, 240]}
                    sizes="96px"
                    alt=""
                    class="eco__thumb-img"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import '~/scripts/product-ecosystem';
</script>

<style>
  .eco {
    padding-block: var(--section-y);
    background: var(--surface-card);
    border-block: 1px solid var(--rule-light);
  }

  .eco__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .eco__title {
    margin-top: 12px;
    max-width: 18ch;
  }

  .eco__grid {
    display: grid;
    gap: 48px;
  }

  /* -- desktop media panel ----------------------------------------------- */
  .eco__media {
    display: none;
  }

  /* -- rows -------------------------------------------------------------- */
  .eco__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule-light);
    counter-reset: none;
  }

  .eco__item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: start;
    padding: 24px 0;
    border-top: 1px solid var(--rule-light);
    text-decoration: none;
    color: var(--text-primary);
  }
  /* A navy bar grows on the active row: the state is shape as well as colour. */
  .eco__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: 100%;
    height: 2px;
    background: var(--color-navy);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .eco__item:hover::before,
  .eco__item:focus-visible::before {
    transform: scaleX(1);
  }
  .eco__item:focus-visible {
    outline-offset: 4px;
  }

  .eco__no {
    padding-top: .45em;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .eco__text {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .eco__name {
    font-family: var(--font-stack-display);
    font-size: clamp(1.375rem, 1rem + 1.6vw, var(--fs-h2));
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: var(--tracking-h23);
    text-transform: uppercase;
    text-wrap: balance;
  }
  :global(html[lang^='zh']) .eco__name {
    letter-spacing: 0;
    line-height: 1.3;
  }

  .eco__tags {
    font-size: var(--fs-small);
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  :global(html[lang^='zh']) .eco__tags {
    text-transform: none;
  }

  .eco__go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-family: var(--font-stack-display);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-link-light);
  }
  .eco__arrow {
    width: 14px;
    height: 14px;
    transition: transform var(--dur-fast);
  }
  .eco__item:hover .eco__go,
  .eco__item:focus-visible .eco__go {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .eco__item:hover .eco__arrow,
  .eco__item:focus-visible .eco__arrow {
    transform: translateX(4px);
  }

  .eco__thumb {
    width: 96px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-card-tinted);
  }
  .eco__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 720px) {
    .eco__item {
      grid-template-columns: 64px 1fr auto;
      gap: 24px;
      padding: 28px 0;
    }
    .eco__thumb {
      width: 144px;
    }
  }

  @media (min-width: 1040px) {
    .eco__grid {
      grid-template-columns: 5fr 7fr;
      gap: clamp(48px, 6vw, 96px);
      align-items: start;
    }

    .eco__media {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
    .eco__frame {
      position: relative;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: var(--color-navy);
    }
    .eco__figure {
      position: absolute;
      inset: 0;
      margin: 0;
      opacity: 0;
      transition: opacity var(--dur-slow) var(--ease);
    }
    .eco__figure.is-on {
      opacity: 1;
    }
    .eco__figure :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .eco__caption {
      display: grid;
      margin-top: 16px;
    }
    .eco__cap {
      grid-area: 1 / 1;
      font-size: var(--fs-small);
      text-transform: uppercase;
      color: var(--text-muted);
      opacity: 0;
      transition: opacity var(--dur) var(--ease);
    }
    .eco__cap.is-on {
      opacity: 1;
    }
    :global(html[lang^='zh']) .eco__cap {
      text-transform: none;
    }

    .eco__item {
      grid-template-columns: 64px 1fr;
    }
    .eco__thumb {
      display: none;
    }
    /* The row that drives the photograph is marked, so the link between the
       two is visible and not only implied. */
    .eco__item.is-on::before {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eco__item::before,
    .eco__arrow,
    .eco__figure,
    .eco__cap {
      transition: none;
    }
  }
</style>
