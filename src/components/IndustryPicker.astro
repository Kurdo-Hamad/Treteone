---
import { Picture } from 'astro:assets';
import { industries } from '~/data/industries';
import { getLangFromUrl, pick, useTranslations } from '~/i18n/ui';

/**
 * CLAUDE.md §6.7 — 9 names, photo panel swaps on hover, click and keyboard
 * focus. Real `tablist` semantics.
 *
 * "Real" means nine tabs each owning a real panel by id, a roving tabindex so
 * the whole control is one Tab stop, and `hidden` on the eight unselected
 * panels so they are out of the accessibility tree and out of the tab order.
 * The behaviour lives in src/scripts/industry-picker.ts.
 *
 * The prototype crossfades the photo. Panels here swap instantly instead,
 * because `hidden` is what makes the semantics honest and it cannot be
 * crossfaded. It also means the eight unshown photographs are never fetched
 * until they are asked for — see the README.
 *
 * With no script the first tab and panel are already marked selected in the
 * HTML, so one industry reads correctly; there is simply no switching.
 *
 * ⚠ §10 — the nine photographs are "PHOTOGRAPH PENDING" plates.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="industries" id="industries">
  <div class="wrap">
    <div class="industries__head rv">
      <h2>{t('industries.heading')}</h2>
      <p class="lede">{t('industries.lede')}</p>
    </div>

    <div class="industries__grid">
      <div
        class="industries__list"
        role="tablist"
        aria-orientation="vertical"
        aria-label={t('industries.listLabel')}
        data-industry-tablist
      >
        {
          industries.map((industry, i) => (
            <button
              class="industry-tab"
              type="button"
              role="tab"
              id={`industry-tab-${industry.slug}`}
              aria-controls={`industry-panel-${industry.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-industry-tab
            >
              <span class="industry-tab__dash" aria-hidden="true" />
              <span class="industry-tab__name">{pick(industry.name, lang)}</span>
            </button>
          ))
        }
      </div>

      <div class="industries__panels">
        {
          industries.map((industry, i) => (
            <div
              class="industry-panel"
              role="tabpanel"
              id={`industry-panel-${industry.slug}`}
              aria-labelledby={`industry-tab-${industry.slug}`}
              tabindex="0"
              hidden={i !== 0}
              data-industry-panel
            >
              <Picture
                src={industry.image}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[520, 900, 1400]}
                sizes="(min-width: 1040px) 55vw, 100vw"
                alt=""
                class="industry-panel__img"
                loading="lazy"
                decoding="async"
              />
              <div class="industry-panel__copy">
                <b class="industry-panel__name">{pick(industry.name, lang)}</b>
                <small class="industry-panel__blurb">{pick(industry.blurb, lang)}</small>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import '~/scripts/industry-picker';
</script>

<style>
  .industries {
    padding-block: var(--section-y);
  }

  .industries__head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 44px;
  }
  .industries__head .lede {
    max-width: 44ch;
  }

  .industries__grid {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--rule);
    background: var(--white);
  }

  /* -- tabs -------------------------------------------------------------- */

  .industries__list {
    border-bottom: 1px solid var(--rule);
  }

  .industry-tab {
    width: 100%;
    text-align: start;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule);
    padding: 20px 26px;
    cursor: pointer;
    font-family: var(--font-stack-display);
    font-size: clamp(1.1rem, 1.7vw, 1.5rem);
    font-weight: 500;
    letter-spacing: var(--meso-ls-h2);
    color: var(--steel);
    display: flex;
    align-items: center;
    gap: 16px;
    transition: color var(--dur-fast), background var(--dur-fast);
  }
  .industry-tab:last-child {
    border-bottom: 0;
  }
  .industry-tab:hover {
    color: var(--ink);
  }
  .industry-tab[aria-selected='true'] {
    color: var(--ink);
    background: var(--paper);
  }

  .industry-tab__dash {
    flex: 0 0 auto;
    width: 0;
    height: 2px;
    background: var(--signal);
    transition: width var(--dur);
  }
  .industry-tab[aria-selected='true'] .industry-tab__dash {
    width: 28px;
  }

  /* §9 — the focus ring sits inside the tab, because the tab is flush against
     its neighbours and an outset ring would be clipped by the panel edge. */
  .industry-tab:focus-visible {
    outline-offset: calc(-1 * var(--focus-width));
  }

  /* -- panels ------------------------------------------------------------ */

  .industries__panels {
    position: relative;
    background: var(--ink);
  }

  /* `hidden` must win. Only the selected panel is laid out at all. */
  .industry-panel {
    display: none;
  }
  .industry-panel:not([hidden]) {
    display: block;
    position: relative;
    min-height: 320px;
    height: 100%;
    overflow: hidden;
  }

  .industry-panel__img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
    filter: grayscale(.35) brightness(.72);
  }

  .industry-panel__copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 28px;
    color: var(--white);
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--ink-3) 90%, transparent),
      transparent
    );
  }
  .industry-panel__name {
    display: block;
    font-family: var(--font-stack-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: var(--meso-ls-h2);
  }
  .industry-panel__blurb {
    display: block;
    color: var(--on-dark-2);
    font-size: .9rem;
    margin-top: 8px;
  }

  /* §9 — the panel is a focus target for keyboard users, and the tab dash is a
     state indicator rather than an animation. Nothing moves. */
  @media (prefers-reduced-motion: reduce) {
    .industry-tab,
    .industry-tab__dash {
      transition: none;
    }
  }

  @media (min-width: 720px) {
    .industries__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  @media (min-width: 1040px) {
    .industries__grid {
      grid-template-columns: .9fr 1.1fr;
    }
    .industries__list {
      border-bottom: 0;
      border-inline-end: 1px solid var(--rule);
    }
    .industry-panel:not([hidden]),
    .industry-panel__img {
      min-height: 460px;
    }
    .industry-panel__copy {
      padding: 36px;
    }
  }
</style>
