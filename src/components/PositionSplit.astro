---
import Icon from '~/components/Icon.astro';
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import { standIn } from '~/data/standIns';
import { aboutHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * §7.3 Positioning split — a large photograph, the argument alongside.
 * Stacks below 960px. The cyan offset block that sat behind the photograph
 * went in the Nov 2026 refinement (a template move); the photograph keeps
 * its slow scroll drift.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section aria-labelledby="position-title">
  <div class="wrap sec">
    <div class="split">
      <div class="split__media">
        <div class="split__front">
          <ImagePlaceholder
            subject={t('home.position.subject')}
            variant="wide"
            image={standIn('home.position.subject')}
          />
        </div>
      </div>
      <div>
        <h2 id="position-title">{t('home.position.heading')}</h2>
        <p class="lead split__p1">{t('home.position.lead1')}</p>
        <p class="lead split__p2">{t('home.position.lead2')}</p>
        <p class="split__more">
          <a class="rm" href={localisePath(aboutHref, lang)}>
            {t('home.position.more')} <Icon name="arrow-right" />
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    gap: clamp(26px, 4vw, 60px);
    align-items: center;
  }

  .split__media {
    position: relative;
    overflow: clip;
  }
  .split__front :global(.ph) {
    aspect-ratio: 5 / 4;
  }

  /* Depth: as the section crosses the screen the photograph drifts inside
     its frame, a little slower than the page. Scroll-driven, no script;
     without support (or with reduced motion) it stays still. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .split__front :global(.ph__img) {
        animation: split-drift linear both;
      }
      /* Timeline in its own, more specific rule: the minifier otherwise
         folds it into the animation shorthand, which browsers reject. */
      .split__media .split__front :global(.ph__img) {
        animation-timeline: view();
        animation-range: cover;
      }
      @keyframes split-drift {
        from { transform: translateY(-4%) scale(1.1); }
        to { transform: translateY(4%) scale(1.1); }
      }
    }
  }

  .split__p1 {
    margin-top: 18px;
  }
  .split__p2 {
    margin-top: 14px;
  }
  .split__more {
    margin-top: 22px;
  }

  @media (max-width: 60rem) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
