---
import Icon from '~/components/Icon.astro';
import { brandTile } from '~/data/brand-logos';
import { brandDirectory, brandGroupCounts, brandGroups } from '~/data/brands';
import { quoteHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * /brands — one filterable directory (approved mockup, #v-brands; CLAUDE.md §9).
 *
 *  - Every tile is rendered here, in HTML. src/scripts/brand-filter.ts only
 *    sets `hidden`, so with JavaScript off the full list is on the page. The
 *    chips and the search box ship `disabled` and the script enables them:
 *    without it they would sit there doing nothing.
 *  - Four chips (All + three disciplines) with counts taken from the data, and
 *    a search box that filters on the name.
 *  - No match shows the "Not on the list" panel with a link to the form —
 *    never an empty grid.
 *  - The count line is a polite live region, so a filter change is announced.
 *  - The directory is a typeset index: each entry is the manufacturer's name
 *    with its discipline under it, on a hairline. Empty logo boxes read as
 *    "missing artwork" (Nov 2026 review), so there are none. When a logo file
 *    exists in public/logos/ (resolved at build time by
 *    src/data/brand-logos.ts, which also refuses a raster in an SVG wrapper)
 *    it shows above the name. No <img onerror> — the CSP forbids inline
 *    handlers.
 *
 * ⚠ §13 — "Brands we source". Nothing here may imply authorisation,
 * distributorship or agency. (The trademark note was removed at the client's
 * request, Nov 2026; see CLAUDE.md §9.)
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const total = brandDirectory.length;
const tiles = brandDirectory.map((brand) => ({ ...brandTile(brand.name), group: brand.group }));

const chips = [
  { filter: 'all', label: t('brands.group.all'), count: total },
  ...brandGroups.map((group) => ({
    filter: group,
    label: t(`brands.group.${group}`),
    count: brandGroupCounts[group],
  })),
];

// The script fills {shown}; the total is fixed at build.
const SENTINEL = 987654;
const msgShowing = t('brands.showing')(SENTINEL, total).replace(String(SENTINEL), '{shown}');
const msgAll = t('brands.showingAll')(total);

/** Lower-cased name, as the script compares it. */
const searchKey = (name: string): string => name.toLowerCase();
---

<div class="bdir" data-brand-filter data-msg-all={msgAll} data-msg-showing={msgShowing}>
  <div class="bfilter">
    <div class="bsearch">
      <label class="sr-only" for="brand-search">{t('brands.search.label')}</label>
      <svg viewBox="0 0 24 24" stroke-linecap="round" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M16.5 16.5L21 21"></path>
      </svg>
      <input
        id="brand-search"
        type="search"
        placeholder={t('brands.search.label')}
        autocomplete="off"
        spellcheck="false"
        aria-controls="brand-grid"
        disabled
        data-brand-search
      />
    </div>
    <div class="chips" role="group" aria-label={t('brands.filter.label')}>
      {
        chips.map((chip) => (
          <button
            class="chip"
            type="button"
            aria-pressed={chip.filter === 'all' ? 'true' : 'false'}
            aria-controls="brand-grid"
            disabled
            data-brand-chip={chip.filter}
          >
            {chip.label} <b>{chip.count}</b>
          </button>
        ))
      }
    </div>
  </div>

  <p class="bcount" aria-live="polite" data-brand-count>{msgAll}</p>

  <ul class="bgrid" id="brand-grid" aria-label={t('brands.heading')} data-brand-grid>
    {
      tiles.map((tile) => (
        <li class="btile" data-g={tile.group} data-n={searchKey(tile.name)}>
          {tile.logo && <img class="btile__logo" src={tile.logo} alt="" loading="lazy" decoding="async" />}
          <span class="btile__name">{tile.name}</span>
          <span class="btile__group">{t(`brands.group.${tile.group}`)}</span>
        </li>
      ))
    }
  </ul>

  <div class="bnone" hidden data-brand-none>
    <h2 class="bnone__title">{t('brands.none.title')}</h2>
    <p>{t('brands.none.body')}</p>
    <p class="bnone__link">
      <a class="rm" href={localisePath(quoteHref, lang)}>
        {t('brands.none.link')} <Icon name="arrow-right" />
      </a>
    </p>
  </div>
</div>

<script>
  import '~/scripts/brand-filter';
</script>

<style>
  /* -- filter bar ---------------------------------------------------------- */
  .bfilter {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 18px;
    align-items: center;
    margin-top: 30px;
  }

  .bsearch {
    position: relative;
    flex: 0 0 clamp(200px, 28vw, 280px);
  }
  .bsearch input {
    width: 100%;
    min-height: 44px;
    padding: 11px 14px 11px 38px;
    /* A form control's boundary needs 3:1 (WCAG 1.4.11). */
    border: 1px solid var(--border-control);
    border-radius: var(--radius);
    background: var(--surface-page);
    color: var(--text-primary);
    font-family: var(--font-stack-body);
    /* 16px or more stops iOS zooming the page on focus. */
    font-size: var(--fs-body);
    -webkit-appearance: none;
    appearance: none;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .bsearch input::placeholder {
    color: var(--text-quiet);
  }
  .bsearch input:focus {
    border-color: var(--color-navy);
    box-shadow: inset 0 -2px 0 var(--color-navy);
  }
  .bsearch input:disabled {
    cursor: default;
  }
  .bsearch svg {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--text-quiet);
    stroke-width: 1.6;
    pointer-events: none;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: .45em;
    min-height: 44px;
    padding: 9px 14px;
    border: 1px solid var(--border-control);
    border-radius: var(--radius);
    background: var(--surface-page);
    color: var(--text-body-2);
    font-family: var(--font-stack-display);
    font-weight: 500;
    font-size: var(--fs-small);
    line-height: 1.2;
    cursor: pointer;
    transition:
      background var(--dur-fast),
      border-color var(--dur-fast),
      color var(--dur-fast);
  }
  .chip:hover:not(:disabled) {
    border-color: var(--color-navy);
    color: var(--color-navy);
  }
  .chip:active:not(:disabled) {
    scale: .97;
  }
  .chip:disabled {
    cursor: default;
  }
  .chip b {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--text-quiet);
  }
  /* Pressed is a filled chip, not a hue change alone (§11). */
  .chip[aria-pressed='true'] {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--text-inverse);
  }
  .chip[aria-pressed='true'] b {
    color: var(--color-cyan-light);
  }

  .bcount {
    margin-top: 22px;
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
    color: var(--text-quiet);
  }

  /* -- index ----------------------------------------------------------------
     Four columns of names, each on a hairline: a typeset list, not a wall of
     logo boxes. */
  .bgrid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: clamp(20px, 3vw, 40px);
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .bgrid[hidden],
  .btile[hidden] {
    display: none;
  }

  .btile {
    min-width: 0;
    overflow-wrap: break-word;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 0 20px;
    border-bottom: 1px solid var(--line);
  }
  /* After a chip is chosen (brand-filter.ts adds .is-dealt) the visible
     entries fade up in sequence. Never on first load. */
  .bgrid.is-dealt .btile {
    animation: tile-deal .45s var(--ease-out-expo) backwards;
  }
  .bgrid.is-dealt .btile:nth-child(4n + 2) { animation-delay: 30ms; }
  .bgrid.is-dealt .btile:nth-child(4n + 3) { animation-delay: 60ms; }
  .bgrid.is-dealt .btile:nth-child(4n + 4) { animation-delay: 90ms; }
  @keyframes tile-deal {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  .btile__name {
    font-family: var(--font-stack-display);
    font-weight: var(--weight-heading);
    font-size: var(--fs-lead);
    line-height: 1.25;
    letter-spacing: -.01em;
    color: var(--color-navy);
  }
  .btile__group {
    font-size: var(--fs-caption);
    line-height: 1.4;
    color: var(--text-quiet);
  }
  /* §9 — logos greyscale, full colour on hover. */
  .btile__logo {
    display: block;
    height: 28px;
    width: auto;
    max-width: 70%;
    margin-bottom: 8px;
    object-fit: contain;
    object-position: left center;
    filter: grayscale(1);
    opacity: .8;
    transition: filter var(--dur-fast), opacity var(--dur-fast);
  }
  @media (hover: hover) {
    .btile:hover .btile__logo {
      filter: none;
      opacity: 1;
    }
  }

  /* -- no match ------------------------------------------------------------ */
  .bnone {
    margin-top: 26px;
    padding: 26px;
    max-width: 62ch;
    background: var(--surface-pale);
  }
  .bnone[hidden] {
    display: none;
  }
  .bnone__title {
    margin-bottom: 8px;
    font-size: var(--fs-h3);
  }
  .bnone p {
    font-size: var(--fs-body);
    color: var(--text-body-2);
  }
  .bnone .bnone__link {
    margin-top: 14px;
  }

  @media (max-width: 60rem) {
    .bfilter {
      gap: 12px;
    }
    .bsearch {
      flex: 1 1 100%;
    }
    .bgrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 35rem) {
    .bgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Very narrow, or a large browser text size: one name per line. */
  @media (max-width: 22rem) {
    .bgrid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
