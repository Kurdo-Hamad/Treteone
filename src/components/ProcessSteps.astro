---
/**
 * A row of numbered steps — the shared grid behind the five-step process on
 * /sourcing and the navy component-to-system band on /products (ScopeSteps).
 * Mockup source: .steps / .step in reference/mockup.html.
 *
 *   5 across · 2 across below 960px · 1 across below 560px
 *
 * Works on white and on navy without a variant: every colour is a role token
 * that .navy redefines (tokens.css), so the band sets the ground and this
 * component follows it.
 *
 * Props
 *   steps  label ("Step 1" / "1"), title and body, already localised. The
 *          number stays because here the order is the information.
 */

interface Step {
  label: string;
  title: string;
  body: string;
}

interface Props {
  steps: readonly Step[];
}

const { steps } = Astro.props;
---

<ol class="steps">
  {
    steps.map((step) => (
      <li class="step">
        <span class="step__k">{step.label}</span>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(18px, 2.4vw, 30px);
  }

  /* The step number, in the display face with tabular figures — the order
     is the information here. --fg-accent is link-blue on light grounds and
     cyan-light on navy (plain cyan on white is 2.4:1 and fails §11). */
  .step__k {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-stack-display);
    font-weight: 600;
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
    color: var(--fg-accent);
  }

  /* Each step stands on the shared ruled-entry hairline (global.css). */
  .step {
    padding-bottom: 22px;
  }

  .step h3 {
    font-size: var(--fs-lead);
  }

  .step p {
    margin-top: 8px;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--fg-body);
  }
  /* Mockup: .66 white on navy. --on-dark-3 is .64, above the §11 floor of .50. */
  :global(:is(.navy, .dark-surface)) .step p {
    color: var(--on-dark-3);
  }

  @media (max-width: 60rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 35rem) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
