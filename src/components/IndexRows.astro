---
/**
 * Index rows — the list on /products (12 categories) and /industries
 * (9 sectors). One component for both, so the two indexes read the same.
 * Mockup source: .rows / .row in reference/mockup.html.
 *
 *   number · name · mono spec line · action          (four columns)
 *   number · name                                     (below 960px)
 *            spec
 *            action
 *
 * Every row is one link to the quote form — there are no per-category pages
 * (CLAUDE.md §3) — so the whole row is the touch target on a phone (§13).
 * Each <li> carries the entry's slug as its id, so categoryHref() and
 * industryHref() in src/data/navigation.ts land on the right row.
 *
 * Props
 *   rows          id (slug), name and spec, already localised by the page
 *   href          the localised quote route
 *   action        visible action label ("Enquire"); the arrow is decorative
 *   label         accessible name of the list
 *   headingLevel  2 when the rows sit directly under the page h1 (both
 *                 current uses), 3 under a section h2. Looks the same.
 */

interface Row {
  id: string;
  name: string;
  spec: string;
}

interface Props {
  rows: readonly Row[];
  href: string;
  action: string;
  label: string;
  headingLevel?: 2 | 3;
}

const { rows, href, action, label, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
const pad = (n: number): string => String(n).padStart(2, '0');
---

<ol class="rows" aria-label={label}>
  {
    rows.map((row, i) => (
      <li id={row.id}>
        <a class="row" href={href}>
          <span class="row__n mono" aria-hidden="true">{pad(i + 1)}</span>
          <Heading class="row__name">{row.name}</Heading>
          <span class="row__spec mono">{row.spec}</span>
          <span class="row__go">
            {action} <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .rows {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1.05fr) minmax(0, 1.25fr) 104px;
    gap: 18px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-fast);
  }
  .row:hover {
    background: var(--surface-pale);
  }

  .row__n {
    font-size: .75rem;
    color: var(--fg-kicker);
  }

  .row__name {
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .row__spec {
    font-size: .78rem;
    line-height: 1.75;
    color: var(--fg-muted);
  }

  .row__go {
    display: inline-block;
    font-family: var(--font-stack-display);
    font-weight: 600;
    font-size: .875rem;
    color: var(--fg-link);
    text-align: right;
    white-space: nowrap;
    transition: transform var(--dur-fast), color var(--dur-fast);
  }
  .row:hover .row__go {
    color: var(--color-cyan);
    transform: translateX(4px);
  }

  @media (max-width: 960px) {
    .row {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 12px;
    }
    .row__spec,
    .row__go {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
