---
import { Picture } from 'astro:assets';
import portrait from '~/assets/about/portrait.jpg';
import { aboutPoints } from '~/data/about';
import { company } from '~/data/company';
import { getLangFromUrl, pick, useTranslations } from '~/i18n/ui';

/**
 * /about — the 6 points, with a sticky photograph beside them on desktop.
 *
 * This section and the company details are how the site answers §1's second
 * job: are these people real? Nothing here may be a claim the page cannot
 * back up.
 *
 * That is why the last point is conditional. While the registered name and
 * licence number are placeholders (§12), it uses `pendingDescription` and says
 * what is actually the case; it switches to the confident wording by itself
 * once src/data/company.ts has real values.
 *
 * ⚠ §12 — the photograph is a stand-in.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/** True only when the company details really do publish both. */
const registrationPublished =
  company.registeredName !== null && company.licenceNumber !== null;

const pad = (n: number): string => String(n).padStart(2, '0');
---

<section class="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div class="about__body">
      <h2 class="about__title rv" id="about-title">{t('about.heading')}</h2>

      <ol class="about__points">
        {
          aboutPoints.map((point, i) => {
            const copy =
              !registrationPublished && point.pendingDescription
                ? point.pendingDescription
                : point.description;

            return (
              <li class="about-point rv">
                <span class="mono about-point__no" aria-hidden="true">{pad(i + 1)}</span>
                <h3 class="about-point__title">{pick(point.title, lang)}</h3>
                <p class="about-point__body">{pick(copy, lang)}</p>
              </li>
            );
          })
        }
      </ol>
    </div>

    <div class="about__media rv">
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[420, 720, 1080]}
        sizes="(min-width: 1040px) 34vw, min(100vw, 480px)"
        alt=""
        class="about__portrait"
        loading="lazy"
        decoding="async"
      />
      <p class="mono about__caption">{pick(company.district, lang)}</p>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-y);
  }

  .about__grid {
    display: grid;
    gap: clamp(40px, 5vw, 80px);
    align-items: start;
  }

  .about__title {
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .about__points {
    display: grid;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about-point {
    padding-top: 16px;
    border-top: 2px solid var(--color-navy);
  }
  .about-point__no {
    display: block;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .about-point__title {
    margin: 10px 0 8px;
    font-size: 1.25rem;
  }
  .about-point__body {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-body);
  }

  .about__media {
    max-width: 480px;
  }
  .about__portrait {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .about__caption {
    margin-top: 12px;
    font-size: var(--fs-small);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  :global(html[lang^='zh']) .about__caption {
    letter-spacing: 0;
    text-transform: none;
  }

  @media (min-width: 720px) {
    .about__points {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 32px;
    }
  }

  @media (min-width: 1040px) {
    .about__grid {
      grid-template-columns: 7fr 5fr;
    }
    .about__media {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      max-width: none;
    }
  }
</style>
