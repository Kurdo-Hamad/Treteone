---
import { brandTile } from '~/data/brand-logos';
import { brandRows, brands } from '~/data/brands';
import { brandsHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * §7.6 — the brand strip: clean, white, entry to /brands.
 *
 * ⚠ §13 — the heading is "Brands we source" and the disclaimer stays. Nothing
 * here may imply authorisation, distributorship or agency.
 *
 * Two rows, opposite directions, pause on hover. Logos resolve at build time
 * (src/data/brand-logos.ts); every tile is currently the dashed name
 * placeholder, which is the expected state (§12).
 *
 * The moving rows are aria-hidden; assistive technology gets a plain static
 * list. Under reduced motion the rows stop and wrap into a static grid (§9).
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="brand-strip" aria-labelledby="brand-strip-title">
  <div class="wrap brand-strip__head">
    <h2 class="eyebrow brand-strip__title" id="brand-strip-title">{t('brands.heading')}</h2>
    <a class="link-arrow" href={localisePath(brandsHref, lang)}>
      {t('home.brands.all')}
      <svg class="link-arrow__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M1 7.25h11.19L7.47 2.53l1.06-1.06L15.06 8l-6.53 6.53-1.06-1.06 4.72-4.72H1z" fill="currentColor" />
      </svg>
    </a>
  </div>

  <ul class="sr-only" aria-labelledby="brand-strip-title">
    {brands.map((name) => <li>{name}</li>)}
  </ul>

  {
    brandRows.map((row, rowIndex) => (
      <div class:list={['marquee', { 'marquee--reverse': rowIndex === 1 }]} aria-hidden="true">
        <div class="marquee__track">
          {/* Two copies: the animation travels one copy's width and loops, so
              the seam never shows. The clone is dropped under reduced motion. */}
          {[0, 1].map((copy) => (
            <div class="marquee__copy" data-marquee-clone={copy === 1 ? '' : undefined}>
              {row.map((name) => {
                const item = brandTile(name);
                return (
                  <div class:list={['logo', { 'logo--has-image': item.logo !== null }]}>
                    {item.logo ? (
                      <img class="logo__img" src={item.logo} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <span class="logo__name">{item.name}</span>
                    )}
                  </div>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    ))
  }

  <div class="wrap">
    <p class="brand-strip__disclaimer">{t('brands.disclaimer')}</p>
  </div>
</section>

<style>
  .brand-strip {
    padding-block: clamp(64px, 8vw, 96px);
    background: var(--surface-page);
  }

  .brand-strip__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    margin-bottom: 28px;
  }
  .brand-strip__title {
    color: var(--text-primary);
  }

  /* -- marquee ----------------------------------------------------------- */
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--rule-light);
  }
  .marquee--reverse {
    border-bottom: 1px solid var(--rule-light);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: brand-slide 52s linear infinite;
    will-change: transform;
  }
  .marquee--reverse .marquee__track {
    animation-direction: reverse;
    animation-duration: 62s;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__copy {
    display: flex;
  }

  @keyframes brand-slide {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* -- tile -------------------------------------------------------------- */
  .logo {
    flex: 0 0 180px;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    border-inline-end: 1px solid var(--rule-light);
  }
  .logo__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: .75;
    transition: filter var(--dur-fast), opacity var(--dur-fast);
  }
  .logo--has-image:hover .logo__img {
    filter: none;
    opacity: 1;
  }

  /* §9 — the placeholder, and currently every tile. Dashed, so it reads as a
     placeholder rather than as a wordmark we chose to set in type. */
  .logo__name {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 6px;
    border: 1px dashed var(--color-muted-blue);
    font-family: var(--font-stack-display);
    font-size: .875rem;
    font-weight: 500;
    line-height: 1.15;
    text-align: center;
    color: var(--text-secondary);
  }

  .brand-strip__disclaimer {
    margin-top: 20px;
    max-width: 90ch;
    font-size: var(--fs-small);
    color: var(--text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
    }
    .marquee__copy {
      flex-wrap: wrap;
    }
    .marquee__copy[data-marquee-clone] {
      display: none;
    }
    .logo {
      flex: 1 0 180px;
    }
  }
</style>
