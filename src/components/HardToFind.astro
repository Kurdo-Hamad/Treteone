---
import type { TextKey } from '~/data/heroSlides';
import { sourcingHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * §7.7 Hard-to-find — the navy band from the approved mockup: the claim and
 * one action on the left, the numbered "what to send" list on the right.
 * Entry to /sourcing, which holds the full checklist and the process.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sendable: readonly TextKey[] = [
  'home.htf.send1',
  'home.htf.send2',
  'home.htf.send3',
  'home.htf.send4',
];
const pad = (n: number): string => String(n).padStart(2, '0');
---

<section class="navy" aria-labelledby="htf-title">
  <div class="wrap sec">
    <div class="htf">
      <div>
        <p class="kicker">{t('home.htf.kicker')}</p>
        <h2 id="htf-title">{t('home.htf.heading')}</h2>
        <p class="lead htf__lead">{t('home.htf.lead')}</p>
        <p class="htf__cta">
          <a class="btn btn-solid" href={localisePath(sourcingHref, lang)}>{t('home.htf.cta')}</a>
        </p>
      </div>
      <ol class="htf__list" aria-label={t('home.htf.listLabel')}>
        {
          sendable.map((key, i) => (
            <li>
              <span class="mono htf__k" aria-hidden="true">{pad(i + 1)}</span>
              <span>{t(key)}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .htf {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    gap: clamp(26px, 4vw, 60px);
    align-items: center;
  }
  .htf__lead {
    margin-top: 16px;
  }
  .htf__cta {
    margin-top: 24px;
  }

  .htf__list {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    border-top: 1px solid var(--line-dark);
  }
  .htf__list li {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 14px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line-dark);
    font-size: .9375rem;
    color: rgba(255, 255, 255, .82);
  }
  .htf__k {
    padding-top: 3px;
    font-size: .72rem;
    color: var(--color-cyan-light);
  }

  @media (max-width: 960px) {
    .htf {
      grid-template-columns: 1fr;
    }
  }
</style>
