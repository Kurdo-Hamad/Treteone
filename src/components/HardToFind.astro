---
import type { TextKey } from '~/data/heroSlides';
import { sourcingHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * §7.7 Hard-to-find — the navy band: the claim and one action on the left,
 * the "what to send" list on the right. The list is not numbered: it is a set
 * of things to send, not a sequence.
 * Entry to /sourcing, which holds the full checklist and the process.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sendable: readonly TextKey[] = [
  'home.htf.send1',
  'home.htf.send2',
  'home.htf.send3',
  'home.htf.send4',
];
---

<section class="navy" aria-labelledby="htf-title">
  <div class="wrap sec">
    <div class="htf">
      <div>
        <h2 id="htf-title">{t('home.htf.heading')}</h2>
        <p class="lead htf__lead">{t('home.htf.lead')}</p>
        <p class="htf__cta">
          <a class="btn btn-solid" href={localisePath(sourcingHref, lang)}>{t('home.htf.cta')}</a>
        </p>
      </div>
      <ol class="htf__list" aria-label={t('home.htf.listLabel')}>
        {
          sendable.map((key) => <li>{t(key)}</li>)
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .htf {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    gap: clamp(26px, 4vw, 60px);
    align-items: center;
  }
  .htf__lead {
    margin-top: 18px;
  }
  .htf__cta {
    margin-top: 24px;
  }

  .htf__list {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    border-top: 1px solid var(--line-dark);
  }
  /* Each row stands on the shared ruled-entry hairline (global.css). */
  .htf__list li {
    padding: 18px 0;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--on-dark-1);
  }

  @media (max-width: 60rem) {
    .htf {
      grid-template-columns: 1fr;
    }
  }
</style>
