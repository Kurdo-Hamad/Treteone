---
import { quoteHref, sourcingHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations, type UIKey } from '~/i18n/ui';

/**
 * §7.5 — the dark navy conversion section. Entry to /sourcing.
 *
 * Composition: a two-column argument. The claim and the actions on the left;
 * on the right, three numbered things a buyer probably already has in hand.
 * Three of the five — the full checklist and the process live on /sourcing.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sendable: readonly UIKey[] = [
  'sourcing.send.partNumber',
  'sourcing.send.nameplate',
  'sourcing.send.boq',
];
const pad = (n: number): string => String(n).padStart(2, '0');
---

<section class="htf dark-surface" aria-labelledby="htf-title">
  <div class="wrap htf__grid">
    <div class="htf__copy rv">
      <p class="eyebrow htf__eyebrow">{t('home.sourcing.eyebrow')}</p>
      <h2 class="htf__title" id="htf-title">{t('sourcing.heading')}</h2>
      <p class="htf__lede">{t('sourcing.lede')}</p>
      <div class="htf__actions">
        <a class="btn" href={localisePath(quoteHref, lang)}>{t('home.sourcing.cta')}</a>
        <a class="link-arrow" href={localisePath(sourcingHref, lang)}>
          {t('home.sourcing.link')}
          <svg class="link-arrow__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M1 7.25h11.19L7.47 2.53l1.06-1.06L15.06 8l-6.53 6.53-1.06-1.06 4.72-4.72H1z" fill="currentColor" />
          </svg>
        </a>
      </div>
    </div>

    <div class="htf__panel rv">
      <h3 class="eyebrow htf__panel-label" id="htf-send">{t('home.sourcing.sendLabel')}</h3>
      <ol class="htf__list" aria-labelledby="htf-send">
        {
          sendable.map((key, i) => (
            <li class="htf__item">
              <span class="mono htf__no" aria-hidden="true">{pad(i + 1)}</span>
              <span class="htf__text">{t(key)}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .htf {
    padding-block: clamp(80px, 11vw, 144px);
  }

  .htf__grid {
    display: grid;
    gap: clamp(48px, 6vw, 96px);
  }

  .htf__eyebrow {
    color: var(--color-cyan-light);
  }
  .htf__title {
    margin-top: 16px;
    max-width: 16ch;
    font-size: var(--fs-h1);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--text-inverse);
    text-wrap: balance;
  }
  :global(html[lang^='zh']) .htf__title {
    line-height: 1.25;
  }
  .htf__lede {
    margin-top: 24px;
    max-width: 48ch;
    color: var(--on-dark-2);
  }
  .htf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 36px;
  }

  .htf__panel {
    align-self: end;
    border-top: 2px solid var(--color-cyan);
    padding-top: 20px;
  }
  .htf__panel-label {
    color: var(--on-dark-3);
  }
  .htf__list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }
  .htf__item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    align-items: baseline;
    padding-block: 20px;
    border-bottom: 1px solid var(--rule-dark);
  }
  .htf__no {
    color: var(--color-cyan-light);
  }
  .htf__text {
    font-family: var(--font-stack-display);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text-inverse);
  }

  @media (min-width: 1040px) {
    .htf__grid {
      grid-template-columns: 7fr 5fr;
      align-items: end;
    }
  }
</style>
