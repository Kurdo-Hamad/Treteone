---
import { Picture } from 'astro:assets';
import { categories } from '~/data/categories';
import { quoteHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, pick, useTranslations } from '~/i18n/ui';

/**
 * CLAUDE.md §6.5 — horizontal, drag / scroll / arrow keys, snap points,
 * progress bar, 12 photo cards.
 *
 * The rail is a native scroll container, so it works before a byte of
 * JavaScript arrives: touch, trackpad, wheel and Tab all move it, and the snap
 * points are CSS. src/scripts/product-rail.ts adds the drag, the arrow keys,
 * the buttons and the progress thumb on top.
 *
 * §9 — fully keyboard-operable. The scroll container is focusable and labelled
 * so it can be arrowed through like any scrollable region, and each card
 * carries exactly one link with a name that makes sense read on its own.
 *
 * Each card is an <article> with the link on "Enquire", stretched over the card
 * by a pseudo-element, rather than an <a> wrapped around everything. That keeps
 * the category name a real heading instead of burying it inside a link, and
 * gives the link one clean accessible name rather than the whole card's text.
 *
 * ⚠ §10 — the 12 photographs are "PHOTOGRAPH PENDING" plates. See
 * src/data/categories.ts.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pad = (n: number): string => String(n).padStart(2, '0');
const quote = localisePath(quoteHref, lang);
---

<section class="products" id="products" data-rail-root>
  <div class="wrap">
    <div class="products__head rv">
      <div class="products__intro">
        <h2>{t('products.heading')}</h2>
        <p class="lede products__lede">{t('products.lede')}</p>
      </div>

      <div class="products__nav">
        <button
          class="rail-button"
          type="button"
          data-rail-prev
          aria-controls="product-rail"
          aria-label={t('products.previous')}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M15 5 8 12l7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"></path>
          </svg>
        </button>
        <button
          class="rail-button"
          type="button"
          data-rail-next
          aria-controls="product-rail"
          aria-label={t('products.next')}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M9 5l7 7-7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"></path>
          </svg>
        </button>
      </div>
    </div>

    <p class="sr-only" id="product-rail-hint">{t('products.railHint')}</p>

    <div
      class="rail"
      id="product-rail"
      data-rail
      tabindex="0"
      role="group"
      aria-label={t('products.railLabel')}
      aria-describedby="product-rail-hint"
    >
      {
        categories.map((category, i) => (
          <article class="card" data-rail-card>
            <div class="card__frame">
              <Picture
                src={category.image}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[340, 680, 1020]}
                sizes="(min-width: 1270px) 330px, (min-width: 1000px) 26vw, 260px"
                alt=""
                class="card__img"
                loading="lazy"
                decoding="async"
                draggable={false}
              />
              <span class="card__no mono" aria-hidden="true">
                {pad(i + 1)}
              </span>
            </div>

            <div class="card__body">
              <h3 class="card__title">{pick(category.name, lang)}</h3>
              <p class="card__blurb">{pick(category.blurb, lang)}</p>
              <a
                class="card__go"
                href={quote}
                aria-label={t('products.cardLabel')(pick(category.name, lang))}
              >
                {t('products.enquire')}
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="rail-track">
      <div class="rail-track__thumb" data-rail-progress></div>
    </div>
  </div>
</section>

<script>
  import '~/scripts/product-rail';
</script>

<style>
  .products {
    padding-block: var(--section-y);
  }

  /* -- head -------------------------------------------------------------- */

  .products__head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 32px;
  }
  .products__lede {
    margin-top: 14px;
  }

  /* The buttons are an accelerator, not the only way through the rail. Without
     the script they would sit there doing nothing, so they do not appear until
     it has run — the rail itself scrolls fine either way. */
  .products__nav {
    display: none;
    gap: 8px;
  }
  .products.is-live .products__nav {
    display: flex;
  }

  .rail-button {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule);
    background: var(--white);
    border-radius: var(--radius);
    color: var(--ink);
    cursor: pointer;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast),
      opacity var(--dur-fast);
  }
  .rail-button svg {
    width: 20px;
    height: 20px;
  }
  .rail-button:hover:not(:disabled) {
    background: var(--ink);
    color: var(--white);
    border-color: var(--ink);
  }
  .rail-button:disabled {
    opacity: .35;
    cursor: default;
  }

  /* -- rail -------------------------------------------------------------- */

  .rail {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
    /* the native bar is replaced by the progress track below */
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .rail.is-live {
    cursor: grab;
  }
  .rail.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  /* -- card -------------------------------------------------------------- */

  .card {
    position: relative;
    flex: 0 0 clamp(260px, 26vw, 330px);
    scroll-snap-align: start;
    background: var(--white);
    border: 1px solid var(--rule);
    transition: border-color var(--dur-fast);
  }

  .card__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink-2);
  }
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(.35);
    transition:
      transform var(--dur-slow) var(--ease),
      filter var(--dur-fast);
  }
  .card:hover .card__img {
    transform: scale(1.06);
    filter: grayscale(0);
  }

  .card__no {
    position: absolute;
    left: 0;
    top: 0;
    background: var(--signal);
    color: var(--ink);
    font-size: .72rem;
    letter-spacing: .06em;
    padding: 5px 9px;
  }

  .card__body {
    padding: 20px 20px 24px;
  }
  .card__title {
    margin-bottom: 8px;
  }
  .card__blurb {
    font-size: .86rem;
    color: var(--steel);
    line-height: 1.5;
  }

  .card__go {
    display: inline-block;
    margin-top: 14px;
    font-size: .86rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid var(--signal);
    padding-bottom: 2px;
  }
  /* Stretches the one link over the whole card, so the card is clickable
     without wrapping every element in an anchor. */
  .card__go::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* The focus ring lands on the link text; this makes the whole card answer to
     it too, so it is obvious which card is selected. */
  .card:has(.card__go:focus-visible) {
    border-color: var(--signal);
  }

  /* -- progress ---------------------------------------------------------- */

  .rail-track {
    position: relative;
    height: 2px;
    background: var(--rule);
    margin-top: 26px;
  }
  .rail-track__thumb {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    height: 100%;
    /* Replaced by the script with the real proportion on first paint. */
    width: 30%;
    background: var(--signal);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .card__img {
      transform: none;
    }
  }

  @media (min-width: 720px) {
    .products__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .products__nav {
      flex: 0 0 auto;
    }
  }
</style>
