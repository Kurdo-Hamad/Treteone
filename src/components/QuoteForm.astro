---
import { company, mailHref } from '~/data/company';
import {
  ACCEPT_ATTRIBUTE,
  QUOTE_ENDPOINT,
  QUOTE_LIMITS,
  enquiryTypes,
  mb,
} from '~/data/quote';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';

/**
 * /quote — CLAUDE.md §8, the only conversion point on the site. It must work.
 * The logic is unchanged from pass 5; this pass restyles it to the approved
 * mockup (#v-quote): one navy band, the page head and three facts on the left,
 * the form on the right.
 *
 *  - **No account, ever.** One contact field, and nothing else required.
 *    A buyer with only a blurry nameplate photo can still send it.
 *  - **It is a real <form> with a real action.** With JavaScript it posts by
 *    fetch and renders the result in place, never a redirect. Without
 *    JavaScript the browser posts it normally and the function answers with a
 *    plain confirmation page (public/form-response.css) carrying the same
 *    reference number.
 *  - **The spam defence is a honeypot plus a timing check.** No CAPTCHA —
 *    engineers on plant networks abandon them.
 *  - **Validation is strict about attachments and permissive about everything
 *    else.** A rejected enquiry is worse than an untidy one.
 *
 * The page passes its PageHead (kicker, h1, lead) into the `head` slot, so the
 * route still opens with the shared page head. Limits come from
 * src/data/quote.ts through data attributes, so src/scripts/quote-form.ts
 * holds neither numbers nor copy.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const maxFileMb = mb(QUOTE_LIMITS.maxFileBytes);
const maxTotalMb = mb(QUOTE_LIMITS.maxTotalBytes);
---

<section class="navy quote" id="quote">
  <div class="wrap sec quote__split">
    <div class="quote__intro">
      <slot name="head" />

      <ul class="quote__facts">
        <li>
          <span class="quote__key">{t('quote.aside.files')}</span>
          <span id="quote-files-hint">
            {t('quote.files.hint')(QUOTE_LIMITS.maxFiles, maxFileMb, maxTotalMb)}
          </span>
        </li>
        <li>
          <span class="quote__key">{t('quote.aside.reply')}</span>
          <span>
            {/* Explicit spaces: Astro trims the whitespace around expressions.
                Chinese also takes a space either side of a Latin run. */}
            {t('quote.aside.replyBefore')}{' '}<span class="mono">{t('quote.aside.replyExample')}</span>{' '}{t('quote.aside.replyAfter')}
          </span>
        </li>
        <li>
          <span class="quote__key">{t('quote.aside.direct')}</span>
          <span>
            <a class="quote__direct" href={mailHref}>{company.email}</a>
            <span aria-hidden="true"> · </span>
            <a class="quote__direct" href={company.whatsappUrl} rel="noopener noreferrer" target="_blank"
              >{t('cta.whatsapp')} {company.phoneDisplay}</a
            >
          </span>
        </li>
      </ul>
    </div>

    <form
      class="quote__form"
      method="post"
      action={QUOTE_ENDPOINT}
      enctype="multipart/form-data"
      aria-label={t('quote.formLabel')}
      data-quote-form
      data-max-files={QUOTE_LIMITS.maxFiles}
      data-max-file-bytes={QUOTE_LIMITS.maxFileBytes}
      data-max-total-bytes={QUOTE_LIMITS.maxTotalBytes}
      data-max-file-mb={maxFileMb}
      data-max-total-mb={maxTotalMb}
      data-accept={ACCEPT_ATTRIBUTE}
      data-msg-sending={t('quote.sending')}
      data-msg-submit={t('quote.submit')}
      data-msg-success-title={t('quote.success.title')}
      data-msg-success-body={t('quote.success.body')}
      data-msg-success-reference={t('quote.success.reference')}
      data-msg-error-title={t('quote.error.title')}
      data-msg-error-body={t('quote.error.body')(company.email)}
      data-msg-contact-required={t('quote.error.contactRequired')}
      data-msg-too-many-files={t('quote.error.tooManyFiles')(QUOTE_LIMITS.maxFiles)}
      data-msg-file-too-large={t('quote.error.fileTooLarge')('{name}', maxFileMb)}
      data-msg-total-too-large={t('quote.error.totalTooLarge')(maxTotalMb)}
      data-msg-bad-type={t('quote.error.badType')('{name}')}
      data-msg-files-selected={t('quote.files.selected')(0).replace('0', '{n}')}
    >
      <input type="hidden" name="lang" value={lang} />
      {/* §8 timing check. Set by the script on load; empty means no script ran,
          which the function treats as a pass rather than as spam. */}
      <input type="hidden" name="rendered_at" value="" data-quote-time />

      <div class="field">
        <label for="quote-type">{t('quote.type.label')}</label>
        <select id="quote-type" name="type">
          {
            enquiryTypes.map((type) => (
              <option value={type.slug}>{t(type.key)}</option>
            ))
          }
        </select>
      </div>

      <div class="field">
        <label for="quote-part">{t('quote.part.label')}</label>
        <input
          id="quote-part"
          name="part"
          type="text"
          autocomplete="off"
          placeholder={t('quote.part.placeholder')}
        />
      </div>

      <div class="pair">
        <div class="field">
          <label for="quote-manufacturer">{t('quote.manufacturer.label')}</label>
          <input
            id="quote-manufacturer"
            name="manufacturer"
            type="text"
            autocomplete="organization"
            placeholder={t('quote.manufacturer.placeholder')}
          />
        </div>
        <div class="field">
          <label for="quote-quantity">{t('quote.quantity.label')}</label>
          <input
            id="quote-quantity"
            name="quantity"
            type="text"
            placeholder={t('quote.quantity.placeholder')}
          />
        </div>
      </div>

      <div class="field">
        <label for="quote-files">{t('quote.files.label')}</label>
        <input
          id="quote-files"
          name="files"
          type="file"
          multiple
          accept={ACCEPT_ATTRIBUTE}
          aria-describedby="quote-files-hint"
          data-quote-files
        />
      </div>

      <div class="field">
        <label for="quote-notes">{t('quote.notes.label')}</label>
        <textarea id="quote-notes" name="notes" placeholder={t('quote.notes.placeholder')}></textarea>
      </div>

      <div class="pair">
        <div class="field">
          <label for="quote-name">{t('quote.name.label')}</label>
          <input id="quote-name" name="name" type="text" autocomplete="name" />
        </div>
        <div class="field">
          <label for="quote-contact">{t('quote.contact.label')}</label>
          <input
            id="quote-contact"
            name="contact"
            type="text"
            required
            autocomplete="email"
            aria-describedby="quote-hint"
            data-quote-contact
          />
        </div>
      </div>

      {/*
        §8 honeypot. Hidden from sight, from the tab order and from assistive
        technology, so no person will ever fill it in. Anything that does is
        discarded server side — and told it succeeded, so it does not retry.
      */}
      <div class="honeypot" aria-hidden="true">
        <label for="quote-company-url">{t('quote.honeypot.label')}</label>
        <input
          id="quote-company-url"
          name="company_url"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div class="quote__actions">
        <button class="btn btn-solid quote__submit" type="submit" data-quote-submit>
          {t('quote.submit')}
        </button>
        <p class="quote__hint" id="quote-hint">{t('quote.hint')}</p>
      </div>

      {/*
        Success and failure are rendered here, in place (§8). role="status" so a
        screen reader is told without the focus being yanked away.
      */}
      <div class="quote__result" role="status" data-quote-result></div>
    </form>
  </div>
</section>

<script>
  import '~/scripts/quote-form';
</script>

<style>
  /* Mockup .split: copy left, form right; one column below 960px. */
  .quote__split {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    gap: clamp(26px, 4vw, 60px);
    align-items: center;
  }

  /* -- the three facts (mockup .checklist) ------------------------------- */
  .quote__facts {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    border-top: 1px solid var(--line-dark);
  }
  .quote__facts li {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 14px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line-dark);
    font-size: .9375rem;
    color: var(--on-dark-2);
  }
  .quote__key {
    padding-top: 3px;
    font-family: var(--font-stack-mono);
    font-size: .72rem;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-cyan-light);
  }
  .quote__direct {
    color: var(--on-dark-1);
    text-decoration: underline;
    text-decoration-color: var(--on-dark-4);
    text-underline-offset: 4px;
    /* A phone number or address broken across lines is easy to misread. */
    white-space: nowrap;
    transition: color var(--dur-fast), text-decoration-color var(--dur-fast);
  }
  .quote__facts .mono {
    white-space: nowrap;
  }
  .quote__direct:hover {
    color: var(--color-cyan-light);
    text-decoration-color: currentColor;
  }

  /* -- form (mockup .form / .field / .pair) ------------------------------ */
  .quote__form {
    display: grid;
    gap: 16px;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field label {
    display: block;
    margin-bottom: 7px;
    font-family: var(--font-stack-display);
    font-weight: 600;
    font-size: .78rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--on-dark-3);
  }
  html[lang^='zh'] .field label {
    letter-spacing: .02em;
  }

  .field :is(input, select, textarea) {
    width: 100%;
    min-height: 46px;
    padding: 12px 14px;
    /* A control's boundary needs 3:1 (WCAG 1.4.11). The mockup's .22 white
       is about 1.9:1 on navy; --rule-control on navy is the .50 tier. */
    border: 1px solid var(--rule-control);
    border-radius: 0;
    background: color-mix(in srgb, var(--color-white) 6%, transparent);
    color: var(--on-dark-1);
    font-family: var(--font-stack-body);
    /* 16px or more stops iOS zooming the page on focus. */
    font-size: 1rem;
    /* Native parts — the select arrow, its option list, the file button —
       render for a dark ground. */
    color-scheme: dark;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .field :is(input, select, textarea):hover {
    border-color: var(--on-dark-2);
  }
  .field :is(input, select, textarea):focus {
    border-color: var(--color-cyan-light);
  }
  .field option {
    background: var(--color-navy);
    color: var(--on-dark-1);
  }
  .field textarea {
    min-height: 100px;
    resize: vertical;
  }
  .field :is(input, textarea)::placeholder {
    color: var(--on-dark-4);
    font-family: var(--font-stack-mono);
    font-size: .84rem;
    opacity: 1;
  }
  .field input[type='file'] {
    padding: 8px 10px;
    font-size: .875rem;
    color: var(--on-dark-2);
  }
  .field input[type='file']::file-selector-button {
    margin-right: 12px;
    padding: 6px 14px;
    border: 1px solid var(--on-dark-4);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--on-dark-1);
    font-family: var(--font-stack-display);
    font-weight: 600;
    font-size: .8125rem;
    cursor: pointer;
    transition: border-color var(--dur-fast);
  }
  .field input[type='file']:hover::file-selector-button {
    border-color: var(--on-dark-1);
  }

  /* Invalid is marked by a doubled red border, not the colour alone, and the
     script writes the reason into the result box beneath. */
  .field :is(input, select, textarea)[aria-invalid='true'] {
    border-color: var(--feedback-error);
    box-shadow: inset 0 0 0 1px var(--feedback-error);
  }

  /* §8 honeypot — off-screen rather than display:none, which some bots skip. */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .quote__submit[aria-disabled='true'] {
    opacity: .6;
    cursor: progress;
  }
  .quote__hint {
    margin-top: 14px;
    font-size: .8125rem;
    line-height: 1.6;
    color: var(--on-dark-3);
  }

  /* -- result ------------------------------------------------------------ */
  .quote__result:empty {
    display: none;
  }
  .quote__result {
    padding: 18px 20px;
    border: 1px solid var(--line-dark);
    border-left-width: 4px;
    background: color-mix(in srgb, var(--color-white) 6%, transparent);
  }
  /* The success state's colour is --feedback-success; that is what the token
     is for. The title says the outcome in words, so colour is never the only
     signal (§11). */
  .quote__result[data-state='success'] {
    border-left-color: var(--feedback-success);
  }
  .quote__result[data-state='error'] {
    border-left-color: var(--feedback-error);
  }

  @media (max-width: 960px) {
    .quote__split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
    .quote__submit {
      width: 100%;
    }
  }
</style>

<style is:global>
  /* Written by src/scripts/quote-form.ts into [data-quote-result]. Global
     because the script builds these nodes, so they carry no scope hash. They
     sit on the navy band, so they read the inherited context roles. */
  .quote-result__title {
    display: block;
    margin-bottom: 6px;
    font-family: var(--font-stack-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--fg-heading);
  }
  .quote-result__body {
    display: block;
    font-size: .9375rem;
    color: var(--fg-body);
  }
  .quote-result__reference {
    display: block;
    margin-top: 12px;
    font-family: var(--font-stack-mono);
    font-size: .8125rem;
    letter-spacing: var(--tracking-mono);
    color: var(--fg-body);
  }
  .quote-result__reference b {
    font-family: var(--font-stack-mono);
    font-weight: 400;
    font-size: 1.0625rem;
    color: var(--color-cyan-light);
  }
</style>
