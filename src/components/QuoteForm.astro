---
import { company, mailHref, telHref } from '~/data/company';
import { sourcingHref } from '~/data/navigation';
import {
  ACCEPT_ATTRIBUTE,
  QUOTE_ENDPOINT,
  QUOTE_LIMITS,
  enquiryTypes,
  mb,
} from '~/data/quote';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * /quote — CLAUDE.md §8, the only conversion point on the site. It must work.
 * The logic is unchanged from pass 5; the redesign restyles it only.
 *
 *  - **No account, ever.** One contact field, and nothing else required.
 *    A buyer with only a blurry nameplate photo can still send it.
 *  - **It is a real <form> with a real action.** With JavaScript it posts by
 *    fetch and renders the result in place, never a redirect. Without
 *    JavaScript the browser posts it normally and the function answers with a
 *    plain confirmation page (public/form-response.css) carrying the same
 *    reference number.
 *  - **The spam defence is a honeypot plus a timing check.** No CAPTCHA —
 *    engineers on plant networks abandon them.
 *  - **Validation is strict about attachments and permissive about everything
 *    else.** A rejected enquiry is worse than an untidy one.
 *
 * The page heading and lede are in PageHero above this section. Limits come
 * from src/data/quote.ts through data attributes, so src/scripts/quote-form.ts
 * holds neither numbers nor copy.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const maxFileMb = mb(QUOTE_LIMITS.maxFileBytes);
const maxTotalMb = mb(QUOTE_LIMITS.maxTotalBytes);
---

<section class="quote" id="quote" aria-label={t('quote.formLabel')}>
  <div class="wrap quote__grid">
    <aside class="quote__aside">
      <p class="quote__required">{t('quote.required')}</p>

      <div class="quote__direct">
        <h2 class="eyebrow quote__direct-title">{t('quote.directIntro')}</h2>
        <ul class="quote__direct-list">
          <li><a class="quote__direct-link" href={mailHref}>{company.email}</a></li>
          <li>
            <a
              class="quote__direct-link"
              href={company.whatsappUrl}
              rel="noopener noreferrer"
              target="_blank">{t('cta.whatsapp')} {company.phoneDisplay}</a
            >
          </li>
          <li><a class="quote__direct-link" href={telHref}>{company.phoneDisplay}</a></li>
        </ul>
      </div>

      <a class="link-arrow" href={localisePath(`${sourcingHref}#process`, lang)}>
        {t('quote.processLink')}
        <svg class="link-arrow__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M1 7.25h11.19L7.47 2.53l1.06-1.06L15.06 8l-6.53 6.53-1.06-1.06 4.72-4.72H1z" fill="currentColor" />
        </svg>
      </a>
    </aside>

    <form
      class="quote__form"
      method="post"
      action={QUOTE_ENDPOINT}
      enctype="multipart/form-data"
      aria-label={t('quote.formLabel')}
      data-quote-form
      data-max-files={QUOTE_LIMITS.maxFiles}
      data-max-file-bytes={QUOTE_LIMITS.maxFileBytes}
      data-max-total-bytes={QUOTE_LIMITS.maxTotalBytes}
      data-max-file-mb={maxFileMb}
      data-max-total-mb={maxTotalMb}
      data-accept={ACCEPT_ATTRIBUTE}
      data-msg-sending={t('quote.sending')}
      data-msg-submit={t('quote.submit')}
      data-msg-success-title={t('quote.success.title')}
      data-msg-success-body={t('quote.success.body')}
      data-msg-success-reference={t('quote.success.reference')}
      data-msg-error-title={t('quote.error.title')}
      data-msg-error-body={t('quote.error.body')(company.email)}
      data-msg-contact-required={t('quote.error.contactRequired')}
      data-msg-too-many-files={t('quote.error.tooManyFiles')(QUOTE_LIMITS.maxFiles)}
      data-msg-file-too-large={t('quote.error.fileTooLarge')('{name}', maxFileMb)}
      data-msg-total-too-large={t('quote.error.totalTooLarge')(maxTotalMb)}
      data-msg-bad-type={t('quote.error.badType')('{name}')}
      data-msg-files-selected={t('quote.files.selected')(0).replace('0', '{n}')}
    >
      <input type="hidden" name="lang" value={lang} />
      {/* §8 timing check. Set by the script on load; empty means no script ran,
          which the function treats as a pass rather than as spam. */}
      <input type="hidden" name="rendered_at" value="" data-quote-time />

      <div class="field">
        <label class="field__label" for="quote-type">{t('quote.type.label')}</label>
        <select class="field__control" id="quote-type" name="type">
          {
            enquiryTypes.map((type) => (
              <option value={type.slug}>{t(type.key)}</option>
            ))
          }
        </select>
      </div>

      <div class="field">
        <label class="field__label" for="quote-part">
          {t('quote.part.label')}
          <span class="field__optional">{t('quote.optional')}</span>
        </label>
        <input
          class="field__control"
          id="quote-part"
          name="part"
          type="text"
          autocomplete="off"
          placeholder="6ES7 214-1AG40-0XB0"
        />
      </div>

      <div class="field-row">
        <div class="field">
          <label class="field__label" for="quote-manufacturer">
            {t('quote.manufacturer.label')}
            <span class="field__optional">{t('quote.optional')}</span>
          </label>
          <input
            class="field__control"
            id="quote-manufacturer"
            name="manufacturer"
            type="text"
            autocomplete="organization"
          />
        </div>
        <div class="field">
          <label class="field__label" for="quote-quantity">
            {t('quote.quantity.label')}
            <span class="field__optional">{t('quote.optional')}</span>
          </label>
          <input class="field__control" id="quote-quantity" name="quantity" type="text" />
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="quote-files">
          {t('quote.files.label')}
          <span class="field__optional">{t('quote.optional')}</span>
        </label>
        <input
          class="field__control field__control--file"
          id="quote-files"
          name="files"
          type="file"
          multiple
          accept={ACCEPT_ATTRIBUTE}
          aria-describedby="quote-files-hint"
          data-quote-files
        />
        <p class="field__hint" id="quote-files-hint">
          {t('quote.files.hint')(QUOTE_LIMITS.maxFiles, maxFileMb, maxTotalMb)}
        </p>
      </div>

      <div class="field">
        <label class="field__label" for="quote-notes">
          {t('quote.notes.label')}
          <span class="field__optional">{t('quote.optional')}</span>
        </label>
        <textarea class="field__control field__control--area" id="quote-notes" name="notes"
        ></textarea>
      </div>

      <div class="field-row">
        <div class="field">
          <label class="field__label" for="quote-name">
            {t('quote.name.label')}
            <span class="field__optional">{t('quote.optional')}</span>
          </label>
          <input class="field__control" id="quote-name" name="name" type="text" autocomplete="name" />
        </div>
        <div class="field">
          <label class="field__label" for="quote-contact">{t('quote.contact.label')}</label>
          <input
            class="field__control"
            id="quote-contact"
            name="contact"
            type="text"
            required
            autocomplete="email"
            aria-describedby="quote-contact-hint"
            data-quote-contact
          />
          <p class="field__hint" id="quote-contact-hint">{t('quote.contact.hint')}</p>
        </div>
      </div>

      {/*
        §8 honeypot. Hidden from sight, from the tab order and from assistive
        technology, so no person will ever fill it in. Anything that does is
        discarded server side — and told it succeeded, so it does not retry.
      */}
      <div class="honeypot" aria-hidden="true">
        <label for="quote-company-url">{t('quote.honeypot.label')}</label>
        <input
          id="quote-company-url"
          name="company_url"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div class="quote__actions">
        <button class="btn quote__submit" type="submit" data-quote-submit>
          {t('quote.submit')}
        </button>
      </div>

      {/*
        Success and failure are rendered here, in place (§8). role="status" so a
        screen reader is told without the focus being yanked away.
      */}
      <div class="quote__result" role="status" data-quote-result></div>
    </form>
  </div>
</section>

<script>
  import '~/scripts/quote-form';
</script>

<style>
  .quote {
    padding-block: clamp(48px, 7vw, 96px) var(--section-y);
    background: var(--surface-page);
  }

  .quote__grid {
    display: grid;
    gap: 40px;
    align-items: start;
  }

  /* -- aside ------------------------------------------------------------- */
  .quote__aside {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .quote__required {
    padding-left: 14px;
    border-left: 2px solid var(--color-navy);
    font-size: 1rem;
    color: var(--text-primary);
  }
  .quote__direct-title {
    color: var(--text-secondary);
  }
  .quote__direct-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  .quote__direct-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--text-link-light);
    text-underline-offset: 4px;
  }
  .quote__direct-link:hover {
    text-decoration-thickness: 2px;
  }

  /* -- form card --------------------------------------------------------- */
  .quote__form {
    display: grid;
    gap: 20px;
    padding: clamp(20px, 4vw, 40px);
    background: var(--surface-card);
    border: 1px solid var(--rule-light);
    box-shadow: var(--shadow-raised);
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .field__label {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
    margin-bottom: 8px;
    font-family: var(--font-stack-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
  }
  .field__optional {
    font-family: var(--font-stack-body);
    font-size: .875rem;
    font-weight: 400;
    color: var(--text-secondary);
  }

  .field__control {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid var(--rule-control);
    border-radius: var(--radius);
    background: var(--surface-page);
    color: var(--text-primary);
    font-family: var(--font-stack-body);
    /* 16px or more stops iOS zooming the page on focus. */
    font-size: 1rem;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .field__control:hover {
    border-color: var(--color-navy);
  }
  .field__control::placeholder {
    color: var(--text-secondary);
  }
  .field__control--area {
    min-height: 120px;
    resize: vertical;
  }
  .field__control--file {
    padding: 10px 14px;
  }

  .field__hint {
    margin-top: 6px;
    font-size: .875rem;
    color: var(--text-secondary);
  }

  /* Invalid is marked by a doubled red border, not the colour alone, and the
     script writes the reason into the result box beneath. */
  .field__control[aria-invalid='true'] {
    border-color: var(--feedback-error);
    box-shadow: inset 0 0 0 1px var(--feedback-error);
  }

  /* §8 honeypot — off-screen rather than display:none, which some bots skip. */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .quote__actions {
    margin-top: 4px;
  }
  .quote__submit {
    width: 100%;
  }
  .quote__submit[aria-disabled='true'] {
    opacity: .6;
    cursor: progress;
  }

  /* -- result ------------------------------------------------------------ */
  .quote__result:empty {
    display: none;
  }
  .quote__result {
    padding: 20px 22px;
    border: 1px solid var(--rule-light);
    border-left-width: 4px;
    background: var(--surface-page);
  }
  .quote__result[data-state='success'] {
    border-left-color: var(--feedback-success);
  }
  .quote__result[data-state='error'] {
    border-left-color: var(--feedback-error);
  }

  @media (min-width: 720px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
    .quote__submit {
      width: auto;
    }
  }

  @media (min-width: 1040px) {
    .quote__grid {
      grid-template-columns: 4fr 8fr;
      gap: 64px;
    }
    .quote__aside {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }
</style>

<style is:global>
  /* Written by src/scripts/quote-form.ts into [data-quote-result]. Global
     because the script builds these nodes, so they carry no scope hash. */
  .quote-result__title {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-stack-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .quote-result__body {
    display: block;
    font-size: 1rem;
    color: var(--text-body);
  }
  .quote-result__reference {
    display: block;
    margin-top: 14px;
    font-family: var(--font-stack-mono);
    font-size: .875rem;
    letter-spacing: var(--tracking-mono);
    color: var(--text-link-light);
  }
  .quote-result__reference b {
    font-family: var(--font-stack-mono);
    font-weight: 400;
    font-size: 1.0625rem;
  }
</style>
