---
import { stats } from '~/data/stats';
import { getLangFromUrl, pick, useTranslations } from '~/i18n/ui';

/**
 * CLAUDE.md §6.4 — dark, numbers count up on first view. Only real numbers.
 *
 * "Only real numbers" is doing the work here. The two counts are derived from
 * src/data/categories.ts and src/data/industries.ts, so they cannot claim more
 * than the site actually lists. The reply-time figure is not confirmed (§10),
 * so it renders as a marked placeholder rather than as a commitment — see
 * src/data/stats.ts.
 *
 * The count-up is decoration. Every figure is in the HTML at its final value,
 * so it is correct with JavaScript off and correct under reduced motion.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/**
 * Resolved here rather than in the template. A `typeof x === 'number'` ternary
 * narrows the union cleanly in the frontmatter; the same expression inside the
 * markup would need a type assertion, and Astro's parser reads the `<` of a
 * generic argument as the start of a tag.
 */
const rendered = stats.map((stat) => ({
  id: stat.id,
  labelKey: stat.labelKey,
  confirmed: stat.confirmed,
  shown: typeof stat.value === 'number' ? String(stat.value) : pick(stat.value, lang),
  /** Present only for figures that count up (§6.4). */
  count: typeof stat.value === 'number' ? stat.value : undefined,
}));
---

<section class="stat-band dark-surface" aria-label={t('stats.label')}>
  <div class="wrap stat-band__grid">
    {
      rendered.map((stat) => (
        <div class="stat">
          {stat.confirmed ? (
            <b class="stat__value" data-count={stat.count}>
              {stat.shown}
            </b>
          ) : (
            <b class="stat__value stat__value--unconfirmed">
              <span class="pending">{t('stats.unconfirmed')}</span>
              <span class="stat__draft">{stat.shown}</span>
              <span class="sr-only">{t('stats.unconfirmedNote')}</span>
            </b>
          )}
          <small class="stat__label">{t(stat.labelKey)}</small>
        </div>
      ))
    }
  </div>
</section>

<script>
  import '~/scripts/stat-band';
</script>

<style>
  .stat-band {
    padding: 0;
  }

  .stat-band__grid {
    display: grid;
    grid-template-columns: 1fr;
    /* The 1px gap over a rule-coloured ground is the divider. */
    gap: 1px;
    background: var(--rule-dark);
  }

  .stat {
    background: var(--ink);
    padding: 32px 24px;
  }

  .stat__value {
    display: block;
    font-family: var(--font-stack-display);
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    font-weight: 500;
    letter-spacing: var(--meso-ls-h2);
    line-height: 1.1;
    color: var(--white);
    /* Digits must not reflow as the count-up runs. */
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    display: block;
    font-size: .85rem;
    color: var(--on-dark-4);
    margin-top: 6px;
  }

  /* §10 — an unconfirmed figure is shown at the size of a label, never at the
     size of a fact. The draft value sits under the marker, visibly subordinate
     to it, so nobody can screenshot it as a promise. */
  .stat__value--unconfirmed {
    font-size: 1rem;
    line-height: 1.3;
  }
  .stat__draft {
    display: block;
    margin-top: 8px;
    font-size: 1.5rem;
    color: var(--on-dark-4);
  }

  @media (min-width: 720px) {
    .stat-band__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .stat-band__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
