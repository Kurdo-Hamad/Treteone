---
import { Picture } from 'astro:assets';
import plate from '~/assets/sourcing/plate.jpg';
import { quoteHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations, type UIKey } from '~/i18n/ui';

/**
 * /sourcing — the "what to send" checklist beside the photo plate.
 *
 * The hard-to-find claim itself opens the page in PageHero, so this section is
 * the practical half: whatever fragment of information an engineer has in
 * front of them, the list says it is enough. The CTA sits beside the list.
 *
 * No script. The checklist is an ordered set of i18n keys: presentation order
 * for this section, nothing else reads it.
 *
 * ⚠ §12 — the plate is a stand-in photograph.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const checklist: readonly UIKey[] = [
  'sourcing.send.partNumber',
  'sourcing.send.nameplate',
  'sourcing.send.datasheet',
  'sourcing.send.boq',
  'sourcing.send.description',
];
---

<section class="checklist-section" aria-labelledby="checklist-title">
  <div class="wrap checklist-section__grid">
    <div class="checklist-section__copy rv">
      <h2 id="checklist-title">{t('sourcing.checklistLabel')}</h2>
      <p class="checklist-section__lede">{t('sourcing.checklistLede')}</p>

      <ul class="checklist" aria-labelledby="checklist-title">
        {checklist.map((key) => <li class="checklist__item">{t(key)}</li>)}
      </ul>

      <p class="checklist-section__cta">
        <a class="btn" href={localisePath(quoteHref, lang)}>{t('sourcing.cta')}</a>
      </p>
    </div>

    <div class="checklist-section__frame rv">
      <Picture
        src={plate}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[520, 900, 1400]}
        sizes="(min-width: 1040px) 45vw, 100vw"
        alt=""
        class="checklist-section__img"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .checklist-section {
    padding-block: var(--section-y);
  }

  .checklist-section__grid {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  .checklist-section__lede {
    margin-top: 16px;
    color: var(--text-body);
  }

  .checklist {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    border-bottom: 1px solid var(--rule-light);
  }
  .checklist__item {
    display: flex;
    gap: 16px;
    padding-block: 16px;
    border-top: 1px solid var(--rule-light);
    color: var(--text-primary);
  }
  /* A navy square stands in for the list marker `list-style: none` removed.
     Decoration, never content. */
  .checklist__item::before {
    content: '';
    flex: 0 0 8px;
    height: 8px;
    margin-top: .6em;
    background: var(--color-navy);
  }

  .checklist-section__cta {
    margin-top: 32px;
  }

  .checklist-section__frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-card-tinted);
  }
  .checklist-section__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1040px) {
    .checklist-section__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
