---
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import { standIn } from '~/data/standIns';
import { categories } from '~/data/categories';
import type { TextKey } from '~/data/heroSlides';
import { productsHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, useTranslations } from '~/i18n/ui';

/**
 * §7.6 Capability grid — eight of the twelve categories, each a small
 * photograph slot, a noun-plus-clause heading and three lines. Four columns,
 * two below 960px, one below 560px. A scope statement, not a catalogue: no
 * prices, no stock, no part counts (§13).
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const caps = [
  'automation',
  'instruments',
  'valves',
  'pumps',
  'motors',
  'fluid',
  'mro',
  'consumables',
] as const;

const key = (cap: (typeof caps)[number], part: 'subject' | 'heading' | 'body'): TextKey =>
  `home.caps.${cap}.${part}`;

/* Each item opens its own row on /products (IndexRows gives every row the
   category slug as its id), so the hover leads somewhere real. */
const categoryOf: Record<(typeof caps)[number], string> = {
  automation: 'automation-control',
  instruments: 'instrumentation-measurement',
  valves: 'valves-flow-control',
  pumps: 'pumps',
  motors: 'motors-drives-transmission',
  fluid: 'hydraulic-pneumatic',
  mro: 'mechanical-mro',
  consumables: 'industrial-consumables',
};
const productsPath = localisePath(productsHref, lang);

/* Headings are written "Automation & control — the logic layer" (and with
   "——" in Chinese). Set the name and the clause on their own lines instead of
   letting the dash fall wherever the line breaks. */
const splitHeading = (heading: string): string[] =>
  heading.split(/\s*(?:——|—)\s*/).filter((part) => part.length > 0);
---

<section aria-labelledby="caps-title">
  <div class="wrap sec">
    <h2 id="caps-title">{t('home.caps.heading')}</h2>
    <p class="lead caps__lead">{t('home.caps.lead')}</p>
    <ul class="caps">
      {
        caps.map((cap) => (
          <li class="cap rv">
            <a class="cap__link" href={`${productsPath}#${categoryOf[cap]}`} aria-labelledby={`cap-${cap}`}>
            <ImagePlaceholder
              subject={t(key(cap, 'subject'))}
              variant="small"
              image={standIn(key(cap, 'subject'))}
            />
            <h3 id={`cap-${cap}`}>
              {splitHeading(t(key(cap, 'heading'))).map((part, i) =>
                i === 0 ? (
                  <span class="cap__name">{part}</span>
                ) : (
                  <>
                    <span class="sr-only"> — </span>
                    <span class="cap__clause">{part}</span>
                  </>
                ),
              )}
            </h3>
            <p>{t(key(cap, 'body'))}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="caps__all">
      <a class="btn btn-out" href={localisePath(productsHref, lang)}>
        {t('home.caps.all')(categories.length)}
      </a>
    </p>
  </div>
</section>

<style>
  .caps__lead {
    margin-top: 12px;
  }

  .caps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(22px, 3vw, 40px);
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }
  .cap__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .cap :global(.ph) {
    margin-bottom: 16px;
  }
  .cap h3 {
    transition: color .2s;
  }
  .cap__link:is(:hover, :focus-visible) .cap__name {
    color: var(--fg-link);
  }
  .cap h3 {
    font-size: 1rem;
    line-height: 1.3;
  }
  .cap__name,
  .cap__clause {
    display: block;
  }
  .cap__clause {
    margin-top: 2px;
    font-weight: 400;
    color: var(--text-muted);
  }
  .cap p {
    margin-top: 8px;
    font-size: .8125rem;
    line-height: 1.6;
    color: var(--fg-body);
  }


  .caps__all {
    margin-top: 30px;
  }

  @media (max-width: 960px) {
    .caps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .caps {
      grid-template-columns: 1fr;
    }
  }
</style>
