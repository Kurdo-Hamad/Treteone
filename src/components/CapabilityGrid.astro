---
import ImagePlaceholder from '~/components/ImagePlaceholder.astro';
import { standIn } from '~/data/standIns';
import { categories } from '~/data/categories';
import type { TextKey } from '~/data/heroSlides';
import { productsHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, pick, useTranslations } from '~/i18n/ui';

/**
 * §7.6 Capability grid — eight of the twelve categories, each a small
 * photograph slot, the category name (read from src/data/categories.ts, so
 * it matches /products word for word) with a short clause, and three lines.
 * Four columns, two below 960px; on a phone a compact ruled list without
 * photographs, so the page is not eight photographs long. A scope statement,
 * not a catalogue: no prices, no stock, no part counts (§13).
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const caps = [
  'automation',
  'instruments',
  'valves',
  'pumps',
  'motors',
  'fluid',
  'mro',
  'consumables',
] as const;

const key = (cap: (typeof caps)[number], part: 'subject' | 'heading' | 'body'): TextKey =>
  `home.caps.${cap}.${part}`;

/* Each item opens its own row on /products (IndexRows gives every row the
   category slug as its id), so the hover leads somewhere real. */
const categoryOf: Record<(typeof caps)[number], string> = {
  automation: 'automation-control',
  instruments: 'instrumentation-measurement',
  valves: 'valves-flow-control',
  pumps: 'pumps',
  motors: 'motors-drives-transmission',
  fluid: 'hydraulic-pneumatic',
  mro: 'mechanical-mro',
  consumables: 'industrial-consumables',
};
const productsPath = localisePath(productsHref, lang);

/* The i18n headings are written "Automation & control — the logic layer"
   (and with "——" in Chinese). Only the clause after the dash is used here;
   the name comes from categories.ts, the one source for category names. */
const clauseOf = (heading: string): string =>
  heading.split(/\s*(?:——|—)\s*/).filter((part) => part.length > 0).slice(1).join(' ');
const nameOf = (cap: (typeof caps)[number]): string => {
  const category = categories.find((entry) => entry.slug === categoryOf[cap]);
  if (!category) throw new Error(`CapabilityGrid: no category ${categoryOf[cap]}`);
  return pick(category.name, lang);
};
---

<section aria-labelledby="caps-title">
  <div class="wrap sec">
    <h2 id="caps-title">{t('home.caps.heading')}</h2>
    <p class="lead caps__lead">{t('home.caps.lead')}</p>
    <ul class="caps">
      {
        caps.map((cap) => (
          <li class="cap rv">
            <a class="cap__link" href={`${productsPath}#${categoryOf[cap]}`} aria-labelledby={`cap-${cap}`}>
            <ImagePlaceholder
              subject={t(key(cap, 'subject'))}
              variant="small"
              image={standIn(key(cap, 'subject'))}
            />
            <h3 id={`cap-${cap}`}>
              <span class="cap__name">{nameOf(cap)}</span>
              <span class="sr-only"> — </span>
              <span class="cap__clause">{clauseOf(t(key(cap, 'heading')))}</span>
            </h3>
            <p>{t(key(cap, 'body'))}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="caps__all">
      <a class="btn btn-out" href={localisePath(productsHref, lang)}>
        {t('home.caps.all')(categories.length)}
      </a>
    </p>
  </div>
</section>

<style>
  .caps__lead {
    margin-top: 12px;
  }

  .caps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(22px, 3vw, 40px);
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }
  .cap__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .cap :global(.ph) {
    margin-bottom: 16px;
  }
  .cap h3 {
    font-size: var(--fs-lead);
    line-height: 1.3;
    transition: color .2s;
  }
  .cap__link:is(:hover, :focus-visible) .cap__name {
    color: var(--fg-link);
  }
  .cap__name,
  .cap__clause {
    display: block;
  }
  .cap__clause {
    margin-top: 3px;
    font-family: var(--font-stack-body);
    font-size: var(--fs-small);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--fg-muted);
  }
  .cap p {
    margin-top: 10px;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--fg-body);
  }

  .caps__all {
    margin-top: 34px;
  }

  @media (max-width: 60rem) {
    .caps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Phone: a ruled list, no photographs — eight full-width photos would be
     about 3,000px of scrolling before the next section. */
  @media (max-width: 35rem) {
    .caps {
      grid-template-columns: 1fr;
      gap: 0;
      border-top: 1px solid var(--line);
    }
    .cap__link {
      padding: 18px 0;
      border-bottom: 1px solid var(--line);
    }
    .cap :global(.ph) {
      display: none;
    }
    .cap p {
      margin-top: 6px;
    }
  }
</style>
