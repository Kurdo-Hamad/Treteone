---
import Footer from '~/components/Footer.astro';
import Header from '~/components/Header.astro';
import {
  alternateLinks,
  defaultLang,
  getLangFromUrl,
  languages,
  localisePath,
  useTranslations,
} from '~/i18n/ui';
import '~/styles/global.css';

/**
 * The document shell. Not listed in CLAUDE.md §3's tree — flagged in the README
 * as one of four additions for review — but every route needs the same head,
 * the same header and the same footer, and duplicating that per page is how the
 * two languages drift apart.
 */

interface Props {
  /** Overrides the site title. Defaults to the localised site title. */
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title = t('site.title'), description = t('site.description') } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = alternateLinks(Astro.url);
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* --color-navy. A meta value cannot read a custom property. */}
    <meta name="theme-color" content="#051b38" />

    {/* §2 — each language is a real route, so each is separately indexable. */}
    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={new URL(alternate.href, Astro.site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localisePath('/', defaultLang), Astro.site).href}
    />

    {/*
      §8 — every face is self-hosted. There is no Google Fonts stylesheet link
      anywhere on this site, because that host is unreachable from mainland
      China; `grep -r googleapis src public` must stay empty. Only the two
      faces used above the fold are preloaded.
    */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/GeneralSans-Medium.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/roboto/Roboto-latin.woff2"
      crossorigin
    />

    {/*
      Noto Sans SC, built by scripts/subset-noto-sans-sc.mjs to hold exactly the
      CJK glyphs this site's copy uses. It is linked on every route, including
      English, because the footer carries the Chinese address — and because at
      one ~105 KB file it no longer costs what 101 Google subsets did.
      Its unicode-range is CJK-only, so a page with no Chinese never fetches it.
    */}
    <link rel="stylesheet" href="/fonts/noto-sans-sc.css" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {/* No og:image — §10, the real photography has not been supplied. */}
    <meta name="twitter:card" content="summary" />

    <slot name="head" />
  </head>

  <!--
    Scroll reveal is page-level, not component-level, so it is loaded once here
    rather than imported by each section that uses .rv.
  -->
  <script>
    import '~/scripts/reveal';
  </script>

  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
