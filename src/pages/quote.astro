---
import PageHead from '~/components/PageHead.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';
import Base from '~/layouts/Base.astro';

/**
 * /quote — the form, on its own page (CLAUDE.md §3, §8; approved mockup
 * #v-quote). The shared page head sits in the navy band beside the form.
 */

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Base title={t('meta.quote.title')} description={t('meta.quote.description')}>
  <QuoteForm>
    <PageHead slot="head" kicker={t('quote.eyebrow')} title={t('quote.heading')} lead={t('quote.lede')} />
  </QuoteForm>
</Base>
