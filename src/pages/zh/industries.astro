---
import ClosingCta from '~/components/ClosingCta.astro';
import IndustryIndex from '~/components/IndustryIndex.astro';
import PageHero from '~/components/PageHero.astro';
import { industries } from '~/data/industries';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';
import Base from '~/layouts/Base.astro';

/** /industries — all 9 industries in full (CLAUDE.md §3). */

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Base title={t('meta.industries.title')} description={t('meta.industries.description')}>
  <PageHero
    eyebrow={t('industries.eyebrow')}
    title={t('industries.heading')}
    lede={t('industries.lede')}
    facts={[t('industries.count')(industries.length)]}
  />
  <IndustryIndex />
  <ClosingCta />
</Base>
