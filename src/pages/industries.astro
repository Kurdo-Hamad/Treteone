---
import IndexRows from '~/components/IndexRows.astro';
import PageHead from '~/components/PageHead.astro';
import { industries } from '~/data/industries';
import { quoteHref } from '~/data/navigation';
import { getLangFromUrl, localisePath, pick, useTranslations } from '~/i18n/ui';
import Base from '~/layouts/Base.astro';

/**
 * /industries — page head and the 9 sectors as index rows, each spec line
 * naming the duty data that decides the answer (CLAUDE.md §3; mockup
 * #v-industries).
 *
 * Rendered for both languages: src/pages/zh/industries.astro renders this
 * file, and every string resolves from the route's language.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const rows = industries.map((industry) => ({
  id: industry.slug,
  name: pick(industry.name, lang),
  spec: pick(industry.spec, lang),
}));
---

<Base title={t('meta.industries.title')} description={t('meta.industries.description')}>
  <div class="wrap sec">
    <PageHead
      kicker={t('industries.page.kicker')(industries.length)}
      title={t('industries.page.title')}
      lead={t('industries.page.lead')}
    >
      <IndexRows
        rows={rows}
        href={localisePath(quoteHref, lang)}
        action={t('industries.rows.enquire')}
        label={t('industries.listLabel')}
      />
    </PageHead>
  </div>
</Base>
