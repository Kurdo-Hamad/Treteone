---
import BrandDirectory from '~/components/BrandDirectory.astro';
import PageHead from '~/components/PageHead.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';
import Base from '~/layouts/Base.astro';

/**
 * /brands — page head, then one filterable brand directory with the trademark
 * disclaimer beneath it (CLAUDE.md §3, §9; approved mockup #v-brands).
 * §13 — the wording stays "Brands we source"; nothing implies authorisation.
 */

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Base title={t('meta.brands.title')} description={t('meta.brands.description')}>
  <section class="wrap sec">
    <PageHead kicker={t('brands.eyebrow')} title={t('brands.title')} lead={t('brands.lede')}>
      <BrandDirectory />
    </PageHead>
  </section>
</Base>
