---
import BrandDirectory from '~/components/BrandDirectory.astro';
import PageHead from '~/components/PageHead.astro';
import { pageImage } from '~/data/standIns';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';
import Base from '~/layouts/Base.astro';

/**
 * /brands — page head, then one filterable brand directory (CLAUDE.md §3, §9;
 * approved mockup #v-brands). The trademark note was removed at the client's
 * request, Nov 2026.
 * §13 — the wording stays "Brands we source"; nothing implies authorisation.
 */

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Base title={t('meta.brands.title')} description={t('meta.brands.description')}>
  <PageHead
    title={t('brands.title')}
    lead={t('brands.lede')}
    image={pageImage('brands')}
  >
    <BrandDirectory />
  </PageHead>
</Base>
